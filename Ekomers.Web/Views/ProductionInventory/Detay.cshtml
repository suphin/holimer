@model Ekomers.Models.ViewModels.Production.InventoryDocumentDetailVM
@{ ViewData["Title"]="Stok Belgesi Detayı"; }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@Model.DocumentNumber<span class="d-block text-muted pt-2 font-size-sm">@Model.Type.ToTurkish() · @Model.DocumentDate.ToString("dd.MM.yyyy")</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline mr-2">@Model.Status.ToTurkish()</span><a asp-action="Index" class="btn btn-sm btn-light">Belgelere Dön</a></div></div><div class="card-body"><div class="row"><div class="col-md-3 mb-3"><strong>Kaynak Depo</strong><div>@Model.SourceWarehouse</div></div><div class="col-md-3 mb-3"><strong>Hedef Depo</strong><div>@Model.TargetWarehouse</div></div><div class="col-md-2 mb-3"><strong>Para Birimi / Kur</strong><div>@Model.CurrencyCode / @Model.ExchangeRate.ToString("0.######")</div></div><div class="col-md-2 mb-3"><strong>Toplam Maliyet</strong><div>@Model.TotalCost.ToString("N2") ₺</div></div><div class="col-md-2 mb-3"><strong>İşlem Tarihi</strong><div>@Model.PostingDate?.ToString("dd.MM.yyyy HH:mm")</div></div><div class="col-12"><strong>Açıklama</strong><div>@Model.Notes</div></div></div></div>
@if(Model.Status==PrdInventoryDocumentStatus.Draft){<div class="card-footer d-flex"><form asp-action="StokaIsle" method="post" class="mr-2" onsubmit="return confirm('Belge stoka işlendiğinde kalemler değiştirilemez. Devam edilsin mi?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success">Stoka İşle</button></form><form asp-action="TaslagiIptalEt" method="post" onsubmit="return confirm('Taslak belge iptal edilsin mi?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-light-danger">Taslağı İptal Et</button></form></div>}
</div>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Belge Kalemleri (@Model.Lines.Count)</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>#</th><th>Malzeme</th><th>Lot</th><th>SKT</th><th>Miktar</th><th>Birim Maliyet</th><th>Toplam Maliyet</th><th>Not</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.Sequence</td><td><strong>@line.MaterialCode</strong><span class="d-block text-muted">@line.MaterialName</span></td><td>@line.LotNumber</td><td>@line.ExpirationDate?.ToString("dd.MM.yyyy")</td><td>@line.Quantity.ToString("0.######") @line.Unit</td><td>@line.UnitCost.ToString("N6") ₺</td><td><strong>@line.TotalCost.ToString("N2") ₺</strong></td><td>@line.Notes</td></tr>}</tbody></table></div></div></div>
