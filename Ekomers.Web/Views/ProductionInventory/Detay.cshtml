@model Ekomers.Models.ViewModels.Production.InventoryDocumentDetailVM
@{ ViewData["Title"]="Stok Belgesi Detayı"; var canDelete=User.IsInRole("Admin")||(User.HasClaim("Authorize","StokBelgesiSil")&&Model.CanDeleteFromInventory); }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@Model.DocumentNumber<span class="d-block text-muted pt-2 font-size-sm">@Model.Type.ToTurkish() · @Model.DocumentDate.ToString("dd.MM.yyyy")</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline mr-2">@Model.Status.ToTurkish()</span>@if(Model.Status==PrdInventoryDocumentStatus.Posted&&(Model.SourceDocumentType=="WarehouseCount"||Model.SourceDocumentType=="WarehouseCountCorrection")){<a asp-controller="ProductionStockCount" asp-action="Index" asp-route-sourceDocumentId="@Model.Id" class="btn btn-sm btn-light-warning mr-2">Sayımı Düzelt</a>}@if(canDelete){<button type="button" class="btn btn-sm btn-light-danger mr-2" data-toggle="modal" data-target="#deleteInventoryDocumentModal">Belgeyi Sil</button>}<a asp-action="Index" class="btn btn-sm btn-light">Belgelere Dön</a></div></div><div class="card-body"><div class="row"><div class="col-md-3 mb-3"><strong>Kaynak Depo</strong><div>@Model.SourceWarehouse</div></div><div class="col-md-3 mb-3"><strong>Hedef Depo</strong><div>@Model.TargetWarehouse</div></div><div class="col-md-2 mb-3"><strong>Para Birimi / Kur</strong><div>@Model.CurrencyCode / @Model.ExchangeRate.ToString("0.######")</div></div><div class="col-md-2 mb-3"><strong>Toplam Maliyet</strong><div>@Model.TotalCost.ToString("N2") ₺</div></div><div class="col-md-2 mb-3"><strong>İşlem Tarihi</strong><div>@Model.PostingDate?.ToString("dd.MM.yyyy HH:mm")</div></div><div class="col-12"><strong>Açıklama</strong><div>@Model.Notes</div></div></div></div>
@if(Model.Status==PrdInventoryDocumentStatus.Draft){<div class="card-footer d-flex"><form asp-action="StokaIsle" method="post" class="mr-2" onsubmit="return confirm('Belge stoka işlendiğinde kalemler değiştirilemez. Devam edilsin mi?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success">Stoka İşle</button></form><form asp-action="TaslagiIptalEt" method="post" onsubmit="return confirm('Taslak belge iptal edilsin mi?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-light-danger">Taslağı İptal Et</button></form></div>}
</div>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Belge Kalemleri (@Model.Lines.Count)</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>#</th><th>Malzeme</th><th>Hareket</th><th>Lot</th><th>SKT</th><th>Miktar</th><th>Birim Maliyet</th><th>Toplam Maliyet</th><th>Not</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.Sequence</td><td><strong>@line.MaterialCode</strong><span class="d-block text-muted">@line.MaterialName</span></td><td>@if(line.MovementType.HasValue){<span class="label @(line.MovementType==PrdStockMovementType.InventoryShortage ? "label-light-danger" : line.MovementType==PrdStockMovementType.InventorySurplus ? "label-light-primary" : "label-light") label-inline">@line.MovementType.Value.ToTurkish()</span>}else{<span class="text-muted">-</span>}</td><td>@line.LotNumber</td><td>@line.ExpirationDate?.ToString("dd.MM.yyyy")</td><td>@line.Quantity.ToString("0.######") @line.Unit</td><td>@line.UnitCost.ToString("N6") ₺</td><td><strong>@line.TotalCost.ToString("N2") ₺</strong></td><td>@line.Notes</td></tr>}</tbody></table></div></div></div>
@if(canDelete){
<div class="modal fade" id="deleteInventoryDocumentModal" tabindex="-1" role="dialog" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-centered" role="document"><div class="modal-content"><form asp-action="Sil" method="post">
        <div class="modal-header"><h5 class="modal-title">Stok Belgesini Sil</h5><button type="button" class="close" data-dismiss="modal" aria-label="Kapat"><span aria-hidden="true">&times;</span></button></div>
        <div class="modal-body">
            <input type="hidden" name="id" value="@Model.Id" />
            <div class="alert alert-light-danger"><strong>@Model.DocumentNumber</strong> belgesi, kalemleri ve bağlı stok hareketleri silinecek. Silme sonrası bir lot bakiyesi negatife düşerse işlem engellenir.</div>
            <div class="form-group"><label for="confirmationDocumentNumber">Onay için belge numarasını yazın</label><input id="confirmationDocumentNumber" name="confirmationDocumentNumber" class="form-control" required autocomplete="off" /></div>
            <div class="form-group"><label for="inventoryDeleteReason">Silme nedeni</label><textarea id="inventoryDeleteReason" name="reason" class="form-control" rows="3" minlength="5" maxlength="500" required></textarea></div>
            <label class="checkbox checkbox-danger"><input type="checkbox" name="confirmStockRollback" value="true" required /><span></span>Bağlı stok hareketlerinin bakiyeden çıkarılacağını onaylıyorum.</label>
        </div>
        <div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">Vazgeç</button><button type="submit" class="btn btn-danger">Belgeyi Sil</button></div>
    </form></div></div>
</div>}
