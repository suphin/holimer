@model Ekomers.Models.ViewModels.Production.InventoryDocumentCreateVM
@{ var transfer=Model.Type==PrdInventoryDocumentType.WarehouseTransfer;ViewData["Title"]=transfer?"Depolar Arası Transfer":"Devir Girişi"; }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@(transfer?"Depolar Arası Transfer":"Maliyetli Devir Girişi")<span class="d-block text-muted pt-2 font-size-sm">@(transfer?"Lot, SKT ve maliyet hedef depoya aynen taşınır.":"Başlangıç stoklarını lot ve birim maliyet bilgisiyle girin.")</span></h3></div><div class="card-toolbar"><a asp-action="Index" class="btn btn-sm btn-light">Belgelere Dön</a></div></div>
@if(transfer)
{
<div class="card-body border-bottom"><form asp-action="Yeni" method="get"><input type="hidden" name="type" value="@((int)Model.Type)"/><div class="row"><div class="col-md-5 form-group mb-0"><label>Kaynak Depo</label><select asp-for="SourceWarehouseId" asp-items="Model.Warehouses" class="form-control"><option value="">Kaynak depo seçiniz</option></select></div><div class="col-md-5 form-group mb-0"><label>Hedef Depo</label><select asp-for="TargetWarehouseId" asp-items="Model.Warehouses" class="form-control"><option value="">Hedef depo seçiniz</option></select></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary btn-block">Depo Stoklarını Getir</button></div></div></form></div>
}
</div>
@if(!transfer||Model.SourceWarehouseId.HasValue)
{
<form asp-action="Yeni" method="post"><input asp-for="Type" type="hidden"/><input asp-for="SourceWarehouseId" type="hidden"/><div class="card card-custom"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div><div class="row">
@if(!transfer){<div class="col-md-4 form-group"><label>Hedef Depo</label><select asp-for="TargetWarehouseId" asp-items="Model.Warehouses" class="form-control"><option value="">Depo seçiniz</option></select><span asp-validation-for="TargetWarehouseId" class="text-danger"></span></div>}else{<input asp-for="TargetWarehouseId" type="hidden"/><div class="col-md-4 form-group"><label>Kaynak → Hedef</label><div class="form-control bg-light">@Model.Warehouses.FirstOrDefault(x=>x.Value==Model.SourceWarehouseId?.ToString())?.Text → @Model.Warehouses.FirstOrDefault(x=>x.Value==Model.TargetWarehouseId?.ToString())?.Text</div></div>}
<div class="col-md-3 form-group"><label>Belge Tarihi</label><input asp-for="DocumentDate" type="date" class="form-control"/></div>
@if(!transfer){<div class="col-md-2 form-group"><label>Para Birimi</label><input asp-for="CurrencyCode" class="form-control" maxlength="3"/></div><div class="col-md-3 form-group"><label>Döviz Kuru</label><input asp-for="ExchangeRate" class="form-control" inputmode="decimal"/></div>}else{<input asp-for="CurrencyCode" type="hidden"/><input asp-for="ExchangeRate" type="hidden"/>}
<div class="col-12 form-group"><label>Belge Açıklaması</label><textarea asp-for="Notes" class="form-control" rows="2" maxlength="500"></textarea></div></div>
<div class="table-responsive"><table class="table table-separate table-head-custom"><thead>@if(transfer){<tr><th style="min-width:520px">Kaynak Lot / Kullanılabilir Stok / Maliyet</th><th style="min-width:150px">Transfer Miktarı</th><th style="min-width:220px">Not</th></tr>}else{<tr><th style="min-width:300px">Malzeme</th><th style="min-width:150px">Lot</th><th>Üretim Tarihi</th><th>SKT</th><th style="min-width:130px">Miktar</th><th style="min-width:150px">Birim Maliyet</th><th style="min-width:180px">Not</th></tr>}</thead><tbody>
@for(var i=0;i<Model.Lines.Count;i++)
{
if(transfer){<tr><td><select asp-for="Lines[i].SourceStockLotId" asp-items="Model.SourceLots" class="form-control"><option value="">Lot seçiniz</option></select></td><td><input asp-for="Lines[i].Quantity" class="form-control" inputmode="decimal"/></td><td><input asp-for="Lines[i].Notes" class="form-control" maxlength="250"/></td></tr>}
else{<tr><td><select asp-for="Lines[i].MaterialId" asp-items="Model.Materials" class="form-control"><option value="">Malzeme seçiniz</option></select></td><td><input asp-for="Lines[i].LotNumber" class="form-control" maxlength="100"/></td><td><input asp-for="Lines[i].ProductionDate" type="date" class="form-control"/></td><td><input asp-for="Lines[i].ExpirationDate" type="date" class="form-control"/></td><td><input asp-for="Lines[i].Quantity" class="form-control" inputmode="decimal"/></td><td><input asp-for="Lines[i].UnitCost" class="form-control" inputmode="decimal"/></td><td><input asp-for="Lines[i].Notes" class="form-control" maxlength="250"/></td></tr>}
}
</tbody></table></div></div><div class="card-footer text-right"><button type="submit" class="btn btn-primary">Taslak Belgeyi Kaydet</button></div></div></form>
}
