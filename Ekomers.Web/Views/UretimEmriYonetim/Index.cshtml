@model Ekomers.Models.ViewModels.Production.ProductionOrderCleanupIndexVM
@using Ekomers.Models.Enums
@{
    ViewData["Title"] = "Üretim Emri Yönetimi";
}

<div class="card card-custom mb-6">
    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">Üretim Emri Yönetimi
                <span class="d-block text-muted pt-2 font-size-sm">Yalnızca Admin · test ve hatalı üretim kayıtlarını bağlı verileriyle güvenli biçimde temizleme</span>
            </h3>
        </div>
        <div class="card-toolbar"><a asp-controller="UretimYonetimi" asp-action="Emirler" class="btn btn-light-primary">Üretim Emirleri</a></div>
    </div>
    <div class="card-body">
        <div class="alert alert-light-warning">
            <strong>Güvenli silme:</strong> İşlem kayıtları geçmiş bilgileriyle pasife alınır; ilgili stok hareketleri bakiyeden çıkarılır. Ana stok lotları ve üretim planı silinmez, plan satırı yeniden emir oluşturulabilir duruma getirilir.
        </div>
        <form method="get" class="row">
            <div class="col-lg-7 form-group">
                <label>Emir, plan, ürün veya parti ara</label>
                <input name="search" value="@Model.Search" class="form-control" placeholder="Örn. UE-..., 152MM..., ürün adı veya parti" />
            </div>
            <div class="col-lg-3 form-group">
                <label>Durum</label>
                <select name="status" class="form-control">
                    <option value="">Tümü</option>
                    @foreach (var status in Enum.GetValues<PrdProductionOrderStatus>())
                    {
                        if (Model.Status == status)
                        {
                            <option value="@((int)status)" selected>@status.ToTurkish()</option>
                        }
                        else
                        {
                            <option value="@((int)status)">@status.ToTurkish()</option>
                        }
                    }
                </select>
            </div>
            <div class="col-lg-2 form-group d-flex align-items-end"><button class="btn btn-primary btn-block">Filtrele</button></div>
        </form>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header"><div class="card-title"><h3 class="card-label">Aktif Üretim Emirleri (@Model.Orders.Count)</h3></div></div>
    <div class="card-body">
        @if (Model.Orders.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">Filtreye uygun aktif üretim emri bulunamadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-separate table-head-custom">
                    <thead><tr><th>Emir / Plan</th><th>Ürün</th><th>Miktar / Parti</th><th>Durum</th><th>Bağlı Kayıtlar</th><th>Stok Etkisi</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Orders)
                    {
                        <tr>
                            <td><strong>@item.OrderNumber</strong><span class="d-block text-muted">@item.PlanNumber · @item.PlannedProductionDate.ToString("dd.MM.yyyy")</span></td>
                            <td><strong>@item.ProductCode</strong><span class="d-block text-muted">@item.ProductName</span></td>
                            <td>@item.PlannedQuantity.ToString("0.######") @item.Unit<span class="d-block text-muted">Parti: @item.BatchNumber</span></td>
                            <td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td>
                            <td><span class="d-block">@item.RequirementCount ihtiyaç · @item.WarehouseTaskCount depo görevi</span><span class="text-muted">@item.ProductionResultCount üretim sonucu</span></td>
                            <td>
                                @if (item.StockMovementCount > 0)
                                { <span class="label label-light-warning label-inline">@item.StockMovementCount hareket</span> }
                                else
                                { <span class="label label-light-success label-inline">Hareket yok</span> }
                            </td>
                            <td class="text-right"><a asp-action="Detay" asp-route-id="@item.Id" class="btn btn-sm btn-light-danger">İncele ve Sil</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
