@using Ekomers.Models.Enums
@model Ekomers.Models.ViewModels.Production.MaterialReferenceCostEditVM
@{
    ViewData["Title"] = "Referans Maliyeti Düzenle";
}

<div class="card card-custom">
    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">
                Referans Maliyeti Düzenle
                <span class="d-block text-muted pt-2 font-size-sm">@Model.MaterialCode - @Model.MaterialName · v@(Model.VersionNumber)</span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a asp-action="Detay" asp-route-materialId="@Model.MaterialId" class="btn btn-light">Geçmişe Dön</a>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-light-warning">
            Bu işlem mevcut v@(Model.VersionNumber) kaydını düzeltir; yeni versiyon oluşturmaz ve stok miktarını değiştirmez. Değişiklik kullanıcı ve tarih bilgisiyle kaydedilir.
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
        <form asp-action="Duzenle" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="CostId" type="hidden" />
            <input asp-for="VersionNumber" type="hidden" />
            <input asp-for="MaterialId" type="hidden" />
            <div class="row">
                <div class="col-lg-4 mb-4">
                    <label class="font-weight-bold">Malzeme</label>
                    <div class="form-control bg-light">@Model.MaterialCode - @Model.MaterialName</div>
                    <span class="form-text text-muted">@Model.MaterialType · Ana birim: @Model.BaseUnit</span>
                </div>
                <div class="col-lg-2 mb-4">
                    <label asp-for="UnitCost" class="font-weight-bold">Birim Maliyet</label>
                    <input asp-for="UnitCost" class="form-control" inputmode="decimal" placeholder="0,000000" required />
                    <span asp-validation-for="UnitCost" class="text-danger"></span>
                </div>
                <div class="col-lg-2 mb-4">
                    <label asp-for="UnitId" class="font-weight-bold">Maliyet Birimi</label>
                    <select asp-for="UnitId" asp-items="Model.Units" class="form-control" required></select>
                </div>
                <div class="col-lg-2 mb-4">
                    <label asp-for="CurrencyCode" class="font-weight-bold">Para Birimi</label>
                    <select asp-for="CurrencyCode" class="form-control" id="currencyCode">
                        <option value="TRY">TRY</option>
                        <option value="USD">USD</option>
                        <option value="EUR">EUR</option>
                        <option value="GBP">GBP</option>
                    </select>
                </div>
                <div class="col-lg-2 mb-4">
                    <label asp-for="ExchangeRate" class="font-weight-bold">Kur</label>
                    <input asp-for="ExchangeRate" class="form-control" id="exchangeRate" inputmode="decimal" required />
                    <span asp-validation-for="ExchangeRate" class="text-danger"></span>
                </div>
                <div class="col-lg-3 mb-4">
                    <label asp-for="ValidFrom" class="font-weight-bold">Geçerlilik Başlangıcı</label>
                    <input asp-for="ValidFrom" type="date" class="form-control" required />
                    <span asp-validation-for="ValidFrom" class="text-danger"></span>
                </div>
                <div class="col-lg-3 mb-4">
                    <label asp-for="Source" class="font-weight-bold">Kaynak</label>
                    <select asp-for="Source" asp-items="Html.GetEnumSelectList<PrdMaterialReferenceCostSource>()" class="form-control"></select>
                </div>
                <div class="col-lg-6 mb-4">
                    <label asp-for="Notes" class="font-weight-bold">Açıklama / Belge Referansı</label>
                    <input asp-for="Notes" class="form-control" maxlength="1000" placeholder="Teklif no, tedarikçi, açıklama..." />
                </div>
            </div>
            <div class="text-right">
                <a asp-action="Detay" asp-route-materialId="@Model.MaterialId" class="btn btn-light mr-2">Vazgeç</a>
                <button type="submit" class="btn btn-primary">Değişiklikleri Kaydet</button>
            </div>
        </form>
    </div>
</div>

<script>
(function () {
    const currency = document.getElementById('currencyCode');
    const rate = document.getElementById('exchangeRate');
    if (!currency || !rate) return;
    function syncRate() {
        const isTry = currency.value === 'TRY';
        if (isTry) rate.value = '1';
        rate.readOnly = isTry;
    }
    currency.addEventListener('change', syncRate);
    syncRate();
})();
</script>
