@model BankaHesapVM

@{
    ViewData["Title"] = "Banka Hesapları";
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Banka Hesapları</h5>

        <a asp-action="Bankalar" class="btn btn-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Bankalara Dön
        </a>
    </div>

    <div class="card-body">

        <table class="table table-striped table-hover table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Kod</th>
                    <th>Hesap Adı</th>
                    <th>Hesap No</th>
                    <th>Para Birimi</th>
                    <th>Borç</th>
                    <th>Alacak</th>
                    <th>Bakiye</th>
                    <th>Durum</th>
                    <th>Ekstre</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Hesaplar.Any())
                {
                    @foreach (var item in Model.Hesaplar)
                    {
                        <tr>
                            <td>@item.CODE</td>

                            <td>@item.DEFINITION_</td>

                            <td>@item.ACCOUNTNO</td>

                            <td>@item.CURRENCY</td>

                            <td class="text-right">
                                @item.DEBIT.ToString("N2")
                            </td>

                            <td class="text-right">
                                @item.CREDIT.ToString("N2")
                            </td>

                            <td class="text-right fw-bold">
                                @item.BAKIYE.ToString("N2")
                            </td>

                            <td>
                                @if (item.ACTIVE == 0)
                                {
                                    <span class="badge bg-success">
                                        Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Pasif
                                    </span>
                                }
                            </td>
                            <td> 
                                <a onclick="HesaplarEkstre('@item.LOGICALREF')" data-toggle="modal" data-target="#ModalGoruntule" href="#">Ekstre</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">
                            Kayıt bulunamadı.
                        </td>
                    </tr>
                }

            </tbody>

            @if (Model.Hesaplar.Any())
            {
                <tfoot class="table-light">
                    <tr>
                        <th colspan="4" class="text-right">
                            Toplam
                        </th>

                        <th class="text-right">
                            @Model.Hesaplar.Sum(x => x.DEBIT).ToString("N2")
                        </th>

                        <th class="text-right">
                            @Model.Hesaplar.Sum(x => x.CREDIT).ToString("N2")
                        </th>

                        <th class="text-right">
                            @Model.Hesaplar.Sum(x => x.BAKIYE).ToString("N2")
                        </th>

                        <th></th>
                    </tr>
                </tfoot>
            }

        </table>

    </div>
</div>
 
    <div id="ModalGoruntule" class="modal fade" tabindex="-1" role="dialog" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-xl">
       
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Banka Hesap Ekstresi</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Kapat">
                            <i aria-hidden="true" class="ki ki-close"></i>
                        </button>
                    </div>
                <div class="modal-body" id="ModalGoruntuleContent">

                      

                         

</div>
<div class="modal-footer">
    
    <button type="button" class="btn btn-danger" data-dismiss="modal">Kapat</button> 
</div>
</div>
  
</div>
</div>

@section JSSection {
    <script>
        function HesaplarEkstre(cardRef) {
            $.ajax({
                url: '/Reports/HesaplarEkstre',
                type: 'GET',
                data: { cardRef: cardRef },
                success: function(result) {
                    $('#ModalGoruntuleContent').html(result);
                    $('#ModalGoruntule').modal('show');
                },
                error: function(xhr, status, error) {
                    console.error('Hata oluştu:', error);
                }
            });
        }
    </script>
}