@model List<BankaKrediVM>

@{
    ViewData["Title"] = "Banka Kredileri";
}

<div class="card shadow-sm">

    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">
                Finans / Banka Kredileri
                <span class="d-block text-muted pt-2 font-size-sm">Banka Kredileri</span>
            </h3>
        </div>
        <div class="card-toolbar">

            <a href="/Reports/KrediOdemePlani" class="btn btn-primary">Kredi Ödeme Planı</a>
        </div>
    </div>

    <div class="card-body">

        <table class="table table-bordered table-hover table-striped" id="tblKredi">

            <thead class="table-dark">
                <tr>
                    <th>Kredi Kodu</th>
                    <th>Kredi Adı</th>
                    <th>Başlangıç</th>
                    <th>Bitiş</th>

                    <th class="text-right">Anapara</th>
                    <th class="text-right">Ödenen</th>
                    <th class="text-right">Kalan</th>

                    <th class="text-right">Faiz</th>
                    <th class="text-right">Ödenen</th>
                    <th class="text-right">Kalan</th>

                    <th class="text-right">BSMV</th>
                    <th class="text-right">Ödenen</th>
                    <th class="text-right">Kalan</th>

                   
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>@item.CODE</td>
                        <td>@item.NAME_</td>
                        <td>@item.BEGDATE?.ToString("dd.MM.yyyy")</td>
                        <td>@item.ENDDATE?.ToString("dd.MM.yyyy")</td>

                        <td class="text-right">@item.TRTOTAL.ToString("N2")</td>
                        <td class="text-right">@item.ANAPARA_ODENEN.ToString("N2")</td>
                        <td class="text-right fw-bold">@item.KALAN_ANAPARA.ToString("N2")</td>

                        <td class="text-right">@item.INTTOTAL.ToString("N2")</td>
                        <td class="text-right">@item.FAIZ_ODENEN.ToString("N2")</td>
                        <td class="text-right fw-bold">@item.KALAN_FAIZ.ToString("N2")</td>

                        <td class="text-right">@item.BSMVTOTAL.ToString("N2")</td>
                        <td class="text-right">@item.BSMV_ODENEN.ToString("N2")</td>
                        <td class="text-right fw-bold">@item.KALAN_BSMV.ToString("N2")</td>
 

                    </tr>
                }

            </tbody>

            <tfoot class="table-light">
                <tr>

                    <th colspan="4" class="text-right">TOPLAM</th>

                    <th class="text-right">@Model.Sum(x => x.TRTOTAL).ToString("N2")</th>
                    <th class="text-right">@Model.Sum(x => x.ANAPARA_ODENEN).ToString("N2")</th>
                    <th class="text-right">@Model.Sum(x => x.KALAN_ANAPARA).ToString("N2")</th>

                    <th class="text-right">@Model.Sum(x => x.INTTOTAL).ToString("N2")</th>
                    <th class="text-right">@Model.Sum(x => x.FAIZ_ODENEN).ToString("N2")</th>
                    <th class="text-right">@Model.Sum(x => x.KALAN_FAIZ).ToString("N2")</th>

                    <th class="text-right">@Model.Sum(x => x.BSMVTOTAL).ToString("N2")</th>
                    <th class="text-right">@Model.Sum(x => x.BSMV_ODENEN).ToString("N2")</th>
                    <th class="text-right">@Model.Sum(x => x.KALAN_BSMV).ToString("N2")</th>

                    

                </tr>
            </tfoot>

        </table>

    </div>

</div>