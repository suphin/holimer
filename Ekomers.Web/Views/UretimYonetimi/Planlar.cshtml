@model IReadOnlyList<Ekomers.Models.ViewModels.Production.ProductionPlanListVM>
@{
    ViewData["Title"]="Üretim Planları";
    var selectablePlanCount=Model.Count(x=>x.Status!=Ekomers.Models.Enums.PrdProductionPlanHeaderStatus.Cancelled&&!x.PurchaseRequestId.HasValue);
}
@if(TempData["success"]!=null){<div class="alert alert-light-success">@TempData["success"]</div>}
@if(TempData["error"]!=null){<div class="alert alert-light-danger">@TempData["error"]</div>}
<div class="card card-custom">
    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">Üretim Planları<span class="d-block text-muted pt-2 font-size-sm">Taslak, kilitli ve emre dönüştürülen planlar</span></h3>
        </div>
        <div class="card-toolbar">
            @if(selectablePlanCount>0)
            {
                <button id="createPurchaseRequestButton" type="submit" form="productionPlanPurchaseRequestForm" class="btn btn-light-primary mr-2" disabled>
                    Seçilen Eksik Malzemeler İçin Talep Oluştur
                </button>
            }
            <a asp-action="Planlama" class="btn btn-primary">Yeni Üretim Planı</a>
        </div>
    </div>
    <div class="card-body">
        @if(Model.Count==0)
        {
            <div class="alert alert-light-primary mb-0">Henüz kaydedilmiş üretim planı yok.</div>
        }
        else
        {
            <form id="productionPlanPurchaseRequestForm" asp-action="EksikHammaddelerIcinSatinalmaTalebi" method="post"
                  onsubmit="return confirm('Seçilen planların eksik malzemeleri birleştirilerek taslak satınalma talebi oluşturulsun mu?');">
                @Html.AntiForgeryToken()
            <div class="table-responsive">
                <table class="table table-separate table-head-custom">
                    <thead><tr><th style="width:42px"><label class="checkbox checkbox-single"><input id="selectAllPlans" type="checkbox" /><span></span></label></th><th>Plan No</th><th>Plan Tarihi</th><th>Hedef Üretim</th><th>Ürün</th><th>İhtiyaç</th><th>Eksik Toplamı</th><th>Durum</th><th>Satınalma Talebi</th><th></th></tr></thead>
                    <tbody>
                    @foreach(var item in Model)
                    {
                        var canSelect=item.Status!=Ekomers.Models.Enums.PrdProductionPlanHeaderStatus.Cancelled&&!item.PurchaseRequestId.HasValue;
                        var selectionTitle=item.PurchaseRequestId.HasValue
                            ? $"{item.PurchaseRequestNumber??"Satınalma talebi"} daha önce oluşturuldu"
                            : canSelect?"Satınalma talebine dahil et":"İptal edilen plan seçilemez";
                        <tr>
                            <td>
                                <label class="checkbox checkbox-single" title="@selectionTitle">
                                    <input class="js-plan-select" type="checkbox" name="planIds" value="@item.Id" disabled="@(!canSelect)" />
                                    <span></span>
                                </label>
                            </td>
                            <td><strong>@item.PlanNumber</strong><span class="d-block text-muted">@item.Notes</span></td>
                            <td>@item.PlanDate.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@item.TargetProductionDate.ToString("dd.MM.yyyy")</td>
                            <td>@item.ProductCount</td>
                            <td>@item.RequirementCount</td>
                            <td class="@(item.TotalShortageQuantity>0?"text-danger":"text-success")">@item.TotalShortageQuantity.ToString("0.######")</td>
                            <td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td>
                            <td class="text-nowrap">
                                @if(item.PurchaseRequestId.HasValue)
                                {
                                    <a asp-controller="SatinalmaYonetimi" asp-action="TalepDetay" asp-route-id="@item.PurchaseRequestId" class="label label-light-success label-inline" title="Satınalma talebini aç">
                                        <i class="flaticon2-check-mark text-success mr-1"></i>@(item.PurchaseRequestNumber??"Talep oluşturuldu")
                                    </a>
                                    @if(item.PurchaseRequestCreatedDate.HasValue)
                                    {
                                        <span class="d-block text-muted font-size-sm mt-1">@item.PurchaseRequestCreatedDate.Value.ToString("dd.MM.yyyy HH:mm")</span>
                                    }
                                }
                                else
                                {
                                    <span class="label label-light label-inline">Oluşturulmadı</span>
                                }
                            </td>
                            <td class="text-nowrap">
                                <a asp-action="PlanDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a>
                                @if(User.IsInRole("Admin"))
                                {
                                    <button type="button" class="btn btn-sm btn-light-danger ml-1 js-plan-delete"
                                            data-toggle="modal" data-target="#planDeleteModal"
                                            data-plan-id="@item.Id" data-plan-number="@item.PlanNumber">Sil</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center mt-4">
                <span id="selectedPlanSummary" class="text-muted">Satınalma talebi için plan seçilmedi.</span>
                <span class="text-muted font-size-sm">Hammadde, ambalaj ve diğer girdiler aktarılır; başka üretim planlarının açık talepleri yeni planın eksiğinden düşülmez.</span>
            </div>
            </form>
        }
    </div>
</div>

@if(selectablePlanCount>0)
{
    <script>
        (function () {
            var selectAll=document.getElementById('selectAllPlans');
            var button=document.getElementById('createPurchaseRequestButton');
            var summary=document.getElementById('selectedPlanSummary');
            var checkboxes=Array.prototype.slice.call(document.querySelectorAll('.js-plan-select:not(:disabled)'));
            function refreshSelection() {
                var selected=checkboxes.filter(function (x) { return x.checked; }).length;
                button.disabled=selected===0;
                summary.textContent=selected===0?'Satınalma talebi için plan seçilmedi.':selected+' üretim planı seçildi.';
                selectAll.checked=selected>0&&selected===checkboxes.length;
                selectAll.indeterminate=selected>0&&selected<checkboxes.length;
            }
            selectAll.addEventListener('change',function () {
                checkboxes.forEach(function (x) { x.checked=selectAll.checked; });
                refreshSelection();
            });
            checkboxes.forEach(function (x) { x.addEventListener('change',refreshSelection); });
            refreshSelection();
        })();
    </script>
}

@if(User.IsInRole("Admin"))
{
    <div id="planDeleteModal" class="modal fade" tabindex="-1" role="dialog" aria-labelledby="planDeleteModalTitle" aria-hidden="true" data-backdrop="static" data-keyboard="false">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <div class="modal-content">
                <form asp-action="PlanSil" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deletePlanId" name="id" />
                    <div class="modal-header">
                        <h5 class="modal-title" id="planDeleteModalTitle">Üretim Planını Sil</h5>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Kapat"><span aria-hidden="true">&times;</span></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-light-danger">
                            <strong id="deletePlanLabel"></strong> planı; plan satırları, ihtiyaçları, üretim emirleri ve bağlı depo/stok kayıtlarıyla birlikte silinecek. Bu işlem stok bakiyelerini etkileyebilir.
                        </div>
                        <div class="form-group">
                            <label for="confirmationPlanNumber">Onay için plan numarasını yazın</label>
                            <input id="confirmationPlanNumber" name="confirmationPlanNumber" class="form-control" autocomplete="off" required />
                        </div>
                        <div class="form-group">
                            <label for="deletePlanReason">Silme nedeni</label>
                            <textarea id="deletePlanReason" name="reason" class="form-control" rows="3" minlength="5" maxlength="500" required></textarea>
                            <span class="form-text text-muted">En az 5 karakter giriniz. İşlem kullanıcı hareketlerine kaydedilir.</span>
                        </div>
                        <label class="checkbox checkbox-danger">
                            <input type="checkbox" name="confirmCascadeDelete" value="true" required />
                            <span></span> Tüm bağlı kayıtların silineceğini onaylıyorum.
                        </label>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light-primary" data-dismiss="modal">Vazgeç</button>
                        <button type="submit" class="btn btn-danger">Planı ve Bağlı Kayıtları Sil</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script>
        document.querySelectorAll('.js-plan-delete').forEach(function (button) {
            button.addEventListener('click', function () {
                document.getElementById('deletePlanId').value = button.dataset.planId;
                document.getElementById('deletePlanLabel').textContent = button.dataset.planNumber;
                document.getElementById('confirmationPlanNumber').value = '';
                document.getElementById('deletePlanReason').value = '';
                var confirmation = document.querySelector('#planDeleteModal input[name="confirmCascadeDelete"]');
                if (confirmation) confirmation.checked = false;
            });
        });
    </script>
}
