@model IReadOnlyList<Ekomers.Models.ViewModels.Production.ProductionStockBalanceVM>
@{ ViewData["Title"]="Üretim Stokları"; }
<div class="card card-custom"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Üretim Stokları<span class="d-block text-muted pt-2 font-size-sm">Yeni üretim yapısındaki depo, lot ve SKT bazlı güncel bakiyeler</span></h3></div><div class="card-toolbar">@if(User.IsInRole("Admin")){<button type="button" class="btn btn-light" disabled title="Maliyet altyapısı tamamlandıktan sonra açılacak">Mevcut Stokları Aktar</button>}</div></div><div class="card-body">
@if(Model.Count==0){<div class="alert alert-light-primary mb-0">Yeni üretim stoklarında henüz bakiye bulunmuyor. Maliyetli başlangıç aktarımı altyapı tamamlandıktan sonra etkinleştirilecek.</div>}
else{<div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Depo</th><th>Malzeme</th><th>Lot</th><th>Son Kullanma</th><th>Bakiye</th><th>Birim Maliyet</th><th>Stok Değeri</th></tr></thead><tbody>@foreach(var item in Model){var expired=item.ExpirationDate.HasValue&&item.ExpirationDate.Value.Date<DateTime.Today;<tr><td><strong>@item.WarehouseCode</strong><span class="d-block text-muted">@item.WarehouseName</span></td><td><strong>@item.MaterialCode</strong><span class="d-block text-muted">@item.MaterialName</span></td><td>@item.LotNumber</td><td class="@(expired?"text-danger":"")">@item.ExpirationDate?.ToString("dd.MM.yyyy") @if(expired){<span class="label label-light-danger label-inline ml-2">Süresi Geçmiş</span>}</td><td class="@(item.Quantity<0?"text-danger":"")"><strong>@item.Quantity.ToString("0.######")</strong> @item.Unit</td><td>@item.UnitCost.ToString("N6") ₺</td><td><strong>@item.TotalCost.ToString("N2") ₺</strong></td></tr>}</tbody></table></div>}
</div></div>
