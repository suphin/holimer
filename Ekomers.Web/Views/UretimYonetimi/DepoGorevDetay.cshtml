@model Ekomers.Models.ViewModels.Production.ProductionWarehouseTaskDetailVM
@{ ViewData["Title"]="Depo Hazırlama Görevi"; var toplanabilir=Model.Items.Any(x=>x.RequestedQuantity>x.PreparedQuantity); var sevkEdilebilir=Model.Items.Any(x=>x.PreparedQuantity>x.ShippedQuantity); }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@Model.TaskNumber<span class="d-block text-muted pt-2 font-size-sm">@Model.OrderNumber · @Model.ProductCode - @Model.ProductName</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline mr-2">@Model.Status.ToTurkish()</span><a asp-action="EmirDetay" asp-route-id="@Model.ProductionOrderId" class="btn btn-sm btn-light mr-2">Üretim Emri</a><a asp-action="DepoHazirlama" class="btn btn-sm btn-light">Görevlere Dön</a></div></div><div class="card-body"><div class="row"><div class="col-md-3 mb-4"><strong>Kaynak Depo</strong><div>@Model.SourceWarehouse</div></div><div class="col-md-3 mb-4"><strong>Hedef Depo</strong><div>@Model.TargetWarehouse</div></div><div class="col-md-2 mb-4"><strong>Talep Tarihi</strong><div>@Model.RequestDate.ToString("dd.MM.yyyy HH:mm")</div></div><div class="col-md-2 mb-4"><strong>Atanan</strong><div>@(Model.AssignedUserId??"-")</div></div><div class="col-md-2 mb-4"><strong>Hazırlama Tarihi</strong><div>@(Model.PreparedDate?.ToString("dd.MM.yyyy HH:mm")??"-")</div></div><div class="col-md-2 mb-4"><strong>Sevk Tarihi</strong><div>@(Model.ShippedDate?.ToString("dd.MM.yyyy HH:mm")??"-")</div></div><div class="col-md-2 mb-4"><strong>Teslim Tarihi</strong><div>@(Model.DeliveredDate?.ToString("dd.MM.yyyy HH:mm")??"-")</div></div></div></div><div class="card-footer d-flex flex-wrap">
@if((Model.Status==PrdWarehouseTaskStatus.Waiting||Model.Status==PrdWarehouseTaskStatus.Shortage)&&toplanabilir){<form asp-action="DepoGoreviHazirlamayaBasla" method="post" class="mr-2"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-primary">Hazırlamaya Başla</button></form>}
@if(Model.Status==PrdWarehouseTaskStatus.Preparing){<form asp-action="DepoGoreviHazirlandi" method="post" class="mr-2" onsubmit="return confirm('Ayrılan lotların tamamı hazırlandı mı?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success">Ayrılanlar Hazırlandı</button></form>}
@if((Model.Status==PrdWarehouseTaskStatus.Ready||Model.Status==PrdWarehouseTaskStatus.Shortage)&&sevkEdilebilir){<form asp-action="DepoGoreviSevkEt" method="post" class="mr-2" onsubmit="return confirm('Hazırlanan malzemeler ana depodan çıkarılıp üretim deposuna sevk edilsin mi?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-info">Hazırlananları Sevk Et</button></form>}
@if(Model.Status==PrdWarehouseTaskStatus.Shipped){<form asp-action="DepoGoreviTeslimAl" method="post" class="mr-2" onsubmit="return confirm('Sevk edilen malzemeler üretim deposunda teslim alındı mı?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success">Üretim Deposunda Teslim Al</button></form>}
@if(Model.Items.Any(x=>x.ShortageQuantity>0)){<form asp-action="DepoGoreviOlustur" method="post"><input type="hidden" name="id" value="@Model.ProductionOrderId"/><button class="btn btn-warning">Yeni Stoktan Eksikleri Ayır</button></form>}
</div></div>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Toplanacak Malzemeler (@Model.Items.Count)<span class="d-block text-muted pt-2 font-size-sm">Ayrılan lotlar FEFO; SKT olmayanlarda FIFO sırasıyla seçilir. Eksikler görev üzerinde açık kalır.</span></h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Malzeme</th><th>Toplanacak</th><th>Hazırlanan</th><th>Sevk Edilen</th><th>Eksik</th><th style="min-width:360px">Ayrılan Lotlar</th></tr></thead><tbody>@foreach(var item in Model.Items){<tr><td><strong>@item.MaterialCode</strong><span class="d-block text-muted">@item.MaterialName</span></td><td>@item.RequestedQuantity.ToString("0.######") @item.Unit</td><td>@item.PreparedQuantity.ToString("0.######") @item.Unit</td><td>@item.ShippedQuantity.ToString("0.######") @item.Unit</td><td class="@(item.ShortageQuantity>0?"text-danger":"text-success")"><strong>@item.ShortageQuantity.ToString("0.######")</strong> @item.Unit</td><td>@if(item.Lots.Count==0){<span class="text-muted">Henüz lot ayrılamadı.</span>}else{@foreach(var lot in item.Lots){<div class="mb-1"><code>@lot.LotNumber</code> · <strong>@lot.Quantity.ToString("0.######") @lot.Unit</strong> · SKT: @(lot.ExpirationDate?.ToString("dd.MM.yyyy")??"-")</div>}}</td></tr>}</tbody></table></div></div></div>
