@model IReadOnlyList<Ekomers.Models.ViewModels.Production.WarehouseListVM>
@{ ViewData["Title"]="Depolar"; }
<div class="card card-custom">
    <div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Depolar<span class="d-block text-muted pt-2 font-size-sm">Ana depo, üretim deposu ve diğer üretim stok noktaları</span></h3></div><div class="card-toolbar">@if(User.IsInRole("Admin")){<a asp-action="DepoYeni" class="btn btn-primary">Yeni Depo</a>}</div></div>
    <div class="card-body">
        @if(Model.Count==0){<div class="alert alert-light-primary mb-0">Henüz depo tanımlanmamış. @if(User.IsInRole("Admin")){<a asp-action="DepoYeni" class="alert-link">İlk depoyu ekleyin.</a>}</div>}
        else
        {
            <div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Depo Kodu</th><th>Depo Adı</th><th>Tür</th><th>Açıklama</th><th>Lot</th><th>Hareket</th><th>Durum</th><th></th></tr></thead><tbody>
            @foreach(var item in Model)
            {
                <tr><td><strong>@item.Code</strong></td><td>@item.Name</td><td>@item.Type.ToTurkish()</td><td>@item.Description</td><td>@item.LotCount</td><td>@item.MovementCount</td><td>@if(item.IsActive){<span class="label label-light-success label-inline">Aktif</span>}else{<span class="label label-light-danger label-inline">Pasif</span>}</td><td>@if(User.IsInRole("Admin")){<a asp-action="DepoDuzenle" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Düzenle</a>}</td></tr>
            }
            </tbody></table></div>
        }
    </div>
</div>
