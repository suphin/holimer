@model Ekomers.Models.ViewModels.Production.ProductionPlanDetailVM
@{ ViewData["Title"]="Üretim Planı Detayı"; var canCancel=Model.Status!=PrdProductionPlanHeaderStatus.Cancelled&&Model.Status!=PrdProductionPlanHeaderStatus.ConvertedToOrders; }
<div class="card card-custom mb-5">
    <div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@Model.PlanNumber<span class="d-block text-muted pt-2 font-size-sm">Plan: @Model.PlanDate.ToString("dd.MM.yyyy HH:mm") · Hedef: @Model.TargetProductionDate.ToString("dd.MM.yyyy")</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline mr-2">@Model.Status.ToTurkish()</span><a asp-action="Planlar" class="btn btn-sm btn-light">Planlara Dön</a></div></div>
    <div class="card-body"><div class="row"><div class="col-md-4"><strong>Kilit Tarihi</strong><div>@Model.LockedDate?.ToString("dd.MM.yyyy HH:mm")</div></div><div class="col-md-4"><strong>Kilitleyen</strong><div>@Model.LockedUserId</div></div><div class="col-md-4"><strong>Not</strong><div>@Model.Notes</div></div></div></div>
    <div class="card-footer d-flex flex-wrap">
        @if(Model.Status==PrdProductionPlanHeaderStatus.Draft){<form asp-action="TaslagiDuzenle" method="post" class="mr-2"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-primary">Taslağı Düzenle</button></form>}
        @if(User.IsInRole("Admin")&&Model.Status==PrdProductionPlanHeaderStatus.Locked){<form asp-action="PlaniTasligaAl" method="post" class="mr-2" onsubmit="return confirm('Kilitli plan tekrar taslağa alınsın mı?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-warning">Tekrar Taslağa Al</button></form>}
        @if(Model.Status==PrdProductionPlanHeaderStatus.Locked){<a asp-action="EmirOlustur" asp-route-planHeaderId="@Model.Id" class="btn btn-success mr-2">Üretim Emirlerini Oluştur</a>}
        @if(User.IsInRole("Admin")&&canCancel){<form asp-action="PlaniIptalEt" method="post" onsubmit="return confirm('Üretim planı iptal edilsin mi?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-light-danger">Planı İptal Et</button></form>}
    </div>
</div>
<div class="card card-custom mb-5"><div class="card-header"><div class="card-title"><h3 class="card-label">Planlanan Ürünler (@Model.Lines.Count)</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Satır No</th><th>Ürün</th><th>Reçete</th><th>Miktar</th><th>Emir Durumu</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td>@line.LineNumber</td><td><strong>@line.ProductCode</strong><span class="d-block text-muted">@line.ProductName</span></td><td>v@(line.VersionNumber)</td><td>@line.Quantity.ToString("0.######") @line.Unit</td><td>@(line.IsConvertedToOrder?"Emre Dönüştürüldü":"Bekliyor")</td></tr>}</tbody></table></div></div></div>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Kilitlenmiş MRP Sonuçları (@Model.Requirements.Count)</h3></div></div><div class="card-body">
@foreach(var group in Model.Requirements.GroupBy(x=>x.Type)){<h4 class="mt-5">@group.Key.ToTurkish()</h4><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Malzeme</th><th>Teorik</th><th>Fire</th><th>Toplam</th><th>Fiziksel</th><th>Rezervasyon</th><th>Kullanılabilir</th><th>Eksik</th></tr></thead><tbody>@foreach(var item in group){<tr><td><strong>@item.Code</strong><span class="d-block text-muted">@item.Name</span></td><td>@item.TheoreticalQuantity.ToString("0.######") @item.Unit</td><td>@item.PlannedWasteQuantity.ToString("0.######") @item.Unit</td><td>@item.RequiredQuantity.ToString("0.######") @item.Unit</td><td>@item.PhysicalStockQuantity.ToString("0.######") @item.Unit</td><td>@item.ReservedQuantity.ToString("0.######") @item.Unit</td><td>@item.AvailableStockQuantity.ToString("0.######") @item.Unit</td><td class="@(item.ShortageQuantity>0?"text-danger":"text-success")"><strong>@item.ShortageQuantity.ToString("0.######")</strong> @item.Unit</td></tr>}</tbody></table></div>}
</div></div>
