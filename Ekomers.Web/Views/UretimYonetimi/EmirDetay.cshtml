@model Ekomers.Models.ViewModels.Production.ProductionOrderDetailVM
@{ ViewData["Title"]="Üretim Emri Detayı"; }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@Model.OrderNumber<span class="d-block text-muted pt-2 font-size-sm">@Model.ProductCode - @Model.ProductName</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline mr-2">@Model.Status.ToTurkish()</span><a asp-action="Emirler" class="btn btn-sm btn-light">Emirlere Dön</a></div></div><div class="card-body"><div class="row">
<div class="col-md-3 mb-4"><strong>Kaynak Plan</strong><div>@Model.PlanNumber</div></div><div class="col-md-3 mb-4"><strong>Reçete</strong><div>v@(Model.RecipeVersionNumber)</div></div><div class="col-md-3 mb-4"><strong>Planlanan Miktar</strong><div>@Model.PlannedQuantity.ToString("0.######") @Model.Unit</div></div><div class="col-md-3 mb-4"><strong>Parti Numarası</strong><div>@Model.BatchNumber</div></div><div class="col-md-3 mb-4"><strong>Üretim Tarihi</strong><div>@Model.PlannedProductionDate.ToString("dd.MM.yyyy")</div></div><div class="col-md-3 mb-4"><strong>Kaynak Depo</strong><div>@Model.SourceWarehouse</div></div><div class="col-md-3 mb-4"><strong>Üretim Deposu</strong><div>@Model.ProductionWarehouse</div></div><div class="col-md-3 mb-4"><strong>Not</strong><div>@Model.Notes</div></div>
</div></div></div>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Emir Malzeme İhtiyaçları (@Model.Requirements.Count)</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Tür</th><th>Malzeme</th><th>Planlanan İhtiyaç</th><th>Rezerve</th><th>Sevk Edilen</th><th>Tüketilen</th><th>İade</th><th>Fire</th></tr></thead><tbody>@foreach(var item in Model.Requirements){<tr><td>@item.MaterialType.ToTurkish()</td><td><strong>@item.MaterialCode</strong><span class="d-block text-muted">@item.MaterialName</span></td><td>@item.RequiredQuantity.ToString("0.######") @item.Unit</td><td>@item.ReservedQuantity.ToString("0.######")</td><td>@item.IssuedQuantity.ToString("0.######")</td><td>@item.ConsumedQuantity.ToString("0.######")</td><td>@item.ReturnedQuantity.ToString("0.######")</td><td>@item.WasteQuantity.ToString("0.######")</td></tr>}</tbody></table></div></div></div>
