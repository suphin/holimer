@model IReadOnlyList<Ekomers.Models.ViewModels.Production.ProductionExecutionListVM>
@{ ViewData["Title"]="Gerçekleşen Üretim"; }
<div class="card card-custom"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Gerçekleşen Üretim<span class="d-block text-muted pt-2 font-size-sm">Üretime hazır, üretimde ve tamamlanmış emirler</span></h3></div><div class="card-toolbar"><a asp-action="Emirler" class="btn btn-light-primary">Üretim Emirleri</a></div></div><div class="card-body">
@if(Model.Count==0){<div class="alert alert-light-primary mb-0">Gerçekleşme aşamasına gelmiş üretim emri bulunmuyor.</div>}
else{<div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Emir</th><th>Ürün</th><th>Parti</th><th>Planlanan</th><th>Gerçekleşen</th><th>Başlangıç</th><th>Tamamlanma</th><th>Durum</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.OrderNumber</strong></td><td><strong>@item.ProductCode</strong><span class="d-block text-muted">@item.ProductName</span></td><td>@item.BatchNumber</td><td>@item.PlannedQuantity.ToString("0.######") @item.Unit</td><td>@item.ActualQuantity.ToString("0.######") @item.Unit</td><td>@(item.StartDate?.ToString("dd.MM.yyyy HH:mm")??"-")</td><td>@(item.CompletionDate?.ToString("dd.MM.yyyy HH:mm")??"-")</td><td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td><td class="text-right">@if(item.Status==PrdProductionOrderStatus.Ready){<form asp-action="UretimiBaslat" method="post" class="d-inline" onsubmit="return confirm('Ayrılan malzemeler üretime çıkarılsın ve üretim başlatılsın mı?');"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm btn-primary">Üretimi Başlat</button></form>}else{<a asp-action="GerceklesenDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">@(item.Status==PrdProductionOrderStatus.Completed?"Sonucu Gör":"Gerçekleşen Gir")</a>}</td></tr>}</tbody></table></div>}
</div></div>
