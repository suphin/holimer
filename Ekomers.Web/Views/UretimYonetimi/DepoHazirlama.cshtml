@model IReadOnlyList<Ekomers.Models.ViewModels.Production.ProductionWarehouseTaskListVM>
@{ ViewData["Title"]="Depo Hazırlama Emirleri"; }
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Depo Hazırlama Emirleri<span class="d-block text-muted pt-2 font-size-sm">Üretim için ayrılan malzemeler ve açık eksikler</span></h3></div></div><div class="card-body">
@if(Model.Count==0){<div class="alert alert-light-primary">Henüz depo hazırlama görevi oluşturulmadı.</div>}
else{<div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Görev No</th><th>Üretim Emri</th><th>Ürün</th><th>Kaynak → Hedef</th><th>Talep Tarihi</th><th>Kalem</th><th>Atanan</th><th>Durum</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.TaskNumber</strong></td><td><a asp-action="EmirDetay" asp-route-id="@item.ProductionOrderId">@item.OrderNumber</a></td><td><strong>@item.ProductCode</strong><span class="d-block text-muted">@item.ProductName</span></td><td>@item.SourceWarehouse<span class="d-block text-muted">→ @item.TargetWarehouse</span></td><td>@item.RequestDate.ToString("dd.MM.yyyy HH:mm")</td><td>@item.ItemCount</td><td>@(item.AssignedUserId??"-")</td><td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span>@if(item.ShortageQuantity>0){<span class="d-block text-danger mt-2">Eksik kalem var</span>}</td><td><a asp-action="DepoGorevDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Görevi Aç</a></td></tr>}</tbody></table></div>}
</div></div>
