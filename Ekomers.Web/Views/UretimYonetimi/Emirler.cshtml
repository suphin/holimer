@model IReadOnlyList<Ekomers.Models.ViewModels.Production.ProductionOrderListVM>
@{ ViewData["Title"]="Üretim Emirleri"; }
<div class="card card-custom"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Üretim Emirleri<span class="d-block text-muted pt-2 font-size-sm">Kilitli planlardan oluşturulan ayrı üretim işleri</span></h3></div><div class="card-toolbar"><a asp-action="Planlar" class="btn btn-light-primary">Üretim Planları</a></div></div><div class="card-body">
@if(Model.Count==0){<div class="alert alert-light-primary mb-0">Henüz üretim emri oluşturulmadı.</div>}
else{<div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Emir No</th><th>Plan No</th><th>Ürün</th><th>Miktar</th><th>Parti</th><th>Üretim Tarihi</th><th>İhtiyaç</th><th>Durum</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.OrderNumber</strong></td><td>@item.PlanNumber</td><td><strong>@item.ProductCode</strong><span class="d-block text-muted">@item.ProductName</span></td><td>@item.PlannedQuantity.ToString("0.######") @item.Unit</td><td>@item.BatchNumber</td><td>@item.PlannedProductionDate.ToString("dd.MM.yyyy")</td><td>@item.RequirementCount</td><td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td><td><a asp-action="EmirDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a></td></tr>}</tbody></table></div>}
</div></div>
