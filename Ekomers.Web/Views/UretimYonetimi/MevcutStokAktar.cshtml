@model Ekomers.Models.ViewModels.Production.LegacyStockImportVM
@{ ViewData["Title"]="Mevcut Stokları Aktar"; }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Mevcut Stokları Aktar<span class="d-block text-muted pt-2 font-size-sm">Eski portal deposundaki güncel bakiyeleri yeni üretim deposuyla eşleştirin</span></h3></div><div class="card-toolbar"><a asp-action="Stoklar" class="btn btn-sm btn-light">Stoklara Dön</a></div></div><div class="card-body">
@if(ViewBag.ImportEnabled!=true){<div class="alert alert-danger">Maliyetli stok altyapısı tamamlanana kadar aktarım kapalıdır. Bu ekrandan herhangi bir stok kaydı oluşturulamaz.</div>}
<div class="alert alert-light-warning">Bu işlem eski kayıtları değiştirmez. Yalnızca pozitif güncel bakiyeleri, lot ve SKT bilgileriyle yeni üretim stoklarına başlangıç hareketi olarak kopyalar.</div>
<form asp-action="MevcutStokAktar" method="get"><div class="row"><div class="col-md-5 form-group"><label>Mevcut Portal Deposu</label><select asp-for="LegacyWarehouseId" asp-items="Model.LegacyWarehouses" class="form-control"><option value="">Depo seçiniz</option></select></div><div class="col-md-5 form-group"><label>Yeni Üretim Deposu</label><select asp-for="TargetWarehouseId" asp-items="Model.TargetWarehouses" class="form-control"><option value="">Depo seçiniz</option></select></div><div class="col-md-2 form-group d-flex align-items-end"><button class="btn btn-primary btn-block">Stokları Önizle</button></div></div></form>
</div></div>
@if(Model.LegacyWarehouseId.HasValue&&Model.TargetWarehouseId.HasValue)
{
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Aktarım Önizlemesi<span class="d-block text-muted pt-2 font-size-sm">@Model.MatchedCount eşleşen · @Model.UnmatchedCount eşleşmeyen · @Model.Lines.Count toplam bakiye</span></h3></div></div><div class="card-body">
<div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
@if(Model.AlreadyImported){<div class="alert alert-danger">Bu depo eşleştirmesi daha önce aktarılmış. Yinelenen başlangıç bakiyesi oluşturulmasına izin verilmiyor.</div>}
@if(Model.UnmatchedCount>0){<div class="alert alert-warning">Eşleşmeyen @Model.UnmatchedCount kalem aktarılmayacak. Bu malzemelerin eski ve yeni katalog kodlarını kontrol edin.</div>}
<div class="table-responsive" style="max-height:520px;overflow:auto"><table class="table table-separate table-head-custom"><thead><tr><th>Durum</th><th>Malzeme</th><th>Lot</th><th>SKT</th><th>Bakiye</th></tr></thead><tbody>@foreach(var item in Model.Lines){<tr><td>@if(item.PrdMaterialId.HasValue){<span class="label label-light-success label-inline">Eşleşti</span>}else{<span class="label label-light-danger label-inline">Eşleşmedi</span>}</td><td><strong>@item.MaterialCode</strong><span class="d-block text-muted">@item.MaterialName</span></td><td>@(string.IsNullOrWhiteSpace(item.LotNumber)?"Devir lotu oluşturulacak":item.LotNumber)</td><td>@item.ExpirationDate?.ToString("dd.MM.yyyy")</td><td>@item.Quantity.ToString("0.######") @item.Unit</td></tr>}</tbody></table></div>
</div><div class="card-footer"><form asp-action="MevcutStokAktar" method="post" onsubmit="return confirm('Eşleşen stoklar yeni üretim deposuna başlangıç bakiyesi olarak aktarılsın mı?');"><input type="hidden" name="legacyWarehouseId" value="@Model.LegacyWarehouseId"/><input type="hidden" name="targetWarehouseId" value="@Model.TargetWarehouseId"/><label class="checkbox mb-4"><input type="checkbox" name="confirmImport" value="true"/><span></span>Önizlemeyi kontrol ettim; eşleşen stokların aktarılmasını onaylıyorum.</label>@if(Model.AlreadyImported||Model.MatchedCount==0){<button type="button" class="btn btn-success" disabled>Eşleşen Stokları Aktar</button>}else{<button type="submit" class="btn btn-success">Eşleşen Stokları Aktar</button>}</form></div></div>
}
