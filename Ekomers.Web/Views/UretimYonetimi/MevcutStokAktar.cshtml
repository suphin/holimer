@model Ekomers.Models.ViewModels.Production.LegacyStockImportVM
@{ ViewData["Title"]="Mevcut Stokları Aktar"; }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Mevcut Stokları Aktar<span class="d-block text-muted pt-2 font-size-sm">Eski portal deposundaki bakiyeleri maliyetleriyle yeni üretim deposuna alın</span></h3></div><div class="card-toolbar"><a asp-action="Stoklar" class="btn btn-sm btn-light">Stoklara Dön</a></div></div><div class="card-body">
@if(ViewBag.ImportEnabled!=true){<div class="alert alert-danger">Mevcut stok aktarımı şu anda kapalıdır.</div>}
<div class="alert alert-light-warning"><strong>Maliyet kuralı:</strong> Malzemenin maliyet girilmiş ilk devir kaydındaki birim maliyet, mevcut bakiyenin tamamına uygulanır. Maliyetli devir bulunamazsa eski malzeme kartı maliyeti kullanılır; hiçbir maliyeti bulunamayan satırlar aktarılmaz. Eski kayıtlar değiştirilmez.</div>
<form asp-action="MevcutStokAktar" method="get"><div class="row"><div class="col-md-5 form-group"><label>Mevcut Portal Deposu</label><select asp-for="LegacyWarehouseId" asp-items="Model.LegacyWarehouses" class="form-control"><option value="">Depo seçiniz</option></select></div><div class="col-md-5 form-group"><label>Yeni Üretim Deposu</label><select asp-for="TargetWarehouseId" asp-items="Model.TargetWarehouses" class="form-control"><option value="">Depo seçiniz</option></select></div><div class="col-md-2 form-group d-flex align-items-end"><button class="btn btn-primary btn-block">Stokları Önizle</button></div></div></form>
</div></div>
@if(Model.LegacyWarehouseId.HasValue&&Model.TargetWarehouseId.HasValue)
{
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Aktarım Önizlemesi<span class="d-block text-muted pt-2 font-size-sm">@Model.ImportableCount aktarılabilir · @Model.UnmatchedCount eşleşmeyen · @Model.MissingCostCount maliyetsiz · @Model.Lines.Count toplam bakiye</span></h3></div><div class="card-toolbar"><span class="font-weight-bold text-success">Aktarılacak değer: @Model.ImportableTotalCost.ToString("N2") ₺</span></div></div><div class="card-body">
<div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
@if(Model.AlreadyImported){<div class="alert alert-danger">Bu depo eşleştirmesi daha önce aktarılmış. Yinelenen başlangıç bakiyesi oluşturulmasına izin verilmiyor.</div>}
@if(Model.UnmatchedCount>0){<div class="alert alert-warning">Eşleşmeyen @Model.UnmatchedCount kalem aktarılmayacak. Eski ve yeni katalog kodlarını kontrol edin.</div>}
@if(Model.MissingCostCount>0){<div class="alert alert-warning">Eşleşen @Model.MissingCostCount kalemin devir veya malzeme kartı maliyeti bulunamadı; bu satırlar aktarılmayacak.</div>}
<div class="table-responsive" style="max-height:560px;overflow:auto"><table class="table table-separate table-head-custom"><thead><tr><th>Durum</th><th>Malzeme</th><th>Lot</th><th>SKT</th><th>Bakiye</th><th>Birim Maliyet</th><th>Toplam Maliyet</th><th>Maliyet Kaynağı</th></tr></thead><tbody>@foreach(var item in Model.Lines){var importable=item.PrdMaterialId.HasValue&&item.UnitCost.HasValue;<tr><td>@if(importable){<span class="label label-light-success label-inline">Aktarılabilir</span>}else if(!item.PrdMaterialId.HasValue){<span class="label label-light-danger label-inline">Eşleşmedi</span>}else{<span class="label label-light-warning label-inline">Maliyet Yok</span>}</td><td><strong>@item.MaterialCode</strong><span class="d-block text-muted">@item.MaterialName</span></td><td>@(string.IsNullOrWhiteSpace(item.LotNumber)?"Devir lotu oluşturulacak":item.LotNumber)</td><td>@item.ExpirationDate?.ToString("dd.MM.yyyy")</td><td>@item.Quantity.ToString("0.######") @item.Unit</td><td>@(item.UnitCost?.ToString("N6")??"-")</td><td>@(item.TotalCost?.ToString("N2")??"-")</td><td>@item.CostSource</td></tr>}</tbody></table></div>
</div><div class="card-footer"><form asp-action="MevcutStokAktar" method="post" onsubmit="return confirm('Önizlemedeki aktarılabilir stoklar maliyetleriyle yeni üretim deposuna alınsın mı?');"><input type="hidden" name="legacyWarehouseId" value="@Model.LegacyWarehouseId"/><input type="hidden" name="targetWarehouseId" value="@Model.TargetWarehouseId"/><label class="checkbox mb-4"><input type="checkbox" name="confirmImport" value="true"/><span></span>Önizlemeyi ve maliyet kaynaklarını kontrol ettim; aktarımı onaylıyorum.</label>@if(ViewBag.ImportEnabled!=true||Model.AlreadyImported||Model.ImportableCount==0){<button type="button" class="btn btn-success" disabled>Stokları Maliyetleriyle Aktar</button>}else{<button type="submit" class="btn btn-success">Stokları Maliyetleriyle Aktar</button>}</form></div></div>
}
