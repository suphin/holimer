@model Kullanici 
@{
    ViewData["Title"] = "Portal Ana Sayfa";
    var fileName = "";
    var shortcuts = ViewBag.Shortcuts as List<UserShortCut> ?? new List<UserShortCut>();
    // SignUpVM userdata = (SignUpVM)ViewBag.UserData;
}
<style>
    
    .counter {
        font-size: 12px;
        font-weight: bold;
    }
</style>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="card card-custom shadow-sm mt-5 mb-5">
        <div class="card-header border-0 pt-4">
            <div class="card-title align-items-start flex-column">
                <h3 class="card-label font-weight-bolder text-dark">Kısayollarım</h3>
                <span class="text-muted font-weight-bold font-size-sm mt-1">Sık kullandığınız sayfalara hızlı erişin</span>
            </div>
        </div>
        <div class="card-body pt-2">
            @if (shortcuts.Count == 0)
            {
                <div class="d-flex align-items-center rounded bg-light-primary p-5">
                    <span class="font-size-h3 text-primary mr-4" aria-hidden="true">☆</span>
                    <div>
                        <div class="font-weight-bold text-dark">Henüz kısayol eklemediniz.</div>
                        <div class="text-muted">Bir sayfayı açıp sağ üstteki “Kısayola ekle” düğmesini kullanabilirsiniz.</div>
                    </div>
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var shortcut in shortcuts)
                    {
                        <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                            <div class="border rounded p-4 h-100 d-flex align-items-center justify-content-between bg-white">
                                <a href="@shortcut.PageUrl" class="d-flex align-items-center text-dark text-hover-primary font-weight-bolder mr-3">
                                    <span class="symbol symbol-40 symbol-light-primary mr-3">
                                        <span class="symbol-label font-size-h4">↗</span>
                                    </span>
                                    <span>@shortcut.PageTitle</span>
                                </a>
                                <form asp-controller="UserActions" asp-action="ShortcutRemove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@shortcut.ID" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                    <button type="submit" class="btn btn-sm btn-icon btn-light-danger" title="Kısayolu kaldır" aria-label="Kısayolu kaldır">×</button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}
 
    @if (User.Identity.IsAuthenticated)
   {
          fileName = @User?.Identity.Name + ".jpg";
  
            <div class="card o-hidden border-0 shadow-lg my-5">
                <div class="card-body p-0">
                    <div class="row">
                <div class="col-lg-4 col-md-6">
                            <div class="p-4">



                        <img src="~/img/user/@fileName" width="100%" alt="Kullanıcı"
                             onerror="this.onerror=null; this.src='/img/user/default.jpg';" />
                            
                            </div>
                            </div>
                <div class="col-lg-8 col-md-6">
                            <div class="p-4">
                                <div class="text-left">
                                   
                                       
                                     
                                        <h4 class="text-gray-900 mb-4">Hoşgeldiniz</h4>
                                        <h4 class="text-gray-900 mb-4">Ad Soyad: @Model.AdSoyad</h4>
                                        <h4 class="text-gray-900 mb-4">Departman: @Model.Departman </h4>
                                        <h4 class="text-gray-900 mb-4">Ünvan: @Model.Unvan</h4>
                                        <h4 class="text-gray-900 mb-4">Son Giriş Tarihi: @Model.SonGirisTarihi.ToString("dd.MM.yyyy HH:mm:ss")


                                            <span class="counter">(Geçen Süre: <span id="timeElapsed"></span>)</span>

                                        </h4>
                                            @*  <span class="mr-2 d-none d-lg-inline text-gray-600 small">@ViewBag.UserData.AdSoyad</span> *@
 
                                     
                                </div>
 
                        </div>
                    </div>
                </div>
            </div>
        </div>
 
}
 

 
 


@section JSSection 
{
<script>
    // Son giriş tarihini ayarla 
        const lastLoginDate = new Date('@Model.SonGirisTarihi.ToString("yyyy-MM-ddTHH:mm:ss")');
    function updateTimeElapsed() {
        const now = new Date();
        const timeDiff = now - lastLoginDate;

        const days = Math.floor(timeDiff / (1000 * 60 * 60 * 24));
        const hours = Math.floor((timeDiff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
        const minutes = Math.floor((timeDiff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((timeDiff % (1000 * 60)) / 1000);

        document.getElementById('timeElapsed').textContent =
            `${hours} saat, ${minutes} dakika, ${seconds} saniye`;
    }

    // Sayaç her saniye güncellensin
    setInterval(updateTimeElapsed, 1000);

    // Sayfa yüklendiğinde sayaç başlasın
    updateTimeElapsed();
</script>
}
