@model SignInVM
@{
	Layout = null;
	var successMessage = TempData["Success"] as string;
	var errorMessage = TempData["Error"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content="Holimer kurumsal portal şifre yenileme sayfası" />
	<title>Şifremi Unuttum | Holimer Kurumsal Portal</title>
	@if (!string.IsNullOrWhiteSpace(successMessage))
	{
		<meta http-equiv="refresh" content="4;url=@Url.Action("SignIn", "Home")" />
	}
	<link rel="shortcut icon" href="~/img/favicon.ico" />
	<link href="~/assets1/plugins/global/plugins.bundle.css?v=7.0.5" rel="stylesheet" type="text/css" />
	<link href="~/assets1/css/style.bundle.css?v=7.0.5" rel="stylesheet" type="text/css" />
	<link href="~/css/signin-modern.css?v=1.0.0" rel="stylesheet" type="text/css" />
	<link href="~/css/forgot-password-modern.css?v=1.0.0" rel="stylesheet" type="text/css" />
</head>
<body class="holimer-auth-body">
	<main class="holimer-auth-page">
		<section class="holimer-auth-shell" aria-label="Holimer Portal Şifre Yenileme">
			<div class="holimer-auth-form-panel">
				<div class="holimer-auth-form-wrap">
					<a asp-controller="Home" asp-action="SignIn" class="holimer-auth-logo" aria-label="Holimer giriş sayfasına dön">
						<img src="~/img/holimer-logo-blue-hd.png" alt="Holimer optimum health" />
					</a>

					<div class="holimer-auth-heading">
						<span class="holimer-auth-kicker">HESAP GÜVENLİĞİ</span>
						<h1>Şifrenizi yenileyin</h1>
						<p>Hesabınıza kayıtlı e-posta adresini girin. Geçici şifrenizi e-posta ile gönderelim.</p>
					</div>

					@if (!string.IsNullOrWhiteSpace(successMessage))
					{
						<div class="holimer-forgot-notice holimer-forgot-notice--success" role="status">
							<span class="holimer-forgot-notice-icon" aria-hidden="true">✓</span>
							<div>
								<strong>@successMessage</strong>
								<small>Giriş sayfasına yönlendiriliyorsunuz…</small>
							</div>
						</div>
					}
					@if (!string.IsNullOrWhiteSpace(errorMessage))
					{
						<div class="holimer-auth-alert" role="alert">@errorMessage</div>
					}

					<form asp-action="ForgotPassword" method="post" class="holimer-auth-form" novalidate>
						<div asp-validation-summary="ModelOnly" class="holimer-auth-alert" role="alert"></div>

						<div class="holimer-auth-field">
							<label asp-for="Email">E-posta adresi</label>
							<div class="holimer-auth-input-wrap">
								<span class="holimer-auth-input-icon" aria-hidden="true">
									<svg viewBox="0 0 24 24" fill="none"><path d="M4 6.5h16v11H4v-11Z" stroke="currentColor" stroke-width="1.7"/><path d="m5 8 7 5 7-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
								</span>
								<input asp-for="Email" type="email" autocomplete="email" inputmode="email" placeholder="ornek@holimer.com" autofocus required />
							</div>
							<span asp-validation-for="Email" class="holimer-auth-validation"></span>
						</div>

						<button type="submit" class="holimer-auth-submit">
							<span>Geçici Şifre Gönder</span>
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 6.5h16v11H4v-11Z" stroke="currentColor" stroke-width="1.7"/><path d="m5 8 7 5 7-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>
					</form>

					<div class="holimer-auth-register">
						<span>Şifrenizi hatırladınız mı?</span>
						<a asp-controller="Home" asp-action="SignIn">Giriş sayfasına dönün</a>
					</div>

					<div class="holimer-auth-security">
						<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3 5 6v5c0 4.6 3 8.2 7 10 4-1.8 7-5.4 7-10V6l-7-3Z" stroke="currentColor" stroke-width="1.6"/><path d="m9.2 12 1.8 1.8 3.9-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
						<span>Geçici şifrenizi kimseyle paylaşmayın</span>
					</div>
				</div>
			</div>

			<aside class="holimer-auth-showcase">
				<div class="holimer-auth-orb holimer-auth-orb-one"></div>
				<div class="holimer-auth-orb holimer-auth-orb-two"></div>
				<div class="holimer-auth-showcase-content">
					<span class="holimer-auth-showcase-badge">HOLİMER İLAÇ A.Ş.</span>
					<h2>Güvenli erişim,<br />hızlı dönüş.</h2>
					<p>Hesap erişiminizi birkaç adımda geri kazanın ve iş süreçlerinize kaldığınız yerden devam edin.</p>

					<div class="holimer-auth-feature-list">
						<div class="holimer-auth-feature"><span>✓</span><div><strong>E-posta doğrulaması</strong><small>Geçici şifre yalnızca kayıtlı adresinize gönderilir</small></div></div>
						<div class="holimer-auth-feature"><span>✓</span><div><strong>Güvenli yenileme</strong><small>Mevcut şifreniz yeni geçici şifreyle değiştirilir</small></div></div>
						<div class="holimer-auth-feature"><span>✓</span><div><strong>Kolay geri dönüş</strong><small>Yeni şifrenizle hemen giriş yapabilirsiniz</small></div></div>
					</div>
				</div>
				<div class="holimer-auth-showcase-footer">Optimum health, güçlü operasyon.</div>
			</aside>
		</section>
		<footer class="holimer-auth-footer">© @DateTime.Now.Year Holimer İlaç A.Ş. · Kurumsal Portal</footer>
	</main>

	<script src="~/assets1/plugins/global/plugins.bundle.js?v=7.0.5"></script>
	<partial name="_ValidationScriptsPartial" />
</body>
</html>
