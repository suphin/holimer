@model RegisterVM
@{
	Layout = null;
	var successMessage = TempData["Message"] as string;
	var errorMessage = TempData["MessageError"] as string;
}
<!DOCTYPE html>
<html lang="tr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<meta name="description" content="Holimer kurumsal portal yeni üyelik sayfası" />
	<title>Yeni Üyelik | Holimer Kurumsal Portal</title>
	@if (!string.IsNullOrWhiteSpace(successMessage))
	{
		<meta http-equiv="refresh" content="4;url=@Url.Action("SignIn", "Home")" />
	}
	<link rel="shortcut icon" href="~/img/favicon.ico" />
	<link href="~/assets1/plugins/global/plugins.bundle.css?v=7.0.5" rel="stylesheet" type="text/css" />
	<link href="~/assets1/css/style.bundle.css?v=7.0.5" rel="stylesheet" type="text/css" />
	<link href="~/css/signin-modern.css?v=1.0.0" rel="stylesheet" type="text/css" />
	<link href="~/css/signup-modern.css?v=1.0.0" rel="stylesheet" type="text/css" />
</head>
<body class="holimer-auth-body holimer-signup-body">
	<main class="holimer-auth-page">
		<section class="holimer-auth-shell holimer-signup-shell" aria-label="Holimer Portal Yeni Üyelik">
			<div class="holimer-auth-form-panel holimer-signup-form-panel">
				<div class="holimer-auth-form-wrap holimer-signup-form-wrap">
					<a asp-controller="Home" asp-action="SignIn" class="holimer-auth-logo holimer-signup-logo" aria-label="Holimer giriş sayfasına dön">
						<img src="~/img/holimer-logo-blue-hd.png" alt="Holimer optimum health" />
					</a>

					<div class="holimer-auth-heading holimer-signup-heading">
						<span class="holimer-auth-kicker">KURUMSAL PORTAL</span>
						<h1>Yeni hesap oluşturun</h1>
						<p>Kurumsal bilgilerinizi girerek portal üyelik başvurunuzu tamamlayın.</p>
					</div>

					@if (!string.IsNullOrWhiteSpace(successMessage))
					{
						<div class="holimer-signup-notice" role="status">
							<span class="holimer-signup-notice-icon" aria-hidden="true">✓</span>
							<div>
								<strong>@successMessage</strong>
								<small>Giriş sayfasına yönlendiriliyorsunuz…</small>
							</div>
						</div>
					}
					@if (!string.IsNullOrWhiteSpace(errorMessage))
					{
						<div class="holimer-auth-alert" role="alert">@errorMessage</div>
					}

					<form asp-action="SignUp" method="post" class="holimer-auth-form holimer-signup-form">
						<div asp-validation-summary="ModelOnly" class="holimer-auth-alert" role="alert"></div>

						<div class="holimer-signup-section-title">
							<span>1</span>
							<div><strong>Kurum bilgileri</strong><small>Çalıştığınız şirket ve departman</small></div>
						</div>
						<div class="holimer-signup-grid">
							<div class="holimer-auth-field">
								<label asp-for="SirketID"></label>
								<div class="holimer-auth-input-wrap holimer-signup-select-wrap">
									<select asp-for="SirketID" asp-items="@(new SelectList(ViewBag.SirketListe, "ID", "SirketAdi"))" required>
										<option value="0">Şirket seçiniz</option>
									</select>
								</div>
								<span asp-validation-for="SirketID" class="holimer-auth-validation"></span>
							</div>

							<div class="holimer-auth-field">
								<label asp-for="DepartmanID"></label>
								<div class="holimer-auth-input-wrap holimer-signup-select-wrap">
									<select asp-for="DepartmanID" asp-items="@(new SelectList(ViewBag.IlgiliMudurlukListe, "ID", "Ad"))" required>
										<option value="0">Departman seçiniz</option>
									</select>
								</div>
								<span asp-validation-for="DepartmanID" class="holimer-auth-validation"></span>
							</div>
						</div>

						<div class="holimer-signup-section-title">
							<span>2</span>
							<div><strong>Kişisel bilgiler</strong><small>Hesabınız ve iletişim bilgileriniz</small></div>
						</div>
						<div class="holimer-signup-grid">
							<div class="holimer-auth-field">
								<label asp-for="AdSoyad"></label>
								<div class="holimer-auth-input-wrap">
									<span class="holimer-auth-input-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.7"/><path d="M5 20c.5-4 3-6 7-6s6.5 2 7 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
									</span>
									<input asp-for="AdSoyad" autocomplete="name" placeholder="Adınız ve soyadınız" required />
								</div>
								<span asp-validation-for="AdSoyad" class="holimer-auth-validation"></span>
							</div>

							<div class="holimer-auth-field">
								<label asp-for="UserName"></label>
								<div class="holimer-auth-input-wrap">
									<span class="holimer-auth-input-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none"><circle cx="9" cy="9" r="3" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 19c.5-3.2 2.4-5 5.5-5 1.5 0 2.8.4 3.7 1.2M17 8v8m-4-4h8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
									</span>
									<input asp-for="UserName" autocomplete="username" placeholder="adiniz.soyadiniz" required />
								</div>
								<span asp-validation-for="UserName" class="holimer-auth-validation"></span>
							</div>

							<div class="holimer-auth-field">
								<label asp-for="PhoneNumber"></label>
								<div class="holimer-auth-input-wrap">
									<span class="holimer-auth-input-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none"><path d="M7 3h3l1.2 4-2 1.5a16 16 0 0 0 6.3 6.3l1.5-2 4 1.2v3c0 2.2-1.8 4-4 4C9.3 21 3 14.7 3 7c0-2.2 1.8-4 4-4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
									</span>
									<input asp-for="PhoneNumber" id="phoneNumber" type="tel" autocomplete="tel" inputmode="tel" placeholder="05__ ___ __ __" required />
								</div>
								<span asp-validation-for="PhoneNumber" class="holimer-auth-validation"></span>
							</div>

							<div class="holimer-auth-field">
								<label asp-for="Email">E-posta adresi</label>
								<div class="holimer-auth-input-wrap">
									<span class="holimer-auth-input-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none"><path d="M4 6.5h16v11H4v-11Z" stroke="currentColor" stroke-width="1.7"/><path d="m5 8 7 5 7-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
									</span>
									<input asp-for="Email" type="email" autocomplete="email" inputmode="email" placeholder="ornek@holimer.com" required />
								</div>
								<span asp-validation-for="Email" class="holimer-auth-validation"></span>
							</div>
						</div>

						<div class="holimer-signup-section-title">
							<span>3</span>
							<div><strong>Güvenlik</strong><small>Güçlü bir parola belirleyin</small></div>
						</div>
						<div class="holimer-signup-grid">
							<div class="holimer-auth-field">
								<label asp-for="Password"></label>
								<div class="holimer-auth-input-wrap">
									<span class="holimer-auth-input-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
									</span>
									<input asp-for="Password" type="password" autocomplete="new-password" placeholder="En az 8 karakter" required />
									<button type="button" class="holimer-password-toggle" data-password-toggle="Password" aria-label="Şifreyi göster" aria-pressed="false">
										<svg class="eye-open" viewBox="0 0 24 24" fill="none"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"/></svg>
										<svg class="eye-closed" viewBox="0 0 24 24" fill="none"><path d="m4 4 16 16M10.7 6.1A9 9 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-2.1 2.7M6.2 7.2C3.8 9 2.5 12 2.5 12s3.5 6 9.5 6c1 0 2-.2 2.8-.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
									</button>
								</div>
								<span asp-validation-for="Password" class="holimer-auth-validation"></span>
							</div>

							<div class="holimer-auth-field">
								<label asp-for="ConfirmPassword">Şifre tekrarı</label>
								<div class="holimer-auth-input-wrap">
									<span class="holimer-auth-input-icon" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="10" rx="2" stroke="currentColor" stroke-width="1.7"/><path d="M8 10V7a4 4 0 0 1 8 0v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
									</span>
									<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Şifrenizi yeniden girin" required />
									<button type="button" class="holimer-password-toggle" data-password-toggle="ConfirmPassword" aria-label="Şifre tekrarını göster" aria-pressed="false">
										<svg class="eye-open" viewBox="0 0 24 24" fill="none"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="2.6" stroke="currentColor" stroke-width="1.7"/></svg>
										<svg class="eye-closed" viewBox="0 0 24 24" fill="none"><path d="m4 4 16 16M10.7 6.1A9 9 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-2.1 2.7M6.2 7.2C3.8 9 2.5 12 2.5 12s3.5 6 9.5 6c1 0 2-.2 2.8-.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
									</button>
								</div>
								<span asp-validation-for="ConfirmPassword" class="holimer-auth-validation"></span>
							</div>
						</div>

						<p class="holimer-signup-password-hint">Şifreniz en az 8 karakter; büyük harf, küçük harf, rakam ve özel karakter içermelidir.</p>

						<button type="submit" class="holimer-auth-submit holimer-signup-submit">
							<span>Üyeliği Oluştur</span>
							<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
						</button>
					</form>

					<div class="holimer-auth-register holimer-signup-login-link">
						<span>Zaten hesabınız var mı?</span>
						<a asp-controller="Home" asp-action="SignIn">Giriş yapın</a>
					</div>
				</div>
			</div>

			<aside class="holimer-auth-showcase holimer-signup-showcase">
				<div class="holimer-auth-orb holimer-auth-orb-one"></div>
				<div class="holimer-auth-orb holimer-auth-orb-two"></div>
				<div class="holimer-auth-showcase-content">
					<span class="holimer-auth-showcase-badge">HOLİMER İLAÇ A.Ş.</span>
					<h2>Ekibinize<br />katılın.</h2>
					<p>Kurumsal portal hesabınızla günlük iş akışlarınıza hızlı ve güvenli biçimde erişin.</p>

					<div class="holimer-auth-feature-list">
						<div class="holimer-auth-feature"><span>✓</span><div><strong>Tek hesapla erişim</strong><small>Yetkiniz dahilindeki tüm modüller</small></div></div>
						<div class="holimer-auth-feature"><span>✓</span><div><strong>Güvenli kullanıcı yönetimi</strong><small>Rol ve departmana göre kontrollü erişim</small></div></div>
						<div class="holimer-auth-feature"><span>✓</span><div><strong>Kolay başlangıç</strong><small>Bilgilerinizi tamamlayın ve hesabınızı oluşturun</small></div></div>
					</div>
				</div>
				<div class="holimer-auth-showcase-footer">Optimum health, güçlü operasyon.</div>
			</aside>
		</section>
		<footer class="holimer-auth-footer">© @DateTime.Now.Year Holimer İlaç A.Ş. · Kurumsal Portal</footer>
	</main>

	<script src="~/assets1/plugins/global/plugins.bundle.js?v=7.0.5"></script>
	<partial name="_ValidationScriptsPartial" />
	<script>
		(function () {
			document.querySelectorAll('[data-password-toggle]').forEach(function (toggle) {
				var input = document.getElementById(toggle.getAttribute('data-password-toggle'));
				if (!input) return;
				toggle.addEventListener('click', function () {
					var visible = input.type === 'text';
					input.type = visible ? 'password' : 'text';
					toggle.classList.toggle('is-visible', !visible);
					toggle.setAttribute('aria-pressed', (!visible).toString());
					toggle.setAttribute('aria-label', visible ? 'Şifreyi göster' : 'Şifreyi gizle');
				});
			});

			if (window.jQuery && jQuery.fn.inputmask) {
				jQuery('#phoneNumber').inputmask('mask', { mask: '9999 999 99 99' });
			}
		})();
	</script>
</body>
</html>
