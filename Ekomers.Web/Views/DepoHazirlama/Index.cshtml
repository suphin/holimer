@model IReadOnlyList<DepoHazirlamaEmriListeVM>
@{
    ViewData["Title"] = "Depo Hazırlama Emirleri";
    ViewData["Description"] = "Üretim için hazırlanacak malzeme talepleri";
}

<div class="card card-custom">
    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">
                Depo Hazırlama Emirleri
                <span class="d-block text-muted pt-2 font-size-sm">Üretime sevk edilecek malzemeler</span>
            </h3>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">
                Bekleyen depo hazırlama emri bulunmuyor.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-separate table-head-custom table-checkable">
                    <thead>
                        <tr>
                            <th>Emir No</th>
                            <th>Ürün</th>
                            <th>Kaynak Depo</th>
                            <th>Üretim Deposu</th>
                            <th>Kalem</th>
                            <th>Talep Tarihi</th>
                            <th>Üretim Tarihi</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@(item.UretimEmriNo ?? $"ÜE-{item.UretimID}")</td>
                                <td>
                                    <strong>@item.UrunKod</strong>
                                    <span class="d-block text-muted">@item.UrunAd</span>
                                </td>
                                <td>@item.KaynakDepo</td>
                                <td>@item.HedefDepo</td>
                                <td>@item.KalemSayisi</td>
                                <td>@item.TalepTarihi?.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@item.PlanlananUretimTarihi?.ToString("dd.MM.yyyy")</td>
                                <td><span class="label label-light-primary label-inline">@item.Durum</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
