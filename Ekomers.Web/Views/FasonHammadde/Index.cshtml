@model Ekomers.Models.ViewModels.Production.FasonDocumentPageVM
@{ViewData["Title"]="Fason Emanet Hammaddeler";var manage=User.IsInRole("Admin")||User.HasClaim("Authorize","FasonHammaddeYonet");}
<partial name="_Navigation"/>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Fason Hammadde Girişleri</h3></div>@if(manage){<div class="card-toolbar"><a asp-action="YeniGiris" class="btn btn-primary">Yeni Giriş</a></div>}</div><div class="card-body">
<form asp-action="Index" method="get" class="mb-5"><label for="WarehouseId">Firma / Depo</label><div class="d-flex align-items-center" style="gap:.5rem"><select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-control kt_select2"><option value="">Tüm fason firmalar</option></select><button class="btn btn-primary text-nowrap">Filtrele</button></div></form>
@if(Model.Rows.Count==0){<div class="alert alert-light-primary">Giriş belgesi bulunamadı. Önce firma deposunu oluşturup gelen hammaddeler için giriş hazırlayın.</div>}
else{<div class="table-responsive"><table class="table table-head-custom table-hover"><thead><tr><th>Belge No</th><th>Firma</th><th>Depo</th><th>Giriş Tarihi</th><th>İrsaliye</th><th>Durum</th><th></th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.Number</td><td>@r.Customer</td><td>@r.Warehouse</td><td>@r.Date.ToString("dd.MM.yyyy")</td><td>@r.DispatchNumber</td><td>@r.StatusName</td><td><a asp-action="Detay" asp-route-id="@r.Id" class="btn btn-sm btn-light-primary">Detay</a></td></tr>}</tbody></table></div>
<div class="d-flex justify-content-between"><span>@Model.Count belge · Sayfa @Model.Page / @Model.PageCount</span><div>@if(Model.Page>1){<a asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-light">Önceki</a>}@if(Model.Page<Model.PageCount){<a asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-light">Sonraki</a>}</div></div>}
</div></div>
