@model IReadOnlyList<Ekomers.Models.Entity.Production.FsnWarehouse>
@{ViewData["Title"]="Fason Firmalar ve Depolar";var manage=User.IsInRole("Admin")||User.HasClaim("Authorize","FasonHammaddeYonet");}
<partial name="_Navigation"/>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Fason Firmalar / Depolar</h3></div>@if(manage){<div class="card-toolbar"><a asp-action="YeniDepo" class="btn btn-primary">Yeni Firma / Depo</a></div>}</div><div class="card-body">
@if(Model.Count==0){<div class="alert alert-light-primary">Henüz fason firma deposu tanımlanmadı.</div>}else{<div class="table-responsive"><table class="table table-head-custom"><thead><tr><th>Firma Kodu</th><th>Firma Unvanı</th><th>Depo</th><th>Not</th><th>İşlemler</th></tr></thead><tbody>@foreach(var w in Model){<tr><td>@w.CustomerCode</td><td>@w.CustomerName</td><td>@w.Code<div class="text-muted">@w.Name</div></td><td>@w.Notes</td><td><div class="d-inline-flex flex-nowrap align-items-center" style="gap:.5rem">@if(manage){<a asp-action="YeniGiris" asp-route-warehouseId="@w.ID" class="btn btn-sm btn-primary text-nowrap">Giriş Yap</a>}<a asp-action="Stoklar" asp-route-warehouseId="@w.ID" class="btn btn-sm btn-light-primary">Stok</a><a asp-action="Gecmis" asp-route-warehouseId="@w.ID" class="btn btn-sm btn-light-primary">Geçmiş</a></div></td></tr>}</tbody></table></div>}
</div></div>
