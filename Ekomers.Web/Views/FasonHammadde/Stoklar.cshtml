@model Ekomers.Models.ViewModels.Production.FasonStockPageVM
@{ViewData["Title"]="Fason Firma Stokları";var tr=CultureInfo.GetCultureInfo("tr-TR");}
<partial name="_Navigation"/>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Firmaya Ait Emanet Stoklar</h3></div></div><div class="card-body"><form method="get" asp-action="Stoklar" class="mb-5"><div class="row"><div class="col-md-5 form-group"><label asp-for="WarehouseId">Firma / Depo</label><select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-control kt_select2"><option value="">Tüm fason firmalar</option></select></div><div class="col-md-5 form-group"><label asp-for="Search">Firma, ürün veya lot ara</label><input asp-for="Search" class="form-control" maxlength="100"/></div><div class="col-md-2 form-group d-flex align-items-end"><button class="btn btn-primary">Ara</button></div></div></form>
@if(Model.Rows.Count==0){<div class="alert alert-light-primary">Seçilen filtrelerde fason stok bulunamadı. Taslaklar stoğa dahil edilmez.</div>}else{<div class="table-responsive"><table class="table table-head-custom"><thead><tr><th>Firma / Depo</th><th>Malzeme</th><th>Lot / Seri</th><th>Üretim / SKT</th><th>Giren</th><th>Geri Alınan</th><th>Kalan</th><th></th></tr></thead><tbody>@foreach(var r in Model.Rows){<tr><td>@r.Customer<div class="text-muted">@r.Warehouse</div></td><td>@r.Material</td><td>@r.LotNumber</td><td>@(r.ProductionDate?.ToString("dd.MM.yyyy")??"-")<div class="@(r.ExpirationDate<DateTime.Today?"text-danger":"text-muted")">@(r.ExpirationDate?.ToString("dd.MM.yyyy")??"-")</div></td><td>@r.Received.ToString("#,##0.######",tr) @r.Unit</td><td>@r.Reversed.ToString("#,##0.######",tr) @r.Unit</td><td class="font-weight-bold">@r.Balance.ToString("#,##0.######",tr) @r.Unit</td><td><a asp-action="Gecmis" asp-route-warehouseId="@r.WarehouseId" asp-route-materialId="@r.MaterialId" asp-route-lotNumber="@r.LotNumber" class="btn btn-sm btn-light-primary">Geçmiş</a></td></tr>}</tbody></table></div><div class="d-flex justify-content-between"><span>@Model.Count lot / birim · Sayfa @Model.Page / @Model.PageCount</span><div>@if(Model.Page>1){<a asp-action="Stoklar" asp-route-warehouseId="@Model.WarehouseId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page-1)" class="btn btn-sm btn-light">Önceki</a>}@if(Model.Page<Model.PageCount){<a asp-action="Stoklar" asp-route-warehouseId="@Model.WarehouseId" asp-route-search="@Model.Search" asp-route-page="@(Model.Page+1)" class="btn btn-sm btn-light">Sonraki</a>}</div></div>}
<div class="text-muted mt-4">Miktarlar girişte hesaplanan stok birimindedir. Farklı birimler ve firmalar ayrı satırlardır. Üretim sarfı bu giriş ekranından yapılmaz.</div></div></div>
