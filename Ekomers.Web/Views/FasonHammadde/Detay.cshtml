@model Ekomers.Models.ViewModels.Production.FasonReceiptDetailVM
@using Ekomers.Models.Entity.Production
@{ViewData["Title"]=Model.Receipt.Number;var tr=CultureInfo.GetCultureInfo("tr-TR");var manage=User.IsInRole("Admin")||User.HasClaim("Authorize","FasonHammaddeYonet");var reverse=User.IsInRole("Admin")||User.HasClaim("Authorize","FasonHammaddeGeriAl");}
<partial name="_Navigation"/>
<div class="card card-custom mb-5"><div class="card-header"><div class="card-title"><h3 class="card-label">@Model.Receipt.Number <span class="d-block text-muted pt-2 font-size-sm">@Model.StatusName</span></h3></div><div class="card-toolbar"><div class="d-inline-flex align-items-center flex-nowrap" style="gap:.5rem">@if(Model.Receipt.Status==FsnReceiptStatus.Draft&&manage){<form asp-action="StogaAl" method="post" class="m-0"><input name="id" value="@Model.Receipt.ID" type="hidden"/><button class="btn btn-primary">Firma Stoğuna Al</button></form><form asp-action="Iptal" method="post" class="m-0" onsubmit="return confirm('Taslak iptal edilsin mi?');"><input name="id" value="@Model.Receipt.ID" type="hidden"/><button class="btn btn-light-danger">Taslağı İptal Et</button></form>}<a asp-action="Index" asp-route-warehouseId="@Model.Warehouse.ID" class="btn btn-light">Listeye Dön</a></div></div></div><div class="card-body"><div class="row"><div class="col-md-6 mb-4"><strong>Malzemenin Sahibi Firma</strong><div>@Model.Warehouse.CustomerCode - @Model.Warehouse.CustomerName</div></div><div class="col-md-6 mb-4"><strong>Fason Deposu</strong><div>@Model.Warehouse.Code - @Model.Warehouse.Name</div></div><div class="col-md-4 mb-4"><strong>Giriş Tarihi</strong><div>@Model.Receipt.ReceiptDate.ToString("dd.MM.yyyy")</div></div><div class="col-md-4 mb-4"><strong>İrsaliye</strong><div>@Model.Receipt.DispatchNumber / @(Model.Receipt.DispatchDate?.ToString("dd.MM.yyyy")??"-")</div></div><div class="col-md-4 mb-4"><strong>Kaydeden</strong><div>@Model.Receipt.CreateUserID / @Model.Receipt.CreateDate?.ToString("dd.MM.yyyy HH:mm")</div></div></div><div>@Model.Receipt.Notes</div>@if(Model.Receipt.PostedDate.HasValue){<div class="mt-3 text-muted">Stoğa alan: @Model.Receipt.PostedUser · @Model.Receipt.PostedDate.Value.ToString("dd.MM.yyyy HH:mm")</div>}@if(Model.Receipt.Status==FsnReceiptStatus.Reversed){<div class="alert alert-warning mt-4">Geri alan: @Model.Receipt.ReversedUser · @Model.Receipt.ReversedDate?.ToString("dd.MM.yyyy HH:mm")<div>@Model.Receipt.ReversalReason</div></div>}</div></div>
<div class="card card-custom mb-5"><div class="card-header"><div class="card-title"><h3 class="card-label">Gelen Malzemeler</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-head-custom"><thead><tr><th>#</th><th>Malzeme</th><th>Lot</th><th>Girilen Miktar</th><th>Stok Miktarı</th><th>Üretim / SKT</th><th>Not</th></tr></thead><tbody>@foreach(var l in Model.Lines){<tr><td>@l.Sequence</td><td>@l.Material</td><td>@l.LotNumber</td><td>@l.OriginalQuantity.ToString("#,##0.######",tr) @l.OriginalUnit</td><td>@l.Quantity.ToString("#,##0.######",tr) @l.Unit</td><td>@(l.ProductionDate?.ToString("dd.MM.yyyy")??"-")<div>@(l.ExpirationDate?.ToString("dd.MM.yyyy")??"-")</div></td><td>@l.Notes</td></tr>}</tbody></table></div></div></div>
@if(reverse&&Model.Receipt.Status==FsnReceiptStatus.Posted){<div class="card card-custom"><div class="card-body"><form asp-action="GeriAl" method="post" onsubmit="return confirm('Giriş ters hareketle geri alınsın mı?');"><input type="hidden" name="id" value="@Model.Receipt.ID"/><label for="reason">Geri Alma Gerekçesi</label><textarea id="reason" name="reason" class="form-control mb-3" required minlength="5" maxlength="500"></textarea><button class="btn btn-light-danger">Girişi Geri Al</button></form></div></div>}
