@model Ekomers.Models.ViewModels.Production.FasonReceiptFormVM
@{ViewData["Title"]="Fason Hammadde Girişi";}
<partial name="_Navigation"/>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Müşteriden Gelen Hammadde / Ambalaj Girişi</h3></div></div>
<form asp-action="YeniGiris" method="post" id="fasonReceiptForm"><input asp-for="RequestId" type="hidden"/><div class="card-body"><div asp-validation-summary="All" class="text-danger mb-4" role="alert"></div>
@if(Model.Warehouses.Count==0){<div class="alert alert-warning">Önce <a asp-action="YeniDepo">firma / depo tanımlayın</a>.</div>}
<div class="row"><div class="col-lg-6 form-group"><label asp-for="WarehouseId">Malzemenin Sahibi Firma / Depo</label><select asp-for="WarehouseId" asp-items="Model.Warehouses" class="form-control fason-search" data-placeholder="Firma kodu veya unvanıyla arayın" required><option value="">Firma deposu seçiniz</option></select></div><div class="col-lg-3 form-group"><label asp-for="ReceiptDate">Giriş Tarihi</label><input asp-for="ReceiptDate" type="date" class="form-control" required max="@DateTime.Today.ToString("yyyy-MM-dd")"/></div><div class="col-lg-3 form-group"><label asp-for="DispatchDate">İrsaliye Tarihi</label><input asp-for="DispatchDate" type="date" class="form-control"/></div><div class="col-lg-4 form-group"><label asp-for="DispatchNumber">İrsaliye / Teslim Belge No</label><input asp-for="DispatchNumber" class="form-control" maxlength="100" required/></div><div class="col-lg-8 form-group"><label asp-for="Notes">Giriş Açıklaması</label><input asp-for="Notes" class="form-control" maxlength="500"/></div></div>
<div class="alert alert-light-info">Miktar seçilen birimden ürünün ana birimine, tanımlı ürün dönüşümleriyle çevrilir. Birim boş bırakılırsa ürünün ana birimi kullanılır. Taslak stok artırmaz; detay ekranında “Firma Stoğuna Al” ile onaylayın.</div>
<div class="table-responsive"><table class="table table-head-custom"><thead><tr><th style="min-width:340px">Malzeme</th><th style="min-width:180px">Giriş Birimi</th><th style="min-width:120px">Miktar</th><th style="min-width:150px">Lot / Seri No</th><th>Üretim Tarihi</th><th>SKT</th><th style="min-width:180px">Not</th><th></th></tr></thead><tbody id="fasonLines">
@for(var i=0;i<Model.Lines.Count;i++){<tr class="fason-row"><td><select asp-for="Lines[i].MaterialId" asp-items="Model.Materials" class="form-control fason-search" data-placeholder="Kod veya ad ile malzeme arayın" aria-label="Malzeme"><option value="">Malzeme seçiniz</option></select></td><td><select asp-for="Lines[i].UnitId" asp-items="Model.Units" class="form-control fason-search" data-placeholder="Ana birimi kullan" aria-label="Giriş birimi"><option value="">Ana birimi kullan</option></select></td><td><input asp-for="Lines[i].Quantity" class="form-control" inputmode="decimal" aria-label="Miktar"/></td><td><input asp-for="Lines[i].LotNumber" class="form-control" maxlength="100" aria-label="Lot / Seri No"/></td><td><input asp-for="Lines[i].ProductionDate" type="date" class="form-control" aria-label="Üretim tarihi"/></td><td><input asp-for="Lines[i].ExpirationDate" type="date" class="form-control" aria-label="SKT"/></td><td><input asp-for="Lines[i].Notes" class="form-control" maxlength="250" aria-label="Satır notu"/></td><td><button type="button" class="btn btn-sm btn-light-danger fason-remove">Kaldır</button></td></tr>}
</tbody></table></div><button type="button" id="addFasonLine" class="btn btn-light-primary">Satır Ekle</button></div><div class="card-footer d-flex justify-content-between"><a asp-action="Index" class="btn btn-light">Vazgeç</a><button type="submit" class="btn btn-primary" disabled="@(Model.Warehouses.Count==0)">Taslağı Kaydet</button></div></form></div>
<template id="fasonLineTemplate"><tr class="fason-row"><td><select name="Lines[__index__].MaterialId" asp-items="Model.Materials" class="form-control fason-search" data-placeholder="Kod veya ad ile malzeme arayın" aria-label="Malzeme"><option value="">Malzeme seçiniz</option></select></td><td><select name="Lines[__index__].UnitId" asp-items="Model.Units" class="form-control fason-search" data-placeholder="Ana birimi kullan" aria-label="Giriş birimi"><option value="">Ana birimi kullan</option></select></td><td><input name="Lines[__index__].Quantity" class="form-control" inputmode="decimal" aria-label="Miktar"/></td><td><input name="Lines[__index__].LotNumber" class="form-control" maxlength="100" aria-label="Lot / Seri No"/></td><td><input name="Lines[__index__].ProductionDate" type="date" class="form-control" aria-label="Üretim tarihi"/></td><td><input name="Lines[__index__].ExpirationDate" type="date" class="form-control" aria-label="SKT"/></td><td><input name="Lines[__index__].Notes" class="form-control" maxlength="250" aria-label="Satır notu"/></td><td><button type="button" class="btn btn-sm btn-light-danger fason-remove">Kaldır</button></td></tr></template>
@section JSSection{<script src="~/js/production/fason-receipt.js" asp-append-version="true"></script>}
