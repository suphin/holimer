@model Ekomers.Models.ViewModels.Purchasing.QualityStockDispositionListVM
@{
    ViewData["Title"] = "Stok Sonuçlandırma";
    var canProcess = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaStokSonuclandir");
    var canUndo = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaSurecGeriAl");
}

<div class="card card-custom mb-5">
    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">
                Stok Sonuçlandırma
                <span class="d-block text-muted pt-2 font-size-sm">Kalite kararı tamamlanan karantina lotlarını kullanılabilir stok, iade veya hurda olarak sonuçlandırın</span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a asp-action="Analizler" class="btn btn-sm btn-light-primary">Karantina Analizleri</a>
        </div>
    </div>
    <div class="card-body">
        <div class="alert alert-light-info">
            Onaylanan ve şartlı onaylanan lotlar seçilen kullanılabilir depoya aktarılır. Reddedilen lotlar tedarikçiye iade edilir veya hurda deposuna taşınır. İşlem stok miktarını ve mevcut lot maliyetini birlikte taşır; aynı kalite kaydı yalnızca bir kez sonuçlandırılabilir.
        </div>
        @if (!canProcess)
        {
            <div class="alert alert-light-warning">Bu ekran salt okunur. Stok sonuçlandırma işlemini satınalma yetkilisi veya admin yapabilir.</div>
        }
        <form asp-action="StokSonuclandirma" method="get">
            <div class="row align-items-end">
                <div class="col-lg-6 form-group">
                    <label>Listede Ara</label>
                    <input name="search" value="@Model.Search" class="form-control" placeholder="Analiz, mal kabul, tedarikçi, malzeme veya lot..." />
                </div>
                <div class="col-lg-3 form-group">
                    <label>Durum</label>
                    <select name="status" class="form-control">
                        <option value="pending" selected="@(Model.Status == "pending")">Bekleyenler (@Model.PendingCount)</option>
                        <option value="completed" selected="@(Model.Status == "completed")">Sonuçlananlar (@Model.CompletedCount)</option>
                        <option value="all" selected="@(Model.Status == "all")">Tümü (@(Model.PendingCount + Model.CompletedCount))</option>
                    </select>
                </div>
                <div class="col-lg-3 form-group">
                    <button class="btn btn-primary mr-2">Filtrele</button>
                    <a asp-action="StokSonuclandirma" class="btn btn-light">Temizle</a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header">
        <div class="card-title">
            <h3 class="card-label">Kalite Lotları <span class="text-muted">(@Model.Rows.Count)</span></h3>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Rows.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">Seçilen filtreye uygun kalite lotu bulunamadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-separate table-head-custom align-middle">
                    <thead>
                        <tr>
                            <th>Analiz / Mal Kabul</th>
                            <th>Tedarikçi</th>
                            <th>Malzeme / Lot</th>
                            <th>Miktar / Kaynak</th>
                            <th>Kalite Kararı</th>
                            <th style="min-width:390px">Stok Sonucu</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        var decisionClass = row.QualityStatus switch
                        {
                            Ekomers.Models.Enums.PrdQualityControlStatus.Approved => "label-light-success",
                            Ekomers.Models.Enums.PrdQualityControlStatus.ConditionalApproval => "label-light-warning",
                            _ => "label-light-danger"
                        };
                        var isAccepted = row.QualityStatus == Ekomers.Models.Enums.PrdQualityControlStatus.Approved || row.QualityStatus == Ekomers.Models.Enums.PrdQualityControlStatus.ConditionalApproval;
                        <tr>
                            <td>
                                <a asp-action="AnalizDetay" asp-route-id="@row.InspectionId"><strong>@row.InspectionNumber</strong></a>
                                <a asp-controller="SatinalmaYonetimi" asp-action="MalKabulDetay" asp-route-id="@row.GoodsReceiptId" class="d-block text-muted">@row.ReceiptNumber</a>
                            </td>
                            <td><strong>@row.SupplierCode</strong><span class="d-block text-muted">@row.SupplierName</span></td>
                            <td><strong>@row.MaterialCode</strong><span class="d-block text-muted">@row.MaterialName</span><span class="label label-light label-inline mt-1">Lot: @row.LotNumber</span></td>
                            <td><strong>@row.Quantity.ToString("0.######") @row.Unit</strong><span class="d-block text-muted">@row.SourceWarehouse</span></td>
                            <td>
                                <span class="label @decisionClass label-inline">@row.QualityStatus.ToTurkish()</span>
                                <span class="d-block text-muted mt-2">@(row.DecisionDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span>
                                @if (!string.IsNullOrWhiteSpace(row.DecisionNote))
                                {
                                    <span class="d-block text-muted mt-1">@row.DecisionNote</span>
                                }
                            </td>
                            <td>
                                @if (row.IsCompleted)
                                {
                                    <div class="d-flex align-items-start">
                                        <span class="label label-light-success label-inline mr-3">Sonuçlandı</span>
                                        <div>
                                            <strong>@(row.DispositionAction?.ToTurkish() ?? "Stok sonucu işlendi")</strong>
                                            <span class="d-block text-muted">Belge: @row.DispositionDocumentNumber · @(row.DispositionDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span>
                                            @if (!string.IsNullOrWhiteSpace(row.TargetWarehouse))
                                            {
                                                <span class="d-block text-muted">Hedef: @row.TargetWarehouse</span>
                                            }
                                        </div>
                                     </div>
                                    @if (canUndo)
                                    {
                                        <form asp-action="StokSonucunuGeriAl" method="post" class="mt-3" onsubmit="return confirm('Stok sonucu ters hareketlerle geri alınacak. Devam edilsin mi?');">
                                            <input type="hidden" name="inspectionId" value="@row.InspectionId" />
                                            <div class="input-group input-group-sm"><input name="reason" class="form-control" minlength="5" maxlength="1000" placeholder="Geri alma gerekçesi" required /><div class="input-group-append"><button class="btn btn-light-warning">Geri Al</button></div></div>
                                        </form>
                                    }
                                 }
                                else if (!canProcess)
                                {
                                    <span class="text-muted">İşlem yetkiniz bulunmuyor.</span>
                                }
                                else if (isAccepted)
                                {
                                    <form asp-action="StokSonuclandir" method="post" onsubmit="return confirm('Bu lot kullanılabilir stoğa aktarılacak. İşlem onaylansın mı?');">
                                        <input type="hidden" name="InspectionId" value="@row.InspectionId" />
                                        <input type="hidden" name="Action" value="@((int)Ekomers.Models.Enums.PurQualityDispositionAction.ReleaseToUsableStock)" />
                                        <div class="form-group mb-2">
                                            <select name="TargetWarehouseId" class="form-control form-control-sm" required>
                                                <option value="">Kullanılabilir hedef depo seçiniz</option>
                                                @foreach (var warehouse in Model.UsableWarehouses)
                                                {
                                                    <option value="@warehouse.Value">@warehouse.Text</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="form-group mb-2"><input name="Notes" class="form-control form-control-sm" maxlength="1000" placeholder="Açıklama@(row.QualityStatus == Ekomers.Models.Enums.PrdQualityControlStatus.ConditionalApproval ? " (zorunlu)" : " (isteğe bağlı)")" required="@(row.QualityStatus == Ekomers.Models.Enums.PrdQualityControlStatus.ConditionalApproval)" /></div>
                                        <button class="btn btn-sm btn-success" disabled="@(Model.UsableWarehouses.Count == 0)">Kullanılabilir Stoğa Al</button>
                                        @if (Model.UsableWarehouses.Count == 0)
                                        {
                                            <span class="d-block text-danger mt-2">Aktif kullanılabilir depo tanımı bulunamadı.</span>
                                        }
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="StokSonuclandir" method="post" class="disposition-form" onsubmit="return confirm('Reddedilen lot için seçilen stok işlemi uygulanacak. Devam edilsin mi?');">
                                        <input type="hidden" name="InspectionId" value="@row.InspectionId" />
                                        <div class="row">
                                            <div class="col-md-6 form-group mb-2">
                                                <select name="Action" class="form-control form-control-sm disposition-action" required>
                                                    <option value="">İşlem seçiniz</option>
                                                    <option value="@((int)Ekomers.Models.Enums.PurQualityDispositionAction.ReturnToSupplier)">Tedarikçiye İade</option>
                                                    <option value="@((int)Ekomers.Models.Enums.PurQualityDispositionAction.MoveToScrap)">Hurda Deposuna Al</option>
                                                </select>
                                            </div>
                                            <div class="col-md-6 form-group mb-2">
                                                <select name="TargetWarehouseId" class="form-control form-control-sm scrap-warehouse" disabled>
                                                    <option value="">Hurda deposu seçiniz</option>
                                                    @foreach (var warehouse in Model.ScrapWarehouses)
                                                    {
                                                        <option value="@warehouse.Value">@warehouse.Text</option>
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="form-group mb-2"><input name="Notes" class="form-control form-control-sm" maxlength="1000" placeholder="İade / hurda gerekçesi (zorunlu)" required /></div>
                                        <button class="btn btn-sm btn-danger">Red Stok İşlemini Uygula</button>
                                        @if (Model.ScrapWarehouses.Count == 0)
                                        {
                                            <span class="d-block text-muted mt-2">Hurda seçeneği için önce aktif bir hurda deposu tanımlanmalıdır.</span>
                                        }
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('.disposition-form').forEach(function (form) {
            var action = form.querySelector('.disposition-action');
            var warehouse = form.querySelector('.scrap-warehouse');
            if (!action || !warehouse) return;
            var updateWarehouse = function () {
                var isScrap = action.value === '@((int)Ekomers.Models.Enums.PurQualityDispositionAction.MoveToScrap)';
                warehouse.disabled = !isScrap;
                warehouse.required = isScrap;
                if (!isScrap) warehouse.value = '';
            };
            action.addEventListener('change', updateWarehouse);
            updateWarehouse();
        });
    });
</script>
