@model IReadOnlyList<Ekomers.Models.ViewModels.Production.LogoProductionReceiptListVM>
@{
    ViewData["Title"] = "Logo Üretim Giriş Fişleri";
    var canManage = User.IsInRole("Admin") || User.HasClaim("Authorize", "LogoUretimGirisiYonet");
}

@if (TempData["success"] != null)
{
    <div class="alert alert-light-success mb-5">@TempData["success"]</div>
}
@if (TempData["error"] != null)
{
    <div class="alert alert-light-danger mb-5">@TempData["error"]</div>
}

<div class="card card-custom">
    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">
                Logo Üretim Giriş Fişleri
                <span class="d-block text-muted pt-2 font-size-sm">Mamul ve yarı mamul miktarlarını taslak olarak hazırlayın, kontrollü biçimde Logo'ya aktarın.</span>
            </h3>
        </div>
        @if (canManage)
        {
            <div class="card-toolbar">
                <a asp-action="Yeni" class="btn btn-primary"><i class="la la-plus"></i> Yeni Üretim Giriş Fişi</a>
            </div>
        }
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">Henüz Logo üretim giriş fişi taslağı oluşturulmadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-separate table-head-custom table-hover">
                    <thead>
                        <tr>
                            <th>Belge No</th>
                            <th>Tarih</th>
                            <th>Logo Fiş No</th>
                            <th>Ambar</th>
                            <th>Kalem</th>
                            <th>Toplam Miktar</th>
                            <th>Deneme</th>
                            <th>Durum</th>
                            <th class="text-right">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var labelClass = item.Status switch
                            {
                                PrdLogoTransferStatus.Sent => "label-light-success",
                                PrdLogoTransferStatus.Failed => "label-light-danger",
                                PrdLogoTransferStatus.Sending => "label-light-info",
                                PrdLogoTransferStatus.Cancelled => "label-light-dark",
                                _ => "label-light-warning"
                            };
                            <tr>
                                <td><strong>@item.DocumentNumber</strong></td>
                                <td>@item.DocumentDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <strong>@(item.LogoAssignedSlipNumber ?? "-")</strong>
                                    @if (string.IsNullOrWhiteSpace(item.LogoAssignedSlipNumber))
                                    {
                                        <span class="d-block text-muted">İstenen: @(item.LogoSlipNumber ?? "Otomatik")</span>
                                    }
                                </td>
                                <td>@item.WarehouseNumber</td>
                                <td>@item.LineCount</td>
                                <td>@item.TotalQuantity.ToString("N4")</td>
                                <td>@item.AttemptCount</td>
                                <td><span class="label @labelClass label-inline">@item.Status.ToTurkish()</span></td>
                                <td class="text-right text-nowrap">
                                    <a asp-action="Detay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a>
                                    @if (item.Status == PrdLogoTransferStatus.Cancelled && User.IsInRole("Admin"))
                                    {
                                        <form asp-action="Sil" method="post" class="d-inline" onsubmit="return confirm('Bu iptal edilmiş fiş portal listesinden silinecek. Logo tarafında herhangi bir işlem yapılmayacak. Devam edilsin mi?');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-light-danger">Sil</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
