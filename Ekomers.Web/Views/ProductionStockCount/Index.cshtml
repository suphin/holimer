@model Ekomers.Models.ViewModels.Production.WarehouseCountVM
@using Ekomers.Models.Entity.Production
@{ViewData["Title"]="Depo Sayımı";var entryCount=Model.Rows.Sum(x=>x.Entries.Count);}
@if(TempData["error"] is string error){<div class="alert alert-danger">@error</div>}
@if(TempData["success"] is string success){<div class="alert alert-success">@success</div>}
@if(Model.Error!=null){<div class="alert alert-danger" role="alert">@Model.Error Sayım girişleri korunmuştur; birim tanımlarını kontrol edip sayfayı yenileyiniz.</div>}
<div class="alert alert-light-primary">Sistem stokları tanımlı dönüşümlerle ürünün ana biriminde hesaplanır. Sayım miktarını ana stok biriminde giriniz. Dönüşüm tanımı değişirse sistem stok referanslarını yenileyip farkları kontrol ediniz.</div>
<div class="card card-custom mb-5">
    <div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@(Model.IsCorrection?"Depo Sayımı Düzeltmesi":"Depo Sayımı")<span class="d-block text-muted pt-2 font-size-sm">Kalıcı taslak #@Model.DraftId · @(Model.Status==PrdWarehouseCountDraftStatus.Draft?"Taslak":Model.Status==PrdWarehouseCountDraftStatus.Posted?"Tamamlandı":"İptal") · @Model.Rows.Count ürün / @entryCount sayım girişi</span></h3></div>
    <div class="card-toolbar"><a asp-controller="ProductionInventory" asp-action="Index" class="btn btn-light-primary">Stok Hareketleri</a><a asp-action="Index" asp-route-warehouseId="@Model.WarehouseId" class="btn btn-light ml-2">Aktif Sayıma Dön</a></div></div>
    <div class="card-body">
        <form asp-action="Index" method="get"><div class="form-group"><label>Depo</label><select name="warehouseId" asp-items="Model.Warehouses" class="form-control" onchange="if(confirmCountNavigation())this.form.submit();"></select></div></form>
        @if(Model.IsCorrection){<div class="alert alert-light-warning">@Model.SourceDocumentNumber belgesi için düzeltme hazırlanıyor. Önceki belge değişmez; sayılmayan ürünlere işlem yapılmaz.</div>}
        <div class="alert alert-light-info mb-0">Aynı ürünü farklı raf/alanlar için tekrar ekleyebilirsiniz. Her giriş ayrı saklanır ve ürün toplamı otomatik hesaplanır. Güncelleme/kaldırma stok hareketi oluşturmaz; yalnızca <strong>Sayımı Stoka İşle</strong> stok farkını işler. Bu ekran ürün toplamı sayımıdır, lot bazlı sayım değildir.</div>
        @if(Model.InventoryDocumentId.HasValue){<a asp-controller="ProductionInventory" asp-action="Detay" asp-route-id="@Model.InventoryDocumentId" class="btn btn-light-success mt-3">Oluşan Sayım Belgesini Aç</a>}
    </div>
</div>
@if(Model.WarehouseId==0){<div class="alert alert-warning">Aktif depo bulunamadı.</div>}
else if(Model.DraftId>0){
    @if(!Model.IsReadOnly){
        <div class="card card-custom mb-5"><div class="card-header"><div class="card-title"><h3 class="card-label">Sayım Girişi Ekle</h3></div></div><div class="card-body">
            <form asp-action="AddItem" method="post" class="count-add-form">
                <partial name="_DraftFields" model="Model" /><input type="hidden" name="requestId" value="@Model.RequestId" />
                <div class="row">
                    <div class="col-lg-6 form-group"><label>Ürün</label><select id="warehouseCountMaterial" name="materialId" class="form-control" required><option value="">Ürün kodu veya adıyla arayın</option></select></div>
                    <div class="col-lg-3 form-group"><label>Bu Alanda Sayılan Miktar</label><input type="text" name="countedQuantity" class="form-control" inputmode="decimal" placeholder="0" required autocomplete="off" /></div>
                    <div class="col-lg-3 form-group"><label>Raf / Alan (isteğe bağlı)</label><input type="text" name="location" class="form-control" maxlength="100" placeholder="Raf A, üst kat, palet 3..." /></div>
                    <div class="col-lg-9 form-group mb-lg-0"><label>Giriş Notu</label><input name="entryNotes" class="form-control" maxlength="250" /></div>
                    <div class="col-lg-3 d-flex align-items-end"><button type="submit" class="btn btn-primary btn-block">Ayrı Sayım Girişi Ekle</button></div>
                </div>
            </form>
        </div></div>
    }
    <div class="card card-custom mb-5"><div class="card-header"><div class="card-title"><h3 class="card-label">Ürün Toplamları <span class="d-block text-muted font-size-sm pt-2">Alt satır değişikliklerini “Güncelle” ile kaydedin; kaydedilmemiş girişler toplamı değiştirmez.</span></h3></div></div><div class="card-body">
        @if(Model.Rows.Count==0){<p class="text-muted">Henüz sayım girişi yok.</p>}
        else{<div class="table-responsive"><table class="table table-separate table-head-custom">
            <thead><tr><th>Ürün / Tür</th><th class="text-right">Güncel Sistem Stoku</th><th class="text-right">Rezerve</th><th class="text-right">Sayım Toplamı</th><th class="text-right">Güncel Fark</th><th></th></tr></thead><tbody>
            @foreach(var row in Model.Rows){
                var counted=decimal.TryParse(row.CountedQuantity,NumberStyles.Number,CultureInfo.GetCultureInfo("tr-TR"),out var parsed)?(decimal?)parsed:null;
                var diff=counted.HasValue&&row.Error==null?counted.Value-row.CurrentQuantity:(decimal?)null;
                <tr class="@(row.StockChanged?"table-warning":"")"><td><strong>@row.MaterialCode</strong><div>@row.MaterialName</div><span class="text-muted">@row.MaterialType</span>
                    @if(row.StockChanged){<div class="text-warning">Stok değişti · İlk referans: @row.SnapshotCurrentQuantity.ToString("0.######") @row.Unit</div>}
                    @if(row.CriticalQuantity.HasValue){<div class="text-muted">Kritik: @row.CriticalQuantity.Value.ToString("0.######") @row.Unit</div>}
                    @if(row.Error!=null){<div class="text-danger" role="alert">@row.Error Girişleriniz korunmuştur.</div>}
                </td><td class="text-right">@(row.Error==null?row.CurrentQuantity.ToString("0.######")+" "+row.Unit:"Hesaplanamadı")</td><td class="text-right">@(row.Error==null?row.ReservedQuantity.ToString("0.######")+" "+row.Unit:"—")</td>
                <td class="text-right"><strong class="text-primary">@(row.CountedQuantity??"Sayılmadı") @(counted.HasValue?row.Unit:"")</strong><div class="text-muted">@row.Entries.Count ayrı giriş</div></td>
                <td class="text-right @(diff<0?"text-danger":"text-success")">@(diff.HasValue?diff.Value.ToString("+0.######;-0.######;0"):"-") @row.Unit</td>
                <td>@if(!Model.IsReadOnly){<form asp-action="RemoveProduct" method="post" onsubmit="return confirm('Bu ürünün bütün sayım girişleri kaldırılsın mı? Diğer ürünler korunacak.');"><partial name="_DraftFields" model="Model" /><input type="hidden" name="materialId" value="@row.MaterialId" /><button class="btn btn-sm btn-light-danger">Ürünü Kaldır</button></form>}</td></tr>
                <tr><td colspan="6"><details class="mb-4" open="@(row.Entries.Count<=3)"><summary class="font-weight-bold">@row.MaterialCode sayım girişleri (@row.Entries.Count)</summary>
                    @if(row.Entries.Count==0){<p class="text-muted mt-3">Henüz sayılmadı. Üstteki alandan sayım girişleri ekleyiniz.</p>}
                    @foreach(var entry in row.Entries){
                        <div class="border rounded p-3 mt-3">
                            <div class="text-muted mb-2">Giriş #@entry.Id · @entry.User · @entry.CreatedAt?.ToString("dd.MM.yyyy HH:mm")</div>
                            @if(Model.IsReadOnly){<div>@entry.CountedQuantity @row.Unit · @(entry.Location??"Alan belirtilmedi") · @entry.Notes</div>}
                            else{
                                <form asp-action="UpdateItem" method="post" class="count-entry-form"><partial name="_DraftFields" model="Model" /><input type="hidden" name="entryId" value="@entry.Id" />
                                    <div class="row align-items-end">
                                        <div class="col-lg-3 form-group mb-lg-0"><label>Miktar (@row.Unit)</label><input name="countedQuantity" value="@entry.CountedQuantity" class="form-control" inputmode="decimal" required /></div>
                                        <div class="col-lg-3 form-group mb-lg-0"><label>Raf / Alan</label><input name="location" value="@entry.Location" class="form-control" maxlength="100" /></div>
                                        <div class="col-lg-3 form-group mb-lg-0"><label>Not</label><input name="entryNotes" value="@entry.Notes" class="form-control" maxlength="250" /></div>
                                        <div class="col-lg-3 d-flex"><button type="submit" class="btn btn-sm btn-light-primary mr-2">Güncelle</button><button type="submit" class="btn btn-sm btn-light-danger count-remove-entry" formaction="@Url.Action("RemoveItem")" formnovalidate>Kaldır</button></div>
                                    </div>
                                </form>
                            }
                        </div>
                    }
                </details></td></tr>
            }
            </tbody></table></div>}
    </div></div>
    @if(!Model.IsReadOnly){
        <div class="card card-custom mb-5"><div class="card-body">
            <form asp-action="Save" method="post" id="warehouseCountFinalForm"><partial name="_DraftFields" model="Model" />
                <div class="row"><div class="col-md-3 form-group"><label>Sayım Tarihi</label><input asp-for="CountDate" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" required /></div><div class="col-md-9 form-group"><label>Sayım Notu</label><input asp-for="Notes" class="form-control" maxlength="500" /></div></div>
                <div class="d-flex flex-wrap"><button class="btn btn-light-primary mr-3 mb-2" formaction="@Url.Action("UpdateDraft")">Taslak Bilgilerini Kaydet</button><button class="btn btn-success mb-2 count-post" disabled="@(entryCount==0||Model.Error!=null||Model.Rows.Any(r=>r.Error!=null))">@(Model.IsCorrection?"Sayım Düzeltmesini Stoka İşle":"Sayımı Stoka İşle")</button></div>
            </form>
            <div class="d-flex flex-wrap mt-3">
                <form asp-action="RefreshSnapshots" method="post" class="mr-3 mb-2" onsubmit="return confirm('Sistem stok referansları güncel stokla değiştirilecek; sayım miktarları korunacak. Farkları yeniden kontrol etmelisiniz. Devam edilsin mi?');"><partial name="_DraftFields" model="Model" /><button class="btn btn-light-warning">Sistem Stok Referanslarını Yenile</button></form>
                <form asp-action="Clear" method="post" onsubmit="return confirm('Bu taslak iptal edilerek geçmişte saklanacak ve yeni taslak açılacak. Stok değişmeyecek. Devam edilsin mi?');"><partial name="_DraftFields" model="Model" /><button class="btn btn-light-danger">Taslağı İptal Et / Yeni Sayım</button></form>
            </div>
        </div></div>
    }
}
@if(Model.History.Count>0){
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Bu Depodaki Sayım Kayıtlarım (son 10)</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table"><thead><tr><th>Taslak</th><th>Tarih</th><th>Durum</th><th>Not</th><th></th></tr></thead><tbody>
@foreach(var item in Model.History){<tr><td>#@item.Id</td><td>@item.CountDate.ToString("dd.MM.yyyy")</td><td>@(item.Status==PrdWarehouseCountDraftStatus.Draft?"Taslak":item.Status==PrdWarehouseCountDraftStatus.Posted?"Tamamlandı":"İptal")</td><td>@item.Notes</td><td><a asp-action="Index" asp-route-draftId="@item.Id" class="btn btn-sm btn-light">Girişleri Gör</a></td></tr>}
</tbody></table></div></div></div>}
@section JSSection{
<script>
function confirmCountNavigation(){return !document.querySelector('form[data-dirty="1"]')||confirm('Kaydedilmemiş değişiklikler var. Sayfadan ayrılmak istiyor musunuz?');}
(function(){
    var submitting=false;
    if(window.jQuery&&jQuery.fn.select2){$(function(){$('#warehouseCountMaterial').select2({width:'100%',placeholder:'Ürün kodu veya adıyla arayın',allowClear:true,ajax:{url:'@Url.Action("SearchMaterials")',dataType:'json',delay:250,data:function(p){return {term:p.term||'',page:p.page||1,sourceDocumentId:@(Model.SourceDocumentId?.ToString()??"null")};},processResults:function(data){return data;}}});});}
    document.querySelectorAll('.count-entry-form').forEach(function(form){form.addEventListener('input',function(){form.dataset.dirty='1';});form.addEventListener('submit',function(e){if(e.submitter&&e.submitter.classList.contains('count-remove-entry')&&!confirm('Yalnızca bu sayım girişi kaldırılsın mı?'))e.preventDefault();});});
    var finalForm=document.getElementById('warehouseCountFinalForm');
    if(finalForm)finalForm.addEventListener('input',function(){finalForm.dataset.dirty='1';});
    if(finalForm)finalForm.addEventListener('submit',function(e){if(!e.submitter||!e.submitter.classList.contains('count-post'))return;if(document.querySelector('.count-entry-form[data-dirty="1"]')){e.preventDefault();alert('Önce alt satırlardaki değişiklikleri Güncelle ile kaydediniz.');return;}if(!confirm('@Model.Rows.Count ürünün kaydedilmiş giriş toplamlarına göre stok farkları işlenecek. Devam edilsin mi?'))e.preventDefault();});
    document.addEventListener('submit',function(e){if(e.defaultPrevented)return;var otherDirty=Array.from(document.querySelectorAll('form[data-dirty="1"]')).some(function(form){return form!==e.target;});if(otherDirty&&!confirm('Diğer satırlarda veya taslak bilgilerinde kaydedilmemiş değişiklikler var. Bu işlemden sonra onlar kaybolacak. Devam edilsin mi?')){e.preventDefault();return;}submitting=true;});
    window.addEventListener('beforeunload',function(e){if(!submitting&&document.querySelector('form[data-dirty="1"]')){e.preventDefault();e.returnValue='';}});
})();
</script>}
