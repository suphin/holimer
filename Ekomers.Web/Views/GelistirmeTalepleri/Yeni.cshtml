@model DevelopmentRequestCreateVM
@using Ekomers.Models.Enums
@{
    ViewData["Title"] = "Yeni Geliştirme Talebi";
}

@section CSSection {
    <style>
        .request-form-card { max-width: 980px; margin: 0 auto; border-radius: 18px; }
        .request-form-card textarea { min-height: 220px; resize: vertical; }
        .request-help { background: #f3f6f9; border-radius: 12px; }
    </style>
}

<div class="card card-custom request-form-card">
    <div class="card-header">
        <div class="card-title"><h3 class="card-label">Yeni Geliştirme Talebi<span class="d-block text-muted pt-2 font-size-sm">İhtiyacı ve beklediğiniz sonucu olabildiğince açık anlatın.</span></h3></div>
        <div class="card-toolbar"><a asp-action="Index" class="btn btn-light">Listeye Dön</a></div>
    </div>
    <form asp-action="Yeni" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <div class="form-group">
                <label asp-for="Title" class="font-weight-bold"></label>
                <input asp-for="Title" class="form-control form-control-lg" placeholder="Örn. Depo sayım ekranına barkod desteği" autofocus />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="font-weight-bold"></label>
                <textarea asp-for="Description" class="form-control" placeholder="Mevcut durum nedir, nasıl çalışmasını bekliyorsunuz, kimler kullanacak?"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-md-5 form-group mb-md-0">
                    <label asp-for="Priority" class="font-weight-bold"></label>
                    <select asp-for="Priority" class="form-control">
                        <option value="1">Düşük</option><option value="2">Normal</option><option value="3">Yüksek</option><option value="4">Acil</option>
                    </select>
                </div>
                <div class="col-md-7"><div class="request-help p-4 text-muted"><i class="la la-info-circle text-primary mr-2"></i>Talep oluşturulduktan sonra durum değişikliklerini bu alandan takip edebilirsiniz.</div></div>
            </div>
        </div>
        <div class="card-footer d-flex justify-content-end">
            <a asp-action="Index" class="btn btn-light mr-2">Vazgeç</a>
            <button class="btn btn-primary"><i class="la la-paper-plane"></i> Talebi Gönder</button>
        </div>
    </form>
</div>

@section JSSection {
    <partial name="_ValidationScriptsPartial" />
}
