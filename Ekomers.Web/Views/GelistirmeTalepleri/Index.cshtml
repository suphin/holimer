@model DevelopmentRequestIndexVM
@using Ekomers.Models.Enums
@{
    ViewData["Title"] = "Geliştirme Talepleri";
    string StatusClass(DevelopmentRequestStatus value) => value switch
    {
        DevelopmentRequestStatus.New => "label-light-primary",
        DevelopmentRequestStatus.InProgress => "label-light-warning",
        DevelopmentRequestStatus.Completed => "label-light-success",
        _ => "label-light"
    };
    string PriorityClass(DevelopmentRequestPriority value) => value switch
    {
        DevelopmentRequestPriority.Urgent => "text-danger",
        DevelopmentRequestPriority.High => "text-warning",
        DevelopmentRequestPriority.Low => "text-info",
        _ => "text-muted"
    };
}

@section CSSection {
    <style>
        .request-stat { border: 0; border-radius: 16px; box-shadow: 0 8px 24px rgba(31,45,61,.06); }
        .request-stat strong { font-size: 2rem; line-height: 1; }
        .request-table th, .request-table td { padding: 1.15rem 1.25rem; vertical-align: middle; }
        .request-empty { padding: 4rem 1rem; text-align: center; color: #a5a5b8; }
        .request-title { color: #181c32; font-weight: 600; }
    </style>
}

<div class="d-flex flex-wrap justify-content-between align-items-center mb-6">
    <div>
        <h2 class="font-weight-bolder mb-1">Geliştirme Talepleri</h2>
        <span class="text-muted">@(Model.IsAdmin ? "Kullanıcı taleplerini değerlendirin ve sonuçlandırın." : "İyileştirme ve yeni özellik taleplerinizi iletin, durumlarını izleyin.")</span>
    </div>
    <a asp-action="Yeni" class="btn btn-primary mt-3 mt-md-0"><i class="la la-plus"></i> Yeni Talep</a>
</div>

@if (TempData["success"] != null) { <div class="alert alert-light-success mb-6">@TempData["success"]</div> }
@if (TempData["error"] != null) { <div class="alert alert-light-danger mb-6">@TempData["error"]</div> }
@if (TempData["warning"] != null) { <div class="alert alert-light-warning mb-6">@TempData["warning"]</div> }

<div class="row mb-3">
    <div class="col-4 mb-4"><div class="card request-stat h-100"><div class="card-body"><span class="text-muted font-weight-bold">Yeni</span><strong class="d-block text-primary mt-3">@Model.NewCount</strong></div></div></div>
    <div class="col-4 mb-4"><div class="card request-stat h-100"><div class="card-body"><span class="text-muted font-weight-bold">İşlemde</span><strong class="d-block text-warning mt-3">@Model.InProgressCount</strong></div></div></div>
    <div class="col-4 mb-4"><div class="card request-stat h-100"><div class="card-body"><span class="text-muted font-weight-bold">Tamamlandı</span><strong class="d-block text-success mt-3">@Model.CompletedCount</strong></div></div></div>
</div>

<div class="card card-custom mb-6">
    <div class="card-body py-5">
        <form method="get" class="row align-items-end">
            <div class="col-lg-6 form-group mb-lg-0">
                <label>Talep ara</label>
                <input name="search" value="@Model.Search" class="form-control" placeholder="Talep no, başlık veya açıklama..." />
            </div>
            <div class="col-lg-3 form-group mb-lg-0">
                <label>Durum</label>
                <select name="status" class="form-control">
                    <option value="">Tüm durumlar</option>
                    <option value="1" selected="@(Model.Status == DevelopmentRequestStatus.New ? "selected" : null)">Yeni</option>
                    <option value="2" selected="@(Model.Status == DevelopmentRequestStatus.InProgress ? "selected" : null)">İşlemde</option>
                    <option value="3" selected="@(Model.Status == DevelopmentRequestStatus.Completed ? "selected" : null)">Tamamlandı</option>
                </select>
            </div>
            <div class="col-lg-3">
                <button class="btn btn-primary mr-2"><i class="la la-search"></i> Filtrele</button>
                <a asp-action="Index" class="btn btn-light">Temizle</a>
            </div>
        </form>
    </div>
</div>

<div class="card card-custom">
    <div class="card-header"><div class="card-title"><h3 class="card-label">@(Model.IsAdmin ? "Tüm Talepler" : "Taleplerim") <span class="text-muted">(@Model.Requests.Count)</span></h3></div></div>
    <div class="card-body p-0">
        @if (Model.Requests.Count == 0)
        {
            <div class="request-empty"><i class="la la-clipboard-list icon-3x d-block mb-3"></i>Filtreye uygun geliştirme talebi bulunamadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover request-table mb-0">
                    <thead class="thead-light"><tr><th>Talep</th>@if (Model.IsAdmin) { <th>Talep Eden</th> }<th>Öncelik</th><th>Durum</th><th>Tarih</th><th class="text-right">İşlem</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Requests)
                    {
                        <tr>
                            <td><a asp-action="Detay" asp-route-id="@item.Id" class="request-title d-block">@item.Title</a><span class="text-muted font-size-sm">@item.RequestNumber</span></td>
                            @if (Model.IsAdmin) { <td>@item.OwnerName</td> }
                            <td><span class="font-weight-bold @PriorityClass(item.Priority)">@item.Priority.ToDisplayText()</span></td>
                            <td><span class="label @StatusClass(item.Status) label-inline font-weight-bold">@item.Status.ToDisplayText()</span></td>
                            <td><span class="d-block">@item.CreatedAt.ToString("dd.MM.yyyy")</span><span class="text-muted font-size-sm">@item.CreatedAt.ToString("HH:mm")</span></td>
                            <td class="text-right"><a asp-action="Detay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">İncele</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
