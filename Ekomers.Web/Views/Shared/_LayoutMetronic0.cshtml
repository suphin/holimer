	@if (useModernPortalTheme)
	{
		<script>
			(function () {
				var body = document.body;
				var toggle = document.getElementById('kt_aside_toggle');
				if (!body || !toggle) return;

				var storageKey = 'PortalModernAsideExpanded';
				var expanded = window.localStorage.getItem(storageKey) === 'true';
				var applyState = function () {
					body.classList.toggle('portal-modern-aside-expanded', expanded);
					body.classList.toggle('aside-minimize', !expanded);
					toggle.setAttribute('aria-expanded', expanded ? 'true' : 'false');
					toggle.setAttribute('aria-label', expanded ? 'Menüyü daralt' : 'Menüyü genişlet');
					toggle.title = expanded ? 'Menüyü daralt' : 'Menüyü genişlet';
				};

				applyState();
				toggle.addEventListener('click', function (event) {
					event.preventDefault();
					event.stopImmediatePropagation();
					expanded = !expanded;
					window.localStorage.setItem(storageKey, expanded ? 'true' : 'false');
					applyState();
				}, true);
			})();
		</script>
	}
	<script>
		(function () {
			var form = document.getElementById('portal-shortcut-form');
			var button = document.getElementById('portal-shortcut-toggle');
			if (!form || !button || !window.fetch) return;

			var icon = document.getElementById('portal-shortcut-icon');
			var label = document.getElementById('portal-shortcut-label');
			var pageUrl = form.getAttribute('data-page-url');
			var pageTitle = form.getAttribute('data-page-title');
			var tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');

			function applyState(isAdded) {
				button.classList.toggle('btn-light-primary', !isAdded);
				button.classList.toggle('btn-light-warning', isAdded);
				button.title = isAdded ? 'Bu sayfayı kısayollardan kaldır' : 'Bu sayfayı ana sayfaya ekle';
				if (icon) icon.textContent = isAdded ? '★' : '☆';
				if (label) label.textContent = isAdded ? 'Kısayoldan çıkar' : 'Kısayola ekle';
			}

			fetch('/UserActions/ShortcutStatus?url=' + encodeURIComponent(pageUrl), {
				headers: { 'X-Requested-With': 'XMLHttpRequest' }
			})
				.then(function (response) { return response.ok ? response.json() : null; })
				.then(function (result) { if (result) applyState(result.isAdded); })
				.catch(function () { });

			button.addEventListener('click', function () {
				button.disabled = true;
				var data = new URLSearchParams();
				data.append('url', pageUrl);
				data.append('title', pageTitle);
				if (tokenInput) data.append('__RequestVerificationToken', tokenInput.value);

				fetch('/UserActions/ShortcutToggle', {
					method: 'POST',
					headers: {
						'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
						'X-Requested-With': 'XMLHttpRequest'
					},
					body: data.toString()
				})
					.then(function (response) {
						if (response.ok) return response.json();
						return response.text().then(function (body) {
							var message = 'Kısayol işlemi tamamlanamadı (' + response.status + ').';
							if (response.status === 400) message = 'Kısayol bilgileri doğrulanamadı. Sayfayı yenileyip tekrar deneyin.';
							if (response.status === 401 || response.status === 403) message = 'Bu işlem için oturum veya yetki doğrulanamadı.';
							throw new Error(message);
						});
					})
					.then(function (result) { applyState(result.isAdded); })
					.catch(function (error) {
						if (label) label.textContent = error.message || 'Tekrar deneyin';
						button.title = error.message || 'Kısayol işlemi tamamlanamadı.';
					})
					.finally(function () { button.disabled = false; });
			});
		})();
	</script>
