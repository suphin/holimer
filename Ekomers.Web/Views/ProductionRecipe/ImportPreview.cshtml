@model Ekomers.Models.ViewModels.Production.ProductionRecipeImportPreviewVM
@{ ViewData["Title"] = "Reçete Aktarım Önizlemesi"; }
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Aktarım Önizlemesi</h3></div></div><div class="card-body"><div class="row"><div class="col-md-2"><strong>@Model.RecipeCount</strong><div>Reçete</div></div><div class="col-md-2"><strong>@Model.RowCount</strong><div>Kalem</div></div><div class="col-md-2"><strong>@Model.ComponentCount</strong><div>Bileşen</div></div><div class="col-md-3"><strong>@Model.MissingMaterialCount</strong><div>Açılacak kart</div></div><div class="col-md-3"><strong>@Model.ExistingRecipeCount</strong><div>Atlanacak reçete</div></div></div><hr />
@if(Model.MissingMaterialCodes.Count>0){<div class="alert alert-light-warning"><strong>Eksik kodlar:</strong> @string.Join(", ",Model.MissingMaterialCodes.Take(30))</div>}<div class="table-responsive"><table class="table table-sm"><thead><tr><th>Satır</th><th>Ana Ürün</th><th>Alt Malzeme</th><th>Miktar</th><th>Birim</th></tr></thead><tbody>@foreach(var row in Model.SampleRows){<tr><td>@row.RowNumber</td><td>@row.ProductCode - @row.ProductName</td><td>@row.ComponentCode - @row.ComponentName</td><td>@row.Quantity.ToString("0.######")</td><td>@row.UnitCode</td></tr>}</tbody></table></div></div><div class="card-footer"><form asp-action="ConfirmImport" method="post" class="d-inline"><button class="btn btn-success" type="submit">Onayla ve Oluştur</button></form> <a asp-action="Import" class="btn btn-light">Dosyayı Değiştir</a></div></div>
