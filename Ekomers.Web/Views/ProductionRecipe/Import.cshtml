@{ ViewData["Title"] = "Excel'den Reçete Aktar"; }
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Excel'den Reçete Aktar<span class="d-block text-muted pt-2 font-size-sm">Dosya önce kontrol edilir, onaydan sonra kaydedilir</span></h3></div></div><form asp-action="PreviewImport" method="post" enctype="multipart/form-data"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="form-group"><label>Reçete Excel Dosyası</label><input type="file" name="file" accept=".xlsx" class="form-control" /></div></div><div class="card-footer"><button class="btn btn-primary" type="submit">Kontrol Et ve Önizle</button> <a asp-action="Index" class="btn btn-light">Vazgeç</a></div></form></div>
