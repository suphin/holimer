@model Ekomers.Models.ViewModels.Production.ProductionRecipeDetailVM
@{ ViewData["Title"] = "Reçete Detayı"; }
<div class="card card-custom mb-5"><div class="card-header"><div class="card-title"><h3 class="card-label">@Model.Code<span class="d-block text-muted pt-2 font-size-sm">@Model.Product</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline">@Model.Status</span></div></div>
<form asp-action="UpdateVersion" method="post"><input type="hidden" name="RecipeVersionId" value="@Model.RecipeVersionId" /><div class="card-body"><div class="row">
<div class="col-md-4 form-group"><label>Reçete Adı</label><input name="Name" value="@Model.Name" class="form-control" @(Model.CanEdit?null:"readonly") /></div>
<div class="col-md-2 form-group"><label>Baz Miktar</label><input name="BaseQuantity" value="@Model.BaseQuantity.ToString(CultureInfo.InvariantCulture)" type="number" step="0.000001" min="0.000001" class="form-control" @(Model.CanEdit?null:"readonly") /></div>
<div class="col-md-2 form-group"><label>Birim</label><select name="UnitId" class="form-control" disabled="@(Model.CanEdit ? null : "disabled")">@foreach(var unit in Model.Units){if(unit.Value==Model.UnitId.ToString()){<option value="@unit.Value" selected>@unit.Text</option>}else{<option value="@unit.Value">@unit.Text</option>}}</select></div>
<div class="col-md-2 form-group"><label>Durum</label><select name="Status" class="form-control" disabled="@(Model.CanEdit ? null : "disabled")">@foreach(var status in Enum.GetValues<PrdRecipeStatus>()){if(status==Model.Status){<option value="@((int)status)" selected>@status</option>}else{<option value="@((int)status)">@status</option>}}</select></div>
<div class="col-md-2 form-group"><label>Başlangıç</label><input name="ValidFrom" value="@Model.ValidFrom?.ToString("yyyy-MM-dd")" type="date" class="form-control" readonly="@(Model.CanEdit ? null : "readonly")" /></div>
<div class="col-md-2 form-group"><label>Bitiş</label><input name="ValidTo" value="@Model.ValidTo?.ToString("yyyy-MM-dd")" type="date" class="form-control" readonly="@(Model.CanEdit ? null : "readonly")" /></div>
<div class="col-md-5 form-group"><label>Açıklama</label><input name="Description" value="@Model.Description" class="form-control" @(Model.CanEdit?null:"readonly") /></div><div class="col-md-5 form-group"><label>Versiyon Notu</label><input name="Notes" value="@Model.Notes" class="form-control" @(Model.CanEdit?null:"readonly") /></div>
</div></div>@if(Model.CanEdit){<div class="card-footer"><button class="btn btn-primary" type="submit">Reçete Bilgilerini Güncelle</button></div>}</form></div>

@if(Model.CanEdit){<div class="card card-custom mb-5"><div class="card-header"><div class="card-title"><h3 class="card-label">Yeni Malzeme Kalemi</h3></div></div><form asp-action="AddItem" method="post"><input type="hidden" name="RecipeVersionId" value="@Model.RecipeVersionId" /><div class="card-body"><div class="row">
<div class="col-md-5 form-group"><label>Malzeme</label><select name="MaterialId" asp-items="Model.Materials" class="form-control"><option value="">Malzeme seçiniz</option></select></div><div class="col-md-2 form-group"><label>Miktar</label><input name="Quantity" type="number" step="0.000001" min="0.000001" class="form-control" /></div><div class="col-md-2 form-group"><label>Birim</label><select name="UnitId" asp-items="Model.Units" class="form-control"></select></div><div class="col-md-2 form-group"><label>Planlanan Fire %</label><input name="PlannedWasteRate" type="number" step="0.01" min="0" max="100" value="0" class="form-control" /></div><div class="col-md-1 form-group"><label>Zorunlu</label><input type="hidden" name="IsRequired" value="false" /><input name="IsRequired" value="true" type="checkbox" checked class="form-control" /></div>
<div class="col-md-3 form-group"><label>Alternatif Grup</label><input name="AlternativeGroupCode" class="form-control" /></div><div class="col-md-7 form-group"><label>Not</label><input name="Notes" class="form-control" /></div><div class="col-md-2 form-group d-flex align-items-end"><button class="btn btn-success w-100" type="submit">Kalem Ekle</button></div>
</div></div></form></div>}

<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Reçete Malzemeleri <span class="text-muted">(@Model.Items.Count)</span></h3></div></div><div class="card-body">
@if(Model.Items.Count==0){<div class="alert alert-light-primary mb-0">Bu versiyonda malzeme kalemi yok.</div>}else{<div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>#</th><th>Malzeme</th><th>Tür</th><th>Miktar</th><th>Birim</th><th>Fire %</th><th>Zorunlu</th><th>Alternatif</th><th>İşlem</th></tr></thead><tbody>
@foreach(var item in Model.Items){var formId=$"item-form-{item.Id}";<tr><td>@item.Sequence</td><td><strong>@item.MaterialCode</strong><span class="d-block text-muted">@item.MaterialName</span></td><td>@item.MaterialType</td><td><input form="@formId" name="Quantity" value="@item.Quantity.ToString(CultureInfo.InvariantCulture)" type="number" step="0.000001" class="form-control form-control-sm" @(Model.CanEdit?null:"readonly") /></td><td><select form="@formId" name="UnitId" class="form-control form-control-sm" disabled="@(Model.CanEdit ? null : "disabled")">@foreach(var unit in Model.Units){if(unit.Value==item.UnitId.ToString()){<option value="@unit.Value" selected>@unit.Text</option>}else{<option value="@unit.Value">@unit.Text</option>}}</select></td><td><input form="@formId" name="PlannedWasteRate" value="@item.PlannedWasteRate.ToString(CultureInfo.InvariantCulture)" type="number" step="0.01" min="0" max="100" class="form-control form-control-sm" @(Model.CanEdit?null:"readonly") /></td><td><input form="@formId" type="hidden" name="IsRequired" value="false" />@if(item.IsRequired){<input form="@formId" name="IsRequired" value="true" type="checkbox" checked disabled="@(Model.CanEdit ? null : "disabled")" />}else{<input form="@formId" name="IsRequired" value="true" type="checkbox" disabled="@(Model.CanEdit ? null : "disabled")" />}</td><td><input form="@formId" name="AlternativeGroupCode" value="@item.AlternativeGroupCode" class="form-control form-control-sm" @(Model.CanEdit?null:"readonly") /></td><td>@if(Model.CanEdit){<form id="@formId" asp-action="UpdateItem" method="post" class="d-inline"><input type="hidden" name="RecipeVersionId" value="@Model.RecipeVersionId" /><input type="hidden" name="ItemId" value="@item.Id" /><input type="hidden" name="MaterialId" value="@item.MaterialId" /><button class="btn btn-sm btn-primary" type="submit">Güncelle</button></form><form asp-action="DeleteItem" method="post" class="d-inline" onsubmit="return confirm('Kalem silinsin mi?');"><input type="hidden" name="itemId" value="@item.Id" /><input type="hidden" name="recipeVersionId" value="@Model.RecipeVersionId" /><button class="btn btn-sm btn-light-danger" type="submit">Sil</button></form>}</td></tr>}
</tbody></table></div>}</div></div>
<div class="mt-4"><a asp-action="Index" class="btn btn-light">Reçete Listesine Dön</a></div>
