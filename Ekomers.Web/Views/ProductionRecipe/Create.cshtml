@model Ekomers.Models.ViewModels.Production.ProductionRecipeCreateVM
@{ ViewData["Title"] = "Yeni Üretim Reçetesi"; }
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Yeni Reçete<span class="d-block text-muted pt-2 font-size-sm">Prd reçete başlığı ve ilk versiyon</span></h3></div></div>
<form asp-action="Create" method="post"><div class="card-body"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row">
<div class="col-md-3 form-group"><label asp-for="Code"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div>
<div class="col-md-5 form-group"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
<div class="col-md-4 form-group"><label asp-for="ProductMaterialId"></label><select asp-for="ProductMaterialId" asp-items="Model.Products" class="form-control"><option value="">Ürün seçiniz</option></select><span asp-validation-for="ProductMaterialId" class="text-danger"></span></div>
<div class="col-md-2 form-group"><label asp-for="VersionNumber"></label><input asp-for="VersionNumber" class="form-control" /></div>
<div class="col-md-3 form-group"><label asp-for="BaseQuantity"></label><input asp-for="BaseQuantity" type="number" min="0.000001" step="0.000001" class="form-control" /><span asp-validation-for="BaseQuantity" class="text-danger"></span></div>
<div class="col-md-3 form-group"><label asp-for="UnitId"></label><select asp-for="UnitId" asp-items="Model.Units" class="form-control"><option value="">Birim seçiniz</option></select></div>
<div class="col-md-4 form-group"><label asp-for="Status"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<PrdRecipeStatus>()" class="form-control"></select></div>
<div class="col-md-3 form-group"><label asp-for="ValidFrom"></label><input asp-for="ValidFrom" class="form-control" /></div><div class="col-md-3 form-group"><label asp-for="ValidTo"></label><input asp-for="ValidTo" class="form-control" /></div>
<div class="col-md-6 form-group"><label asp-for="Description"></label><input asp-for="Description" class="form-control" /></div><div class="col-12 form-group"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control"></textarea></div>
</div></div><div class="card-footer"><button class="btn btn-primary" type="submit">Kaydet</button> <a asp-action="Index" class="btn btn-light">Vazgeç</a></div></form></div>
@section JSSection { <partial name="_ValidationScriptsPartial" /> }
