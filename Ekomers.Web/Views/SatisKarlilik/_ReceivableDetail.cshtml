@model Ekomers.Models.ViewModels.Profitability.CustomerReceivableDetailVM

<div class="mb-5">
    <div class="font-size-h5 font-weight-bold">@Model.CustomerCode</div>
    <div class="text-muted">@Model.CustomerName</div>
</div>

@if (!Model.IsAvailable)
{
    <div class="alert alert-light-warning mb-0">@Model.Message</div>
}
else if (Model.Movements.Count == 0)
{
    <div class="alert alert-light-success mb-0">Bu cari için açık ödeme hareketi bulunamadı.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <span class="text-muted">Açık hareket sayısı: @Model.Movements.Count</span>
        <span class="font-weight-bold">Net açık hareket: @Model.OpenBalance.ToString("N2") ₺</span>
    </div>
    <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
        <table class="table table-hover mb-0">
            <thead>
                <tr>
                    <th>Vade</th>
                    <th>İşlem</th>
                    <th>Logo Ref.</th>
                    <th class="text-right">Tutar</th>
                    <th class="text-right">Kapanan</th>
                    <th class="text-right">Açık</th>
                    <th>Durum</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var movement in Model.Movements)
            {
                <tr>
                    <td>@movement.DueDate.ToString("dd.MM.yyyy")</td>
                    <td>@movement.TransactionType</td>
                    <td>@movement.DocumentReference</td>
                    <td class="text-right">@movement.Total.ToString("N2")</td>
                    <td class="text-right">@movement.Paid.ToString("N2")</td>
                    <td class="text-right font-weight-bold">@movement.OpenAmount.ToString("N2")</td>
                    <td>
                        @if (movement.IsOverdue && movement.OpenAmount > 0)
                        {
                            <span class="label label-light-warning label-inline">Gecikmiş</span>
                        }
                        else
                        {
                            <span class="label label-light-primary label-inline">Açık</span>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
