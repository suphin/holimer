@model Ekomers.Models.ViewModels.Production.ProductionCatalogCreateVM
@{ ViewData["Title"] = "Yeni Malzeme"; }

<div class="card card-custom">
    <div class="card-header">
        <div class="card-title">
            <h3 class="card-label">
                Yeni Malzeme
                <span class="d-block text-muted pt-2 font-size-sm">Üretim malzeme kataloğuna portal kaynaklı yeni kart ekleyin</span>
            </h3>
        </div>
    </div>
    <form asp-action="Create" method="post">
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-4"></div>
            <div class="row">
                <div class="col-md-4 form-group">
                    <label asp-for="Code"></label>
                    <input asp-for="Code" class="form-control text-uppercase" maxlength="100" autocomplete="off" placeholder="Örn. 150HM.01.01.001" />
                    <span asp-validation-for="Code" class="text-danger"></span>
                </div>
                <div class="col-md-8 form-group">
                    <label asp-for="Name"></label>
                    <input asp-for="Name" class="form-control" maxlength="250" autocomplete="off" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-group">
                    <label asp-for="Type"></label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<PrdMaterialType>()" class="form-control"></select>
                    <span asp-validation-for="Type" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-group">
                    <label asp-for="UnitId"></label>
                    <select asp-for="UnitId" asp-items="Model.Units" class="form-control"></select>
                    <span asp-validation-for="UnitId" class="text-danger"></span>
                </div>
                <div class="col-md-4 form-group">
                    <label asp-for="CriticalQuantity"></label>
                    <input asp-for="CriticalQuantity" class="form-control" inputmode="decimal" placeholder="Örn. 10,5" />
                    <span asp-validation-for="CriticalQuantity" class="text-danger"></span>
                </div>
                <div class="col-md-6 form-group">
                    <label asp-for="QualityControlRequirement"></label>
                    <select asp-for="QualityControlRequirement" asp-items="Html.GetEnumSelectList<PrdQualityControlRequirement>()" class="form-control"></select>
                </div>
                <div class="col-12 form-group">
                    <label asp-for="Description"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="col-md-4 form-group d-flex align-items-center">
                    <label class="checkbox mt-6"><input asp-for="RequiresLotTracking" /><span></span>Lot takibi zorunlu</label>
                </div>
                <div class="col-md-4 form-group d-flex align-items-center">
                    <label class="checkbox mt-6"><input asp-for="RequiresExpirationDate" /><span></span>Son kullanma tarihi zorunlu</label>
                </div>
            </div>
            <div class="alert alert-light-info mb-0">
                Kart portal kaynağıyla oluşturulur ve fiziksel stok üretmez. Stok, depo girişleri ve diğer stok hareketleriyle ayrıca oluşur.
            </div>
        </div>
        <div class="card-footer">
            <button type="submit" class="btn btn-primary">Malzemeyi Kaydet</button>
            <a asp-action="Index" class="btn btn-light ml-2">Vazgeç</a>
        </div>
    </form>
</div>
