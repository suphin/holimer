@model Ekomers.Models.ViewModels.Production.ProductionCatalogIndexVM
@{ ViewData["Title"] = "Üretim Malzeme Kataloğu"; var firstPage=Math.Max(1,Model.Page-2);var lastPage=Math.Min(Model.TotalPages,Model.Page+2); }
<div class="card card-custom"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Üretim Malzeme Kataloğu<span class="d-block text-muted pt-2 font-size-sm">Logo kartları ve portal hızlı kodları · @Model.TotalCount kayıt</span></h3></div>
<div class="card-toolbar"><form asp-action="Sync" method="post"><button type="submit" class="btn btn-primary">Logo ve Portal Kartlarını Güncelle</button></form></div></div>
<div class="card-body">
<form asp-action="Index" method="get" class="mb-6"><div class="row"><div class="col-md-7"><label>Kod veya malzeme adı</label><div class="input-group"><input name="search" value="@Model.Search" class="form-control" placeholder="Malzeme kodu ya da adıyla arayın..."/><div class="input-group-append"><button class="btn btn-primary" type="submit">Ara</button>@if(!string.IsNullOrWhiteSpace(Model.Search)){<a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="btn btn-light">Temizle</a>}</div></div></div><div class="col-md-2"><label>Sayfa boyutu</label><select name="pageSize" class="form-control" onchange="this.form.submit()">@foreach(var size in new[]{25,50,100}){if(size==Model.PageSize){<option value="@size" selected>@size kayıt</option>}else{<option value="@size">@size kayıt</option>}}</select></div></div></form>
@if (Model.Items.Count == 0) { <div class="alert alert-light-primary">@(string.IsNullOrWhiteSpace(Model.Search) ? "Katalog boş. Güncelle düğmesiyle ilk aktarımı başlatabilirsiniz." : "Arama ölçütüne uygun malzeme bulunamadı.")</div> }
else { <div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Kod</th><th>Malzeme</th><th>Kaynak</th><th>Tür</th><th>Birim</th><th>Portal</th><th>Logo</th><th>Son Güncelleme</th><th>İşlem</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr class="@(item.IsActive ? "" : "text-muted")"><td><strong>@item.Code</strong></td><td>@item.Name</td><td>@item.Source.ToTurkish()</td><td>@item.Type.ToTurkish()</td><td>@item.Unit</td><td><span class="label @(item.IsActive ? "label-light-success" : "label-light-danger") label-inline">@(item.IsActive ? "Aktif" : "Pasif")</span></td><td>@(item.Source == PrdMaterialSource.Logo ? (item.LogoActive ? "Aktif" : "Pasif") : "-")</td><td>@item.LogoLastSyncDate?.ToString("dd.MM.yyyy HH:mm")</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary mr-1">Düzenle</a><a asp-controller="SpesifikasyonYonetimi" asp-action="Detay" asp-route-materialId="@item.Id" class="btn btn-sm btn-light-info mr-1">Spekler</a><form asp-action="ToggleStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id"/><button class="btn btn-sm @(item.IsActive ? "btn-light-danger" : "btn-light-success")" type="submit">@(item.IsActive ? "Pasife Al" : "Aktifleştir")</button></form></td></tr> }
</tbody></table></div>
<div class="d-flex flex-wrap justify-content-between align-items-center mt-5"><span class="text-muted">Toplam @Model.TotalCount kayıt · Sayfa @Model.Page / @Model.TotalPages</span><ul class="pagination mb-0"><li class="page-item @(Model.Page==1?"disabled":"")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-pageSize="@Model.PageSize" asp-route-page="@(Model.Page-1)">Önceki</a></li>@for(var p=firstPage;p<=lastPage;p++){<li class="page-item @(p==Model.Page?"active":"")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-pageSize="@Model.PageSize" asp-route-page="@p">@p</a></li>}<li class="page-item @(Model.Page==Model.TotalPages?"disabled":"")"><a class="page-link" asp-action="Index" asp-route-search="@Model.Search" asp-route-pageSize="@Model.PageSize" asp-route-page="@(Model.Page+1)">Sonraki</a></li></ul></div> }
</div></div>
