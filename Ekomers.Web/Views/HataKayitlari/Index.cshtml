@model Ekomers.Models.ViewModels.SystemErrorLogListVM
@{
    ViewData["Title"] = "Hata Kayıtları";
    var firstPage = Math.Max(1, Model.Page - 2);
    var lastPage = Math.Min(Model.TotalPages, Model.Page + 2);
}

<div class="card card-custom gutter-b">
    <div class="card-header">
        <div class="card-title">
            <div>
                <h3 class="card-label mb-1">Hata Kayıtları</h3>
                <span class="text-muted">Takip numarasıyla kaydedilmiş sistem hatalarını inceleyin.</span>
            </div>
        </div>
        <div class="card-toolbar"><span class="label label-light-primary label-inline">Yalnızca Admin</span></div>
    </div>
    <div class="card-body">
        <form method="get" asp-action="Index">
            <div class="row align-items-end">
                <div class="col-lg-5 mb-3">
                    <label class="form-label font-weight-bold">Takip numarası</label>
                    <input name="trackingNumber" value="@Model.TrackingNumber" class="form-control" placeholder="Örn. 40000055-0001-fb00-b63f-84710c7967bb" autofocus />
                    <span class="form-text text-muted">Tam numarayı veya numaranın bir bölümünü yazabilirsiniz.</span>
                </div>
                <div class="col-lg-3 mb-3">
                    <label class="form-label">Genel arama</label>
                    <input name="search" value="@Model.Search" class="form-control" placeholder="Mesaj, kullanıcı, sayfa..." />
                </div>
                <div class="col-sm-6 col-lg-2 mb-3">
                    <label class="form-label">Başlangıç</label>
                    <input type="date" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="col-sm-6 col-lg-2 mb-3">
                    <label class="form-label">Bitiş</label>
                    <input type="date" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
            </div>
            <div class="d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-light mr-2">Temizle</a>
                <button type="submit" class="btn btn-primary">Kayıtlarda Ara</button>
            </div>
        </form>
        <div class="alert alert-light-info mt-5 mb-0">
            Bu ekran yalnızca hata kayıt altyapısı devreye alındıktan sonra oluşan hataları gösterir; eski takip numaraları geriye dönük getirilemez.
        </div>
    </div>
</div>

<div class="card card-custom gutter-b">
    <div class="card-header">
        <div class="card-title"><h3 class="card-label">Kayıtlar <span class="text-muted">(@Model.TotalCount)</span></h3></div>
    </div>
    <div class="card-body p-0">
        @if (Model.Rows.Count == 0)
        {
            <div class="p-8 text-center text-muted">Arama ölçütlerine uygun hata kaydı bulunamadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th class="pl-6">Tarih</th><th>Takip numarası</th><th>İstek</th><th>Hata</th><th>Kullanıcı</th><th class="text-right pr-6">İşlem</th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="pl-6 text-nowrap">@row.OccurredAt.ToString("dd.MM.yyyy HH:mm:ss")</td>
                            <td><code class="text-dark">@row.TrackingNumber</code></td>
                            <td><span class="label label-light label-inline mr-1">@row.HttpMethod</span><span>@row.RequestPath</span></td>
                            <td style="min-width:280px">
                                <div class="font-weight-bold">@row.ExceptionType.Split('.').Last()</div>
                                <div class="text-muted text-truncate" style="max-width:460px" title="@row.Message">@row.Message</div>
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(row.UserName) ? "-" : row.UserName)</td>
                            <td class="text-right pr-6"><a asp-action="Details" asp-route-id="@row.Id" class="btn btn-sm btn-light-primary">Detay</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <span class="text-muted">Sayfa @Model.Page / @Model.TotalPages</span>
            <div>
            @for (var pageNumber = firstPage; pageNumber <= lastPage; pageNumber++)
            {
                <a asp-action="Index" asp-route-page="@pageNumber" asp-route-trackingNumber="@Model.TrackingNumber" asp-route-search="@Model.Search"
                   asp-route-startDate="@Model.StartDate?.ToString("yyyy-MM-dd")" asp-route-endDate="@Model.EndDate?.ToString("yyyy-MM-dd")"
                   class="btn btn-sm @(pageNumber == Model.Page ? "btn-primary" : "btn-light") mr-1">@pageNumber</a>
            }
            </div>
        </div>
    }
</div>
