@model Ekomers.Models.ViewModels.Production.ProductionOrderPlanningPoolVM
@{ ViewData["Title"]="Sipariş Planlama Havuzu"; }
<div class="card card-custom"><div class="card-header flex-wrap"><div class="card-title"><h3 class="card-label">Sipariş Planlama Havuzu <small class="d-block text-muted pt-2">Teslim tarihi yaklaşan siparişlerden üretim planı oluşturun</small></h3></div><div class="card-toolbar"><a asp-action="Index" class="btn btn-light mr-2">Siparişlere Dön</a><a asp-controller="UretimYonetimi" asp-action="Planlama" class="btn btn-light-primary">Mevcut Planlama Listesi</a></div></div><div class="card-body">
<form method="get" class="row mb-6"><div class="col-lg-8"><input name="search" value="@Model.Search" class="form-control" placeholder="Sipariş, müşteri veya ürün ara..."/></div><div class="col-lg-4"><button class="btn btn-primary mr-2">Ara</button><a asp-action="PlanlamaHavuzu" class="btn btn-light">Temizle</a></div></form>
@if(Model.Lines.Count==0){<div class="alert alert-light-primary">Planlama bekleyen ve aktif reçetesi bulunan sipariş satırı yok.</div>}else{
<form asp-action="PlanlamayaAktar" method="post"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th style="width:45px"><input type="checkbox" id="selectAll"/></th><th>Sipariş / Müşteri</th><th>Ürün</th><th>Teslim</th><th>Mamul Stok</th><th>Sipariş</th><th>Planlanan</th><th>Kalan</th><th style="min-width:160px">Planlanacak</th></tr></thead><tbody>
@for(var i=0;i<Model.Lines.Count;i++){var row=Model.Lines[i];<tr><td><input type="hidden" name="Lines[@i].OrderLineId" value="@row.OrderLineId"/><input type="checkbox" name="Lines[@i].Selected" value="true" class="row-select"/></td><td><a asp-action="Detay" asp-route-id="@row.OrderId"><strong>@row.OrderNumber</strong></a><span class="d-block text-muted">@row.CustomerName · @row.Priority.ToTurkish()</span></td><td><strong>@row.ProductCode</strong><span class="d-block text-muted">@row.ProductName</span></td><td>@row.RequestedDeliveryDate.ToString("dd.MM.yyyy")</td><td>@row.CurrentFinishedStock.ToString("0.######") @row.Unit</td><td>@row.OrderedQuantity.ToString("0.######") @row.Unit</td><td>@row.PlannedQuantity.ToString("0.######") @row.Unit</td><td><strong class="text-warning">@row.RemainingQuantity.ToString("0.######") @row.Unit</strong></td><td><div class="input-group"><input name="Lines[@i].Quantity" value="@row.RemainingQuantity.ToString("0.######",CultureInfo.InvariantCulture)" type="number" min="0.000001" max="@row.RemainingQuantity.ToString("0.######",CultureInfo.InvariantCulture)" step="0.000001" class="form-control"/><div class="input-group-append"><span class="input-group-text">@row.Unit</span></div></div></td></tr>}
</tbody></table></div><div class="d-flex justify-content-end mt-5"><button class="btn btn-success btn-lg" onclick="return confirm('Seçilen miktarlar mevcut üretim planlama listesine aktarılsın mı?');"><i class="la la-arrow-right"></i> Seçilenleri Planlamaya Aktar</button></div></form>}
</div></div>
@section JSSection{<script>document.getElementById('selectAll')?.addEventListener('change',function(){document.querySelectorAll('.row-select').forEach(x=>x.checked=this.checked);});</script>}
