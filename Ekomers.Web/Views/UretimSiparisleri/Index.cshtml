@model List<Ekomers.Models.ViewModels.Production.ProductionCustomerOrderListVM>
@{ ViewData["Title"]="Gelen Siparişler"; var selectedStatus=(PrdCustomerOrderStatus?)ViewBag.Status; }
<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0"><div class="card-title"><h3 class="card-label">Gelen Siparişler <small class="d-block text-muted pt-2">Üretime alınacak müşteri ve kanal siparişleri</small></h3></div><div class="card-toolbar">
        @if(User.IsInRole("Admin")||User.HasClaim("Modul","Uretim")||User.HasClaim("Authorize","UretimSiparisPlanla")){<a asp-action="PlanlamaHavuzu" class="btn btn-light-primary mr-2"><i class="la la-layer-group"></i> Planlama Havuzu</a>}
        @if(User.IsInRole("Admin")||User.HasClaim("Modul","Uretim")||User.HasClaim("Authorize","UretimSiparisOlustur")){<a asp-action="Yeni" class="btn btn-primary"><i class="la la-plus"></i> Yeni Sipariş</a>}
    </div></div>
    <div class="card-body">
        <form method="get" class="row mb-6"><div class="col-lg-6 mb-3"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Sipariş no, müşteri kodu veya adı..."/></div><div class="col-lg-3 mb-3"><select name="status" class="form-control"><option value="">Tüm durumlar</option>@foreach(var value in Enum.GetValues<PrdCustomerOrderStatus>()){if(selectedStatus==value){<option value="@((int)value)" selected>@value.ToTurkish()</option>}else{<option value="@((int)value)">@value.ToTurkish()</option>}}</select></div><div class="col-lg-3"><button class="btn btn-primary mr-2">Filtrele</button><a asp-action="Index" class="btn btn-light">Temizle</a></div></form>
        @if(Model.Count==0){<div class="alert alert-light-primary">Filtreye uygun sipariş bulunamadı.</div>}else{
        <div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Sipariş</th><th>Müşteri / Kanal</th><th>Tarih</th><th>Teslim</th><th>Öncelik</th><th>İlerleme</th><th>Durum</th><th></th></tr></thead><tbody>
        @foreach(var row in Model){var percent=row.OrderedQuantity<=0?0:Math.Min(100,row.PlannedQuantity/row.OrderedQuantity*100);<tr><td><strong>@row.OrderNumber</strong>@if(!string.IsNullOrWhiteSpace(row.ExternalOrderNumber)){<span class="d-block text-muted">@row.ExternalOrderNumber</span>}</td><td>@row.CustomerName<span class="d-block text-muted">@row.LineCount ürün</span></td><td>@row.OrderDate.ToString("dd.MM.yyyy")</td><td>@row.RequestedDeliveryDate.ToString("dd.MM.yyyy")</td><td>@row.Priority.ToTurkish()</td><td><strong>@row.PlannedQuantity.ToString("0.######") / @row.OrderedQuantity.ToString("0.######")</strong><div class="progress mt-2" style="height:5px"><div class="progress-bar" style="width:@percent.ToString("0.##",CultureInfo.InvariantCulture)%"></div></div></td><td><span class="label label-light-primary label-inline">@row.Status.ToTurkish()</span></td><td><a asp-action="Detay" asp-route-id="@row.Id" class="btn btn-sm btn-light-primary">Detay</a></td></tr>}
        </tbody></table></div>}
    </div>
</div>
