@model Ekomers.Models.ViewModels.Production.ProductionCustomerOrderFormVM
@{ var isEdit=Model.Id.HasValue; ViewData["Title"]=isEdit?"Sipariş Düzenle":"Yeni Sipariş"; var action=isEdit?"Duzenle":"Yeni"; if(Model.Lines.Count==0)Model.Lines.Add(new()); }
<form asp-action="@action" method="post" id="orderForm">
    <input asp-for="Id" type="hidden"/>
    <div class="card card-custom mb-6"><div class="card-header"><div class="card-title"><h3 class="card-label">@(isEdit?$"{Model.OrderNumber} Siparişini Düzenle":"Yeni Üretim Siparişi")</h3></div><div class="card-toolbar"><a asp-action="Index" class="btn btn-light mr-2">Listeye Dön</a><button class="btn btn-primary">Siparişi Kaydet</button></div></div>
    <div class="card-body"><div asp-validation-summary="All" class="text-danger mb-4"></div><div class="row">
        <div class="col-lg-3 form-group"><label asp-for="ExternalOrderNumber"></label><input asp-for="ExternalOrderNumber" class="form-control"/></div>
        <div class="col-lg-3 form-group"><label asp-for="CustomerCode"></label><input asp-for="CustomerCode" class="form-control"/></div>
        <div class="col-lg-6 form-group"><label asp-for="CustomerName"></label><input asp-for="CustomerName" class="form-control" required/></div>
        <div class="col-lg-3 form-group"><label asp-for="OrderDate"></label><input asp-for="OrderDate" type="date" class="form-control"/></div>
        <div class="col-lg-3 form-group"><label asp-for="RequestedDeliveryDate"></label><input asp-for="RequestedDeliveryDate" type="date" class="form-control"/></div>
        <div class="col-lg-3 form-group"><label>Öncelik</label><select asp-for="Priority" asp-items="Html.GetEnumSelectList<PrdCustomerOrderPriority>()" class="form-control"></select></div>
        <div class="col-lg-12 form-group"><label>Not</label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div>
    </div></div></div>
    <div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Sipariş Kalemleri</h3></div><div class="card-toolbar"><button type="button" id="addLine" class="btn btn-light-primary"><i class="la la-plus"></i> Satır Ekle</button></div></div><div class="card-body"><div id="orderLines">
        @for(var i=0;i<Model.Lines.Count;i++){
        <div class="order-line border rounded p-4 mb-4"><input type="hidden" name="Lines[@i].Id" value="@Model.Lines[i].Id"/><div class="row align-items-end">
            <div class="col-lg-5 form-group"><label>Ürün</label><select name="Lines[@i].ProductMaterialId" class="form-control product-select" required><option value="">Ürün seçiniz</option>@foreach(var product in Model.Products){if(product.Value==Model.Lines[i].ProductMaterialId.ToString()){<option value="@product.Value" selected>@product.Text</option>}else{<option value="@product.Value">@product.Text</option>}}</select></div>
            <div class="col-lg-2 form-group"><label>Miktar</label><input name="Lines[@i].Quantity" value="@Model.Lines[i].Quantity.ToString("0.######",CultureInfo.InvariantCulture)" type="number" min="0.000001" step="0.000001" class="form-control" required/></div>
            <div class="col-lg-2 form-group"><label>Satır teslim tarihi</label><input name="Lines[@i].RequestedDeliveryDate" value="@Model.Lines[i].RequestedDeliveryDate?.ToString("yyyy-MM-dd")" type="date" class="form-control"/></div>
            <div class="col-lg-2 form-group"><label>Satır notu</label><input name="Lines[@i].Notes" value="@Model.Lines[i].Notes" class="form-control"/></div>
            <div class="col-lg-1 form-group"><button type="button" class="btn btn-light-danger remove-line" title="Satırı kaldır"><i class="la la-trash"></i></button></div>
        </div></div>}
    </div><div class="text-muted">Aktif mamul kartları ve reçetesi bulunan ürünler listelenir. Aktif reçete uygunluğu üretim planına aktarılırken kontrol edilir.</div></div></div>
</form>
@section Scripts{
<script>
(function(){
 const host=document.getElementById('orderLines');
 function reindex(){host.querySelectorAll('.order-line').forEach((row,i)=>row.querySelectorAll('[name]').forEach(el=>el.name=el.name.replace(/Lines\[\d+\]/,'Lines['+i+']')));}
 function enhance(row){if(window.jQuery&&jQuery.fn.select2){jQuery(row).find('.product-select').select2({width:'100%',placeholder:'Ürün seçiniz'});}row.querySelector('.remove-line').addEventListener('click',()=>{if(host.children.length>1){if(window.jQuery&&jQuery.fn.select2)jQuery(row).find('.product-select').select2('destroy');row.remove();reindex();}});}
 host.querySelectorAll('.order-line').forEach(enhance);
 document.getElementById('addLine').addEventListener('click',()=>{const source=host.querySelector('.order-line');if(window.jQuery&&jQuery.fn.select2)jQuery(source).find('.product-select').select2('destroy');const row=source.cloneNode(true);if(window.jQuery&&jQuery.fn.select2)jQuery(source).find('.product-select').select2({width:'100%',placeholder:'Ürün seçiniz'});row.querySelectorAll('input').forEach(el=>el.value='');row.querySelector('select').value='';host.appendChild(row);reindex();enhance(row);});
})();
</script>}
