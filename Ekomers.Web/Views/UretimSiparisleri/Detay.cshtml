@model Ekomers.Models.ViewModels.Production.ProductionCustomerOrderDetailVM
@{ ViewData["Title"]="Sipariş Detayı"; }
<div class="card card-custom mb-6"><div class="card-header"><div class="card-title"><h3 class="card-label">@Model.OrderNumber <small class="d-block text-muted pt-2">@Model.CustomerName</small></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline mr-3">@Model.Status.ToTurkish()</span><a asp-action="Index" class="btn btn-light">Listeye Dön</a></div></div><div class="card-body"><div class="row"><div class="col-lg-2"><span class="text-muted">Harici no</span><strong class="d-block">@(Model.ExternalOrderNumber??"-")</strong></div><div class="col-lg-2"><span class="text-muted">Müşteri kodu</span><strong class="d-block">@(Model.CustomerCode??"-")</strong></div><div class="col-lg-2"><span class="text-muted">Sipariş</span><strong class="d-block">@Model.OrderDate.ToString("dd.MM.yyyy")</strong></div><div class="col-lg-2"><span class="text-muted">Teslim</span><strong class="d-block">@Model.RequestedDeliveryDate.ToString("dd.MM.yyyy")</strong></div><div class="col-lg-2"><span class="text-muted">Öncelik</span><strong class="d-block">@Model.Priority.ToTurkish()</strong></div><div class="col-lg-12 mt-4"><span class="text-muted">Not</span><div>@(Model.Notes??"-")</div></div></div></div>
<div class="card-footer d-flex flex-wrap">
@if(Model.Status==PrdCustomerOrderStatus.Draft&&(User.IsInRole("Admin")||User.HasClaim("Modul","Uretim")||User.HasClaim("Authorize","UretimSiparisDuzenle"))){<a asp-action="Duzenle" asp-route-id="@Model.Id" class="btn btn-light-primary mr-2">Düzenle</a>}
@if(Model.Status==PrdCustomerOrderStatus.Draft&&(User.IsInRole("Admin")||User.HasClaim("Authorize","UretimSiparisOnayla"))){<form asp-action="PlanlamayaHazirla" method="post" class="mr-2" onsubmit="return confirm('Sipariş üretim planlama havuzuna gönderilsin mi?');"><input type="hidden" name="id" value="@Model.Id"/><button class="btn btn-success">Planlamaya Hazırla</button></form>}
@if((Model.Status==PrdCustomerOrderStatus.ReadyForPlanning||Model.Status==PrdCustomerOrderStatus.PartiallyPlanned)&&(User.IsInRole("Admin")||User.HasClaim("Modul","Uretim")||User.HasClaim("Authorize","UretimSiparisPlanla"))){<a asp-action="PlanlamaHavuzu" class="btn btn-primary mr-2">Planlama Havuzunu Aç</a>}
@if(Model.Status!=PrdCustomerOrderStatus.Cancelled&&(User.IsInRole("Admin")||User.HasClaim("Authorize","UretimSiparisIptal"))){<form asp-action="Iptal" method="post" class="d-flex"><input type="hidden" name="id" value="@Model.Id"/><input name="reason" class="form-control mr-2" minlength="5" placeholder="İptal nedeni" required/><button class="btn btn-danger text-nowrap" onclick="return confirm('Sipariş iptal edilsin mi?');">İptal Et</button></form>}
</div></div>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Sipariş Kalemleri (@Model.Lines.Count)</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Ürün</th><th>Sipariş</th><th>Planlanan</th><th>Kalan</th><th>Teslim</th><th>Not</th></tr></thead><tbody>@foreach(var line in Model.Lines){<tr><td><strong>@line.ProductCode</strong><span class="d-block text-muted">@line.ProductName</span></td><td>@line.OrderedQuantity.ToString("0.######") @line.Unit</td><td>@line.PlannedQuantity.ToString("0.######") @line.Unit</td><td class="@(line.RemainingQuantity>0?"text-warning":"text-success")"><strong>@line.RemainingQuantity.ToString("0.######") @line.Unit</strong></td><td>@(line.RequestedDeliveryDate?.ToString("dd.MM.yyyy")??Model.RequestedDeliveryDate.ToString("dd.MM.yyyy"))</td><td>@(line.Notes??"-")</td></tr>}</tbody></table></div></div></div>
