@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.PriceRequestEmailListVM>
@using Ekomers.Models.Enums
@{
    ViewData["Title"] = "Fiyat İstekleri";
    var canManage = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaTeklifYonet");
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title"><h3 class="card-label">Fiyat İstekleri<span class="d-block text-muted pt-2 font-size-sm">Tedarikçilere gönderilen fiyat talebi e-postaları</span></h3></div>
        <div class="card-toolbar">
            @if (canManage)
            {
                <a asp-action="MailTaslaklari" class="btn btn-light-primary mr-2">E-posta Taslakları</a>
            }
            <a asp-action="TeklifTalepleri" class="btn btn-primary">Yeni Fiyat İsteği</a>
        </div>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">Henüz fiyat isteği gönderilmedi.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-separate table-head-custom">
                    <thead><tr><th>Referans</th><th>Tedarikçi / Alıcı</th><th>Konu</th><th>Kalem</th><th>Son Tarih</th><th>Durum</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var statusClass = item.Status == PurPriceRequestEmailStatus.Sent ? "label-light-success" : item.Status == PurPriceRequestEmailStatus.Failed ? "label-light-danger" : "label-light-warning";
                            var statusText = item.Status == PurPriceRequestEmailStatus.Sent ? "Gönderildi" : item.Status == PurPriceRequestEmailStatus.Failed ? "Gönderilemedi" : "Taslak";
                            <tr>
                                <td><strong>@item.ReferenceNumber</strong><span class="d-block text-muted">@(item.SentDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</span></td>
                                <td>@item.SupplierName<span class="d-block text-muted">@item.RecipientEmail</span></td>
                                <td>@item.Subject<span class="d-block text-muted">Gönderen: @item.SenderName</span></td>
                                <td>@item.LineCount</td>
                                <td>@(item.ResponseDeadline?.ToString("dd.MM.yyyy") ?? "-")</td>
                                <td><span class="label label-lg @statusClass label-inline">@statusText</span>@if (!string.IsNullOrWhiteSpace(item.ErrorMessage)) { <span class="d-block text-danger small mt-1">@item.ErrorMessage</span> }</td>
                                <td class="text-right"><a asp-action="FiyatIstegiDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
