@model Ekomers.Models.ViewModels.Purchasing.GoodsReceiptDetailVM
@{
    ViewData["Title"] = "Mal Kabul Detayı";
    var canDelete = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaKayitSil");
    var canUndo = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaSurecGeriAl");
    var canEdit = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaMalKabulYonet");
    var canQuarantine = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaKarantinaIsle");
    var canAllocateCost = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaEkMaliyetDagit");
    var pendingLines = Model.Lines.Where(x => !x.IsStockPosted).ToList();
    var missingLot = pendingLines.Where(x => x.LotRequired && string.IsNullOrWhiteSpace(x.LotNumber)).ToList();
    var missingExpiration = pendingLines.Where(x => x.ExpirationDateRequired && !x.ExpirationDate.HasValue).ToList();
    var needsDirect = pendingLines.Any(x => x.QualityControlRequirement != Ekomers.Models.Enums.PrdQualityControlRequirement.Required);
    var needsQuarantine = pendingLines.Any(x => x.QualityControlRequirement == Ekomers.Models.Enums.PrdQualityControlRequirement.Required);
}

<div class="card card-custom mb-5">
    <div class="card-header flex-wrap py-3">
        <div class="card-title"><h3 class="card-label">@Model.ReceiptNumber<span class="d-block text-muted pt-2 font-size-sm">@Model.OrderNumber · @Model.SupplierCode - @Model.SupplierName</span></h3></div>
        <div class="card-toolbar">
            <span class="label label-light-primary label-inline mr-2">@Model.Status.ToTurkish()</span>
            @if (Model.Status == Ekomers.Models.Enums.PurGoodsReceiptStatus.Recorded && Model.DirectStockDocuments.Count == 0 && !Model.QuarantineInventoryDocumentId.HasValue)
            {
                @if (canEdit) { <a asp-action="MalKabulDuzenle" asp-route-id="@Model.Id" class="btn btn-sm btn-light-primary mr-2">Düzenle</a> }
                @if (canDelete) { <form asp-action="MalKabulSil" method="post" class="d-inline mr-2" onsubmit="return confirm('Mal kabul silinecek ve sipariş teslim miktarları yeniden hesaplanacak. Devam edilsin mi?');"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-sm btn-light-danger">Sil</button></form> }
            }
            <a asp-action="SiparisDetay" asp-route-id="@Model.PurchaseOrderId" class="btn btn-sm btn-light">Siparişe Dön</a>
        </div>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-2"><strong>Mal Kabul Tarihi</strong><div>@Model.ReceiptDate.ToString("dd.MM.yyyy")</div></div>
            <div class="col-md-2"><strong>İrsaliye</strong><div>@Model.DispatchNumber</div><small class="text-muted">@(Model.DispatchDate?.ToString("dd.MM.yyyy") ?? "Tarih yok")</small></div>
            <div class="col-md-2"><strong>Fatura</strong><div>@(Model.InvoiceNumber ?? "-")</div><small class="text-muted">@(Model.InvoiceDate?.ToString("dd.MM.yyyy") ?? "-")</small></div>
            <div class="col-md-2"><strong>Nakliye Firması</strong><div>@(Model.CarrierName ?? "-")</div></div>
            <div class="col-md-2"><strong>Araç / Takip</strong><div>@(Model.VehiclePlate ?? "-")</div><small class="text-muted">@(Model.TrackingNumber ?? "-")</small></div>
            <div class="col-md-2"><strong>Not</strong><div>@(Model.Notes ?? "-")</div></div>
        </div>
    </div>
</div>

@if (pendingLines.Count > 0 && Model.Status != Ekomers.Models.Enums.PurGoodsReceiptStatus.Cancelled)
{
    <div class="card card-custom mb-5">
        <div class="card-header"><div class="card-title"><h3 class="card-label">Stok Girişi<span class="d-block text-muted pt-2 font-size-sm">Malzemenin kalite kontrol gerekliliğine göre doğrudan stok veya karantina girişi</span></h3></div></div>
        <div class="card-body">
            @if (missingLot.Count > 0 || missingExpiration.Count > 0)
            {
                <div class="alert alert-light-danger">
                    Stok girişi öncesinde eksik izlenebilirlik bilgilerini tamamlayınız.
                    @if (missingLot.Count > 0) { <span class="d-block">Lot eksik: @string.Join(", ", missingLot.Select(x => x.MaterialCode))</span> }
                    @if (missingExpiration.Count > 0) { <span class="d-block">SKT eksik: @string.Join(", ", missingExpiration.Select(x => x.MaterialCode))</span> }
                    @if (canEdit) { <a asp-action="MalKabulDuzenle" asp-route-id="@Model.Id" class="btn btn-sm btn-light-danger mt-3">Mal Kabulü Düzenle</a> }
                </div>
            }
            else
            {
                @if (canQuarantine) { <form asp-action="StokGirisiniTamamla" method="post" id="receipt-stock-form">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="table-responsive mb-5"><table class="table table-separate table-head-custom">
                        <thead><tr><th>Malzeme</th><th>Miktar</th><th>Kalite Kontrol</th><th>İşlem</th></tr></thead>
                        <tbody>
                        @for (var i = 0; i < pendingLines.Count; i++)
                        {
                            var line = pendingLines[i];
                            <tr>
                                <td><input type="hidden" name="Lines[@i].ReceiptLineId" value="@line.Id" /><strong>@line.MaterialCode</strong><span class="d-block text-muted">@line.MaterialName</span></td>
                                <td>@line.ReceivedQuantity.ToString("0.######") @line.Unit</td>
                                <td>@(line.QualityControlRequirement == Ekomers.Models.Enums.PrdQualityControlRequirement.Required ? "Zorunlu" : line.QualityControlRequirement == Ekomers.Models.Enums.PrdQualityControlRequirement.Optional ? "İsteğe bağlı" : "Gerekli değil")</td>
                                <td>
                                    @if (line.QualityControlRequirement == Ekomers.Models.Enums.PrdQualityControlRequirement.Optional)
                                    {
                                        <select name="Lines[@i].SendToQuality" class="form-control receipt-quality-choice"><option value="false">Doğrudan kullanılabilir stoğa al</option><option value="true">Kalite kontrol için karantinaya al</option></select>
                                    }
                                    else
                                    {
                                        var quarantine = line.QualityControlRequirement == Ekomers.Models.Enums.PrdQualityControlRequirement.Required;
                                        <input type="hidden" name="Lines[@i].SendToQuality" value="@quarantine.ToString().ToLowerInvariant()" class="receipt-quality-choice" />
                                        <span class="@(quarantine ? "text-warning" : "text-success")">@(quarantine ? "Kalite kontrol için karantinaya alınacak" : "Doğrudan kullanılabilir stoğa alınacak")</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table></div>
                    <div class="row">
                        <div class="col-md-6 form-group @(needsDirect ? "" : "d-none")" id="usable-warehouse-group">
                            <label>Kullanılabilir Stok Deposu</label>
                            <select name="usableWarehouseId" asp-items="Model.UsableWarehouses" class="form-control kt_select2" required="@needsDirect"><option value="">Depo seçiniz</option></select>
                            @if (Model.UsableWarehouses.Count == 0) { <small class="form-text text-danger">Aktif bir kullanılabilir stok deposu tanımlayınız.</small> }
                        </div>
                        <div class="col-md-6 form-group @(needsQuarantine ? "" : "d-none")" id="quarantine-warehouse-group">
                            <label>Karantina Deposu</label>
                            <select name="quarantineWarehouseId" asp-items="Model.QuarantineWarehouses" class="form-control kt_select2" required="@needsQuarantine"><option value="">Depo seçiniz</option></select>
                            @if (Model.QuarantineWarehouses.Count == 0) { <small class="form-text text-danger">Kalite kontrol için aktif bir karantina deposu tanımlayınız.</small> }
                        </div>
                    </div>
                    <div class="text-right"><button class="btn btn-success" id="receipt-stock-submit">@(needsQuarantine ? "Stok Girişini Tamamla" : "Doğrudan Stoğa Al")</button></div>
                </form> } else { <div class="alert alert-light-info mb-0">Mal kabul stok girişi yapma yetkiniz bulunmuyor.</div> }
            }
        </div>
    </div>
}

@if (Model.DirectStockDocuments.Count > 0)
{
    <div class="card card-custom mb-5">
        <div class="card-header"><div class="card-title"><h3 class="card-label">Doğrudan Stok Girişi<span class="d-block text-muted pt-2 font-size-sm">Bu satırlar kullanılabilir stoktadır.</span></h3></div></div>
        <div class="card-body">
            @foreach (var document in Model.DirectStockDocuments)
            {
                <div class="border rounded p-4 mb-3">
                    <strong>@document.DocumentNumber</strong><span class="d-block">@document.Warehouse</span>
                    <span class="d-block text-muted">@(document.PostingDate?.ToString("dd.MM.yyyy HH:mm") ?? "-") · @document.User</span>
                    @if (canUndo)
                    {
                        <form asp-action="DogrudanStokGirisiniGeriAl" method="post" class="mt-3" onsubmit="return confirm('Stok girişi ters hareketle geri alınacak. Devam edilsin mi?');">
                            <input type="hidden" name="id" value="@Model.Id" /><input type="hidden" name="documentId" value="@document.Id" />
                            <div class="input-group"><input name="reason" class="form-control" minlength="5" maxlength="1000" placeholder="Geri alma gerekçesi" required /><div class="input-group-append"><button class="btn btn-light-warning">Stok Girişini Geri Al</button></div></div>
                        </form>
                    }
                </div>
            }
        </div>
    </div>
}

@if (Model.QuarantineInventoryDocumentId.HasValue)
{
    <div class="card card-custom mb-5">
        <div class="card-header"><div class="card-title"><h3 class="card-label">Karantina ve Kalite Kontrol</h3></div></div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3"><strong>Karantina Deposu</strong><div>@Model.QuarantineWarehouseCode - @Model.QuarantineWarehouseName</div></div>
                <div class="col-md-3"><strong>Stok Belgesi</strong><div>@Model.QuarantineDocumentNumber</div></div>
                <div class="col-md-3"><strong>İşlem Tarihi</strong><div>@(Model.QuarantineDate?.ToString("dd.MM.yyyy HH:mm") ?? "-")</div></div>
                <div class="col-md-3"><strong>İşlemi Yapan</strong><div>@(Model.QuarantineUserId ?? "-")</div></div>
            </div>
            <div class="alert alert-light-info mt-5 mb-0">Karantina stoğu fiziksel stoktur fakat ana depo veya üretim deposu stoklarına dahil değildir. Sonraki işlem laboratuvar/kalite analizidir.</div>
            @if (canUndo)
            {
                <div class="border rounded p-4 mt-5">
                    <strong>Karantina girişini geri al</strong>
                    <span class="d-block text-muted mb-3">Önce stok sonucu ve kalite kayıtları geriye alınmalıdır. İşlem, stok girişini silmez; ters stok belgesi oluşturur.</span>
                    <form asp-action="KarantinaGirisiniGeriAl" method="post" onsubmit="return confirm('Karantina stok girişi ters hareketle geri alınacak. Devam edilsin mi?');">
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="input-group"><input name="reason" class="form-control" minlength="5" maxlength="1000" placeholder="Geri alma gerekçesi" required /><div class="input-group-append"><button class="btn btn-light-warning">Karantina Girişini Geri Al</button></div></div>
                    </form>
                </div>
            }
            <div class="mt-5">
                @if (Model.QualityInspectionCount == 0 && canQuarantine)
                {
                    <form asp-action="KaliteyeGonder" method="post" class="d-inline"><input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-primary">Analiz Kayıtlarını Oluştur</button></form>
                }
                else if (Model.QualityInspectionCount > 0)
                {
                    <a asp-controller="KaliteYonetimi" asp-action="Analizler" asp-route-goodsReceiptId="@Model.Id" class="btn btn-light-primary">Kalite Analizlerini Gör (@Model.QualityInspectionCount)</a>
                    @if (Model.PendingQualityInspectionCount > 0) { <span class="text-muted ml-3">@Model.PendingQualityInspectionCount analiz sonuç bekliyor.</span> }
                    else { <a asp-controller="KaliteYonetimi" asp-action="StokSonuclandirma" asp-route-search="@Model.ReceiptNumber" asp-route-status="all" class="btn btn-light-success ml-2">Stok Sonuçlarını Gör</a> }
                }
            </div>
        </div>
    </div>
}

<div class="card card-custom mb-5">
    <div class="card-header"><div class="card-title"><h3 class="card-label">Gerçekleşen Nakliye</h3></div></div>
    <div class="card-body">
        @if (Model.ActualFreightAmount.HasValue)
        {
            <div class="row">
                <div class="col-md-3"><strong>Net</strong><div>@Model.ActualFreightAmount.Value.ToString("N2") @Model.FreightCurrencyCode</div></div>
                <div class="col-md-2"><strong>KDV</strong><div>%@(Model.ActualFreightVatRate?.ToString("0.##") ?? "0")</div></div>
                <div class="col-md-3"><strong>Genel Toplam</strong><div>@Model.FreightGrandTotal.ToString("N2") @Model.FreightCurrencyCode</div></div>
                <div class="col-md-2"><strong>Kur</strong><div>@Model.FreightExchangeRate.ToString("N6")</div><small class="text-muted">@(Model.FreightExchangeRateDate?.ToString("dd.MM.yyyy") ?? "-") · @Model.FreightExchangeRateSource</small></div>
                <div class="col-md-2"><strong>TRY Karşılığı</strong><div>@Model.FreightGrandTotalTry.ToString("N2") TRY</div></div>
            </div>
        }
        else
        {
            <div class="alert alert-light-primary mb-0">Bu teslimat için gerçekleşen nakliye gideri girilmedi.</div>
        }
        @if ((Model.QuarantineInventoryDocumentId.HasValue || Model.DirectStockDocuments.Count > 0) && canAllocateCost)
        {
            <div class="text-right mt-5"><a asp-action="EkMaliyetDagitimi" asp-route-id="@Model.Id" class="btn btn-light-primary">Ek Maliyet Dağıtımını Aç</a></div>
        }
    </div>
</div>

<div class="card card-custom">
    <div class="card-header"><div class="card-title"><h3 class="card-label">Teslim Alınan Malzemeler (@Model.Lines.Count)</h3></div></div>
    <div class="card-body">
        @if (Model.Status == Ekomers.Models.Enums.PurGoodsReceiptStatus.Recorded)
        {
            <div class="alert alert-light-warning">Bu miktarlar siparişte teslim alınan olarak görünür; henüz karantina veya kullanılabilir stok değildir.</div>
        }
        else if (Model.Status == Ekomers.Models.Enums.PurGoodsReceiptStatus.TransferredToStock)
        {
            <div class="alert alert-light-success">Bu mal kabuldeki tüm satırlar kullanılabilir stoğa alınmıştır.</div>
        }
        else if (Model.Status == Ekomers.Models.Enums.PurGoodsReceiptStatus.Returned)
        {
            <div class="alert alert-light-danger">Bu mal kabuldeki tüm lotlar kalite reddi sonrasında tedarikçiye iade edilmiştir.</div>
        }
        else if (Model.Status == Ekomers.Models.Enums.PurGoodsReceiptStatus.Scrapped)
        {
            <div class="alert alert-light-danger">Bu mal kabuldeki tüm lotlar kalite reddi sonrasında hurda deposuna alınmıştır.</div>
        }
        else if (Model.Status == Ekomers.Models.Enums.PurGoodsReceiptStatus.CompletedWithMixedDisposition)
        {
            <div class="alert alert-light-info">Bu mal kabuldeki lotlar farklı stok sonuçlarıyla tamamlanmıştır. Ayrıntıları stok sonuçlandırma ekranından görebilirsiniz.</div>
        }
        else if (Model.Status == Ekomers.Models.Enums.PurGoodsReceiptStatus.StockPartiallyCompleted)
        {
            <div class="alert alert-light-warning">Bu mal kabulde bazı satırlar sonuçlandırılmıştır. Diğer satırlar stok girişi veya kalite sonucunu bekliyor.</div>
        }
        else
        {
            <div class="alert alert-light-warning">Bu lotlar karantina deposundadır; kalite onayı verilene kadar kullanılabilir stok değildir.</div>
        }
        <div class="table-responsive">
            <table class="table table-separate table-head-custom">
                <thead><tr><th>#</th><th>Malzeme</th><th>Miktar</th><th>Lot</th><th>Üretim Tarihi</th><th>SKT</th><th>Stok Girişi</th><th>Not</th></tr></thead>
                <tbody>
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@line.Sequence</td>
                        <td><strong>@line.MaterialCode</strong><span class="d-block text-muted">@line.MaterialName</span></td>
                        <td>@line.ReceivedQuantity.ToString("0.######") @line.Unit</td>
                        <td>@(line.LotNumber ?? "-")</td>
                        <td>@(line.ProductionDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>@(line.ExpirationDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                        <td>
                            @if (line.IsDirectStock) { <strong class="text-success">Doğrudan stok</strong><span class="d-block">@line.StockWarehouse</span><small class="text-muted">@line.StockDocumentNumber</small> }
                            else if (line.IsStockPosted) { <span>Kalite kontrol akışında</span><small class="d-block text-muted">@Model.QuarantineDocumentNumber</small> }
                            else { <span class="text-warning">Stok girişi bekliyor</span> }
                        </td>
                        <td>@(line.Notes ?? "-")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section JSSection {
    <script>
        $(function () {
            $('.kt_select2').select2({ width: '100%', placeholder: 'Depo seçiniz', allowClear: true });
            function updateDestinations() {
                const routes = $('.receipt-quality-choice').map(function () { return $(this).val() === 'true'; }).get();
                const quarantine = routes.some(Boolean);
                const direct = routes.some(function (value) { return !value; });
                $('#usable-warehouse-group').toggleClass('d-none', !direct).find('select').prop('required', direct).prop('disabled', !direct);
                $('#quarantine-warehouse-group').toggleClass('d-none', !quarantine).find('select').prop('required', quarantine).prop('disabled', !quarantine);
                $('#receipt-stock-submit').text(quarantine ? 'Stok Girişini Tamamla' : 'Doğrudan Stoğa Al');
            }
            $('.receipt-quality-choice').on('change', updateDestinations);
            updateDestinations();
            $('#receipt-stock-form').on('submit', function () { $('#receipt-stock-submit').prop('disabled', true); });
        });
    </script>
}
