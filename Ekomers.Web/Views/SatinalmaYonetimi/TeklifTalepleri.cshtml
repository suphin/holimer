@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.QuotationRequestCandidateVM>
@{ ViewData["Title"] = "Teklif Bekleyen Talepler"; }
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Teklif Bekleyen Talepler<span class="d-block text-muted pt-2 font-size-sm">Onaylanmış ve henüz tamamen sipariş edilmemiş talep satırları</span></h3></div></div><div class="card-body">
@if (Model.Count == 0) { <div class="alert alert-light-primary mb-0">Teklif bekleyen talep bulunmuyor.</div> } else { <div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Talep No</th><th>Tarih</th><th>Talep Eden</th><th>Açık Satır</th><th>Girilen Teklif</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.RequestNumber</strong></td><td>@item.RequestDate.ToString("dd.MM.yyyy")</td><td>@item.RequestedUserId</td><td>@item.EligibleLineCount</td><td>@item.QuotationCount</td><td class="text-right"><a asp-action="TeklifKarsilastir" asp-route-requestId="@item.RequestId" class="btn btn-sm btn-light mr-2">Karşılaştır</a><a asp-action="YeniTeklif" asp-route-requestId="@item.RequestId" class="btn btn-sm btn-primary">Teklif Gir</a></td></tr> }
</tbody></table></div> }</div></div>
