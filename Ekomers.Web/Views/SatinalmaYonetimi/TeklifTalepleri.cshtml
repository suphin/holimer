@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.QuotationRequestCandidateVM>
@{
    ViewData["Title"] = "Teklif Bekleyen Talepler";
    var canManageQuotation = User.IsInRole("Admin") || User.HasClaim("Authorize", "SatinalmaTeklifYonet");
}

<div class="card card-custom">
    <div class="card-header flex-wrap border-0 pt-6 pb-0">
        <div class="card-title">
            <h3 class="card-label">
                Teklif Bekleyen Talepler
                <span class="d-block text-muted pt-2 font-size-sm">Onaylanmış ve henüz tamamen sipariş edilmemiş talep satırları</span>
            </h3>
        </div>
        <div class="card-toolbar">
            <a asp-action="FiyatIstekleri" class="btn btn-light-primary mr-2">Gönderim Geçmişi</a>
            @if (canManageQuotation && Model.Count > 0)
            {
                <button type="submit" form="price-request-form" id="price-request-submit" class="btn btn-primary" disabled>
                    Seçilenlerden Fiyat İste
                </button>
            }
        </div>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">Teklif bekleyen talep bulunmuyor.</div>
        }
        else
        {
            <form id="price-request-form" asp-action="FiyatTeklifiIste" method="get">
                <div class="table-responsive">
                    <table class="table table-separate table-head-custom">
                        <thead>
                            <tr>
                                @if (canManageQuotation)
                                {
                                    <th style="width: 42px"><input type="checkbox" id="select-all-requests" /></th>
                                }
                                <th>Talep No</th>
                                <th>Tarih</th>
                                <th>Talep Eden</th>
                                <th>Açık Satır</th>
                                <th>Girilen Teklif</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    @if (canManageQuotation)
                                    {
                                        <td><input type="checkbox" class="request-selector" name="requestIds" value="@item.RequestId" /></td>
                                    }
                                    <td><strong>@item.RequestNumber</strong></td>
                                    <td>@item.RequestDate.ToString("dd.MM.yyyy")</td>
                                    <td>@item.RequestedUserId</td>
                                    <td>@item.EligibleLineCount</td>
                                    <td>@item.QuotationCount</td>
                                    <td class="text-right">
                                        <a asp-action="TeklifKarsilastir" asp-route-requestId="@item.RequestId" class="btn btn-sm btn-light mr-2">Karşılaştır</a>
                                        @if (canManageQuotation)
                                        {
                                            <a asp-action="YeniTeklif" asp-route-requestId="@item.RequestId" class="btn btn-sm btn-primary">Teklif Gir</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </form>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const all = document.getElementById('select-all-requests');
            const rows = Array.from(document.querySelectorAll('.request-selector'));
            const submit = document.getElementById('price-request-submit');
            if (!submit) return;

            const refresh = () => {
                const count = rows.filter(x => x.checked).length;
                submit.disabled = count === 0;
                submit.textContent = count ? `${count} Talep İçin Fiyat İste` : 'Seçilenlerden Fiyat İste';
                if (all) {
                    all.checked = count > 0 && count === rows.length;
                    all.indeterminate = count > 0 && count < rows.length;
                }
            };

            all?.addEventListener('change', () => {
                rows.forEach(x => x.checked = all.checked);
                refresh();
            });
            rows.forEach(x => x.addEventListener('change', refresh));
            refresh();
        })();
    </script>
}
