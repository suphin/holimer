@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.PurchaseRequestListVM>
@{ ViewData["Title"] = "Satınalma Talepleri"; }
<div class="card card-custom">
    <div class="card-header flex-wrap py-3">
        <div class="card-title"><h3 class="card-label">Satınalma Talepleri<span class="d-block text-muted pt-2 font-size-sm">Yeni satınalma sürecinin talep kayıtları</span></h3></div>
        <div class="card-toolbar"><a asp-action="YeniTalep" class="btn btn-primary">Yeni Talep</a></div>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">Henüz satınalma talebi oluşturulmadı.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-separate table-head-custom">
                    <thead><tr><th>Talep No</th><th>Talep Tarihi</th><th>İhtiyaç Tarihi</th><th>Talep Eden</th><th>Öncelik</th><th>Satırlar</th><th>Onaylanan</th><th>Bekleyen</th><th>Durum</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.RequestNumber</strong></td>
                            <td>@item.RequestDate.ToString("dd.MM.yyyy")</td>
                            <td>@(item.NeededDate?.ToString("dd.MM.yyyy") ?? "-")</td>
                            <td>@item.RequestedUserId</td>
                            <td>@item.Priority.ToTurkish()</td>
                            <td>@item.LineCount</td>
                            <td>@item.ApprovedLineCount</td>
                            <td>@item.PendingLineCount</td>
                            <td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td>
                            <td class="text-right"><a asp-action="TalepDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
