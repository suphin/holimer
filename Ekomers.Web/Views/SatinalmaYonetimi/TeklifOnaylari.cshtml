@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.SupplierQuotationListVM>
@{ ViewData["Title"] = "Teklif Onayları"; }
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Teklif Onayları<span class="d-block text-muted pt-2 font-size-sm">Satır bazında yönetici değerlendirmesi bekleyen teklifler</span></h3></div></div><div class="card-body">
@if (Model.Count == 0) { <div class="alert alert-light-primary mb-0">Onay bekleyen teklif bulunmuyor.</div> } else { <div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Teklif</th><th>Talep</th><th>Tedarikçi</th><th>Tarih</th><th>Tutar</th><th>Bekleyen / Toplam</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.QuotationNumber</strong></td><td>@item.RequestNumber</td><td>@item.SupplierCode - @item.SupplierName</td><td>@item.QuotationDate.ToString("dd.MM.yyyy")</td><td>@item.GrandTotal.ToString("N2") @item.CurrencyCode<small class="d-block text-muted">Kur: @item.ExchangeRate.ToString("N6") · @item.GrandTotalTry.ToString("N2") TRY</small></td><td>@item.PendingLineCount / @item.LineCount</td><td class="text-right"><a asp-action="TeklifKarsilastir" asp-route-requestId="@item.RequestId" class="btn btn-sm btn-light mr-2">Karşılaştır</a><a asp-action="TeklifOnay" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Değerlendir</a></td></tr> }
</tbody></table></div> }</div></div>
