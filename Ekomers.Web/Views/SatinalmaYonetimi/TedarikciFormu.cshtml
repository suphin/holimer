@model Ekomers.Models.ViewModels.Purchasing.SupplierFormVM
@{ var isEdit = Model.Id > 0; ViewData["Title"] = isEdit ? "Tedarikçi Düzenle" : "Yeni Tedarikçi"; }
<div class="card card-custom">
    <div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@ViewData["Title"]<span class="d-block text-muted pt-2 font-size-sm">Firma ve iletişim bilgileri</span></h3></div><div class="card-toolbar"><a asp-action="Tedarikciler" class="btn btn-sm btn-light">Listeye Dön</a></div></div>
    <form asp-action="@(isEdit ? "TedarikciDuzenle" : "TedarikciYeni")" method="post"><input asp-for="Id" type="hidden" /><div class="card-body"><div asp-validation-summary="ModelOnly" class="alert alert-light-danger"></div>
        <div class="row"><div class="col-md-3 form-group"><label asp-for="Code"></label><input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger"></span></div><div class="col-md-6 form-group"><label asp-for="Name"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-3 form-group"><label asp-for="LogoCode"></label><input asp-for="LogoCode" class="form-control" /></div></div>
        <div class="row"><div class="col-md-3 form-group"><label asp-for="TaxNumber"></label><input asp-for="TaxNumber" class="form-control" /></div><div class="col-md-3 form-group"><label asp-for="TaxOffice"></label><input asp-for="TaxOffice" class="form-control" /></div><div class="col-md-3 form-group"><label asp-for="ContactName"></label><input asp-for="ContactName" class="form-control" /></div><div class="col-md-3 form-group"><label asp-for="Phone"></label><input asp-for="Phone" class="form-control" /></div></div>
        <div class="row"><div class="col-md-4 form-group"><label asp-for="Email"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-8 form-group"><label asp-for="Address"></label><textarea asp-for="Address" class="form-control" rows="2"></textarea></div></div>
        <div class="row"><div class="col-md-10 form-group"><label asp-for="Notes"></label><textarea asp-for="Notes" class="form-control" rows="2"></textarea></div><div class="col-md-2 form-group pt-8"><label class="checkbox"><input asp-for="IsActive" /><span></span> Aktif</label></div></div>
    </div><div class="card-footer text-right"><a asp-action="Tedarikciler" class="btn btn-light mr-2">Vazgeç</a><button class="btn btn-primary">Kaydet</button></div></form>
</div>
@section JSSection { <partial name="_ValidationScriptsPartial" /> }
