@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.SupplierQuotationListVM>
@{ ViewData["Title"] = "Tedarikçi Teklifleri"; }
<div class="card card-custom"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">Tedarikçi Teklifleri<span class="d-block text-muted pt-2 font-size-sm">Talep bazında alınan fiyat teklifleri</span></h3></div><div class="card-toolbar"><a asp-action="TeklifTalepleri" class="btn btn-primary">Teklif Bekleyen Talepler</a></div></div><div class="card-body">
@if (Model.Count == 0) { <div class="alert alert-light-primary mb-0">Henüz teklif girilmedi.</div> } else { <div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Teklif No</th><th>Talep</th><th>Tedarikçi</th><th>Firma Teklif No</th><th>Tarih</th><th>Tutar</th><th>Satır / Bekleyen</th><th>Durum</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.QuotationNumber</strong></td><td><a asp-action="TeklifKarsilastir" asp-route-requestId="@item.RequestId">@item.RequestNumber</a></td><td>@item.SupplierCode - @item.SupplierName</td><td>@(item.SupplierQuotationNumber ?? "-")</td><td>@item.QuotationDate.ToString("dd.MM.yyyy")</td><td>@item.GrandTotal.ToString("N2") @item.CurrencyCode<small class="d-block text-muted">Kur: @item.ExchangeRate.ToString("N6") · @item.GrandTotalTry.ToString("N2") TRY</small></td><td>@item.LineCount / @item.PendingLineCount</td><td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td><td class="text-right"><a asp-action="TeklifDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a></td></tr> }
</tbody></table></div> }</div></div>
