@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.GoodsReceiptListVM>
@{
    ViewData["Title"] = "Mal Kabuller";
}

<div class="card card-custom">
    <div class="card-header flex-wrap py-3">
        <div class="card-title">
            <h3 class="card-label">Mal Kabuller<span class="d-block text-muted pt-2 font-size-sm">Parçalı teslimatlar, irsaliyeler ve gerçekleşen nakliye kayıtları</span></h3>
        </div>
        <div class="card-toolbar"><a asp-action="Siparisler" class="btn btn-sm btn-light-primary">Açık Siparişlere Git</a></div>
    </div>
    <div class="card-body">
        @if (Model.Count == 0)
        {
            <div class="alert alert-light-primary mb-0">Henüz mal kabul kaydı yok. Açık bir satınalma siparişinin detayından “Parçalı Mal Kabul” seçeneğini kullanabilirsiniz.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-separate table-head-custom">
                    <thead><tr><th>Mal Kabul No</th><th>Tarih</th><th>Sipariş</th><th>Tedarikçi</th><th>İrsaliye</th><th>Satır</th><th>Gerçekleşen Nakliye</th><th>Durum</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.ReceiptNumber</strong></td>
                            <td>@item.ReceiptDate.ToString("dd.MM.yyyy")</td>
                            <td>@item.OrderNumber</td>
                            <td>@item.SupplierCode - @item.SupplierName</td>
                            <td>@item.DispatchNumber</td>
                            <td>@item.LineCount</td>
                            <td>@(item.ActualFreightAmount.HasValue ? $"{item.ActualFreightAmount:N2} {item.FreightCurrencyCode}" : "-")</td>
                            <td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td>
                            <td class="text-right"><a asp-action="MalKabulDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
