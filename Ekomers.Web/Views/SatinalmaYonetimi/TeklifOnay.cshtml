@model Ekomers.Models.ViewModels.Purchasing.SupplierQuotationDetailVM
@{ ViewData["Title"] = "Teklif Satır Onayı"; }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@Model.QuotationNumber<span class="d-block text-muted pt-2 font-size-sm">@Model.SupplierCode - @Model.SupplierName | Talep: @Model.RequestNumber</span></h3></div><div class="card-toolbar"><a asp-action="TeklifKarsilastir" asp-route-requestId="@Model.RequestId" class="btn btn-sm btn-light-primary mr-2">Teklifleri Karşılaştır</a><a asp-action="TeklifOnaylari" class="btn btn-sm btn-light">Onay Listesine Dön</a></div></div><div class="card-body"><div class="row"><div class="col-md-3"><strong>Teklif Tarihi</strong><div>@Model.QuotationDate.ToString("dd.MM.yyyy")</div></div><div class="col-md-3"><strong>Geçerlilik</strong><div>@(Model.ValidUntil?.ToString("dd.MM.yyyy") ?? "-")</div></div><div class="col-md-3"><strong>Ödeme</strong><div>@(Model.PaymentTerms ?? "-")</div></div><div class="col-md-3"><strong>Teslim</strong><div>@(Model.DeliveryTerms ?? "-")</div></div></div></div></div>
@foreach (var line in Model.Lines) {
<div class="card card-custom mb-4"><div class="card-header"><div class="card-title"><h3 class="card-label">@line.MaterialCode<span class="d-block text-muted pt-2 font-size-sm">@line.MaterialName</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline">@line.Status.ToTurkish()</span></div></div><div class="card-body"><div class="row mb-5"><div class="col-md-2"><strong>Talep Onayı</strong><div>@line.RequestApprovedQuantity.ToString("0.######") @line.Unit</div></div><div class="col-md-2"><strong>Sipariş / Kalan</strong><div>@line.AlreadyOrderedQuantity.ToString("0.######") / @line.RemainingRequestQuantity.ToString("0.######")</div></div><div class="col-md-2"><strong>Teklif</strong><div>@line.OfferedQuantity.ToString("0.######") @line.Unit</div></div><div class="col-md-2"><strong>Net Birim</strong><div>@line.NetUnitPrice.ToString("N6") @Model.CurrencyCode</div></div><div class="col-md-2"><strong>KDV</strong><div>%@line.VatRate.ToString("0.##")</div></div><div class="col-md-2"><strong>Genel Toplam</strong><div>@line.GrandTotal.ToString("N2") @Model.CurrencyCode</div></div></div>
@if (line.Status == PurSupplierQuotationLineStatus.PendingApproval) { <form asp-action="TeklifSatirKarari" method="post"><input type="hidden" name="QuotationId" value="@Model.Id" /><input type="hidden" name="LineId" value="@line.Id" /><div class="row"><div class="col-md-3 form-group"><label>Onaylanacak Miktar</label><input name="ApprovedQuantityInput" value="@Math.Min(line.OfferedQuantity, line.RemainingRequestQuantity).ToString("0.######", CultureInfo.InvariantCulture)" class="form-control" inputmode="decimal" /></div><div class="col-md-6 form-group"><label>Açıklama <small>(red için zorunlu)</small></label><input name="Note" class="form-control" /></div><div class="col-md-3 form-group pt-8 text-right"><button name="Decision" value="@PurQuotationApprovalAction.Rejected" class="btn btn-light-danger mr-2" onclick="return confirm('Bu teklif satırı reddedilsin mi?');">Reddet</button><button name="Decision" value="@PurQuotationApprovalAction.Approved" class="btn btn-success" onclick="return confirm('Satır onaylanıp otomatik satınalma siparişine dönüştürülsün mü?');">Onayla ve Siparişe Dönüştür</button></div></div></form> }
else if (!string.IsNullOrWhiteSpace(line.ApprovalNote)) { <div class="alert alert-light-primary mb-0"><strong>Onay Notu:</strong> @line.ApprovalNote</div> }
</div></div> }
