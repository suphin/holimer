@model IReadOnlyList<Ekomers.Models.ViewModels.Purchasing.PurchaseOrderListVM>
@{ ViewData["Title"] = "Satınalma Siparişleri"; }
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Satınalma Siparişleri<span class="d-block text-muted pt-2 font-size-sm">Onaylanan teklif satırlarından otomatik oluşan siparişler</span></h3></div></div><div class="card-body">
@if (Model.Count == 0) { <div class="alert alert-light-primary mb-0">Henüz satınalma siparişi oluşmadı.</div> } else { <div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>Sipariş No</th><th>Tarih</th><th>Tedarikçi</th><th>Kaynak Teklif</th><th>Satır</th><th>Tutar</th><th>Durum</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.OrderNumber</strong></td><td>@item.OrderDate.ToString("dd.MM.yyyy")</td><td>@item.SupplierCode - @item.SupplierName</td><td>@item.QuotationNumber</td><td>@item.LineCount</td><td>@item.GrandTotal.ToString("N2") @item.CurrencyCode<small class="d-block text-muted">Kur: @item.ExchangeRate.ToString("N6") · @item.GrandTotalTry.ToString("N2") TRY</small></td><td><span class="label label-light-primary label-inline">@item.Status.ToTurkish()</span></td><td class="text-right"><a asp-action="SiparisDetay" asp-route-id="@item.Id" class="btn btn-sm btn-light-primary">Detay</a></td></tr> }
</tbody></table></div> }</div></div>
