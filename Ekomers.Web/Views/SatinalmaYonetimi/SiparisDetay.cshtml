@model Ekomers.Models.ViewModels.Purchasing.PurchaseOrderDetailVM
@{ ViewData["Title"] = "Satınalma Siparişi"; }
<div class="card card-custom mb-5"><div class="card-header flex-wrap py-3"><div class="card-title"><h3 class="card-label">@Model.OrderNumber<span class="d-block text-muted pt-2 font-size-sm">@Model.SupplierCode - @Model.SupplierName</span></h3></div><div class="card-toolbar"><span class="label label-light-primary label-inline mr-2">@Model.Status.ToTurkish()</span><a asp-action="TeklifDetay" asp-route-id="@Model.QuotationId" class="btn btn-sm btn-light-primary mr-2">Kaynak Teklif</a><a asp-action="Siparisler" class="btn btn-sm btn-light">Listeye Dön</a></div></div><div class="card-body"><div class="row"><div class="col-md-2"><strong>Sipariş Tarihi</strong><div>@Model.OrderDate.ToString("dd.MM.yyyy")</div></div><div class="col-md-2"><strong>Para Birimi</strong><div>@Model.CurrencyCode</div></div><div class="col-md-2"><strong>Kur</strong><div>@Model.ExchangeRate.ToString("N6")</div></div><div class="col-md-2"><strong>Kur Tarihi / Kaynağı</strong><div>@(Model.ExchangeRateDate?.ToString("dd.MM.yyyy") ?? "-") · @Model.ExchangeRateSource</div></div><div class="col-md-2"><strong>Ödeme Koşulu</strong><div>@(Model.PaymentTerms ?? "-")</div></div><div class="col-md-2"><strong>Teslim Koşulu</strong><div>@(Model.DeliveryTerms ?? "-")</div></div></div><div class="row mt-5"><div class="col-md-4"><strong>Sipariş TRY Karşılığı</strong><div>@Model.GrandTotalTry.ToString("N2") TRY</div></div></div></div></div>
<div class="card card-custom"><div class="card-header"><div class="card-title"><h3 class="card-label">Sipariş Satırları (@Model.Lines.Count)</h3></div></div><div class="card-body"><div class="table-responsive"><table class="table table-separate table-head-custom"><thead><tr><th>#</th><th>Malzeme</th><th>Sipariş</th><th>Teslim Alınan</th><th>Birim Fiyat</th><th>İskonto</th><th>Net Birim</th><th>KDV</th><th>Toplam</th><th>Planlanan Teslim</th><th>Durum</th></tr></thead><tbody>
@foreach (var line in Model.Lines) { <tr><td>@line.Sequence</td><td><strong>@line.MaterialCode</strong><span class="d-block text-muted">@line.MaterialName</span></td><td>@line.OrderedQuantity.ToString("0.######") @line.Unit</td><td>@line.ReceivedQuantity.ToString("0.######") @line.Unit</td><td>@line.UnitPrice.ToString("N6")</td><td>%@line.DiscountRate.ToString("0.##")</td><td>@line.NetUnitPrice.ToString("N6")</td><td>%@line.VatRate.ToString("0.##")</td><td>@line.GrandTotal.ToString("N2") @Model.CurrencyCode</td><td>@(line.RequestedDeliveryDate?.ToString("dd.MM.yyyy") ?? "-")</td><td>@line.Status.ToTurkish()</td></tr> }
</tbody><tfoot><tr><th colspan="8" class="text-right">Net / KDV / Genel Toplam</th><th colspan="3">@Model.NetTotal.ToString("N2") / @Model.TaxTotal.ToString("N2") / <strong>@Model.GrandTotal.ToString("N2") @Model.CurrencyCode</strong><span class="d-block text-muted">@Model.GrandTotalTry.ToString("N2") TRY</span></th></tr></tfoot></table></div><div class="alert alert-light-info mb-0">Bir sonraki aşamada bu açık sipariş üzerinden parçalı mal kabul, irsaliye, lot, üretim tarihi, SKT ve karantina kaydı oluşturulacak.</div></div></div>
